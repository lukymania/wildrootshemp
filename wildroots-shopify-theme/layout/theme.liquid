<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#2D4A3E">

  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" sizes="32x32" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- else -%}
    <link rel="icon" type="image/png" href="https://cdn.shopify.com/s/files/1/0804/0572/5416/files/wild-roots-favicon.png?v=1786901711">
  {%- endif -%}

  {%- unless settings.type_header_font.system? and settings.type_body_font.system? -%}
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Lato:wght@300;400;700&family=Cormorant+Garamond:ital,wght@1,400;1,600&display=swap" rel="stylesheet">
  {%- endunless -%}

  {%- if request.page_type == 'index' -%}
    {%- assign seo_title = 'Wild Roots Hemp | Nano-Hemp Wellness' -%}
    {%- assign seo_description = 'Shop nano-hemp wellness products for daily balance, evening routines, targeted topical use, recovery, and pets. Simple formulas and third-party testing.' -%}
  {%- elsif request.page_type == 'page' and page.handle == 'the-science' -%}
    {%- assign seo_title = 'Nano-Hemp Science & Absorption | Wild Roots Hemp' -%}
    {%- assign seo_description = 'Learn how Wild Roots nano-fragmentation creates particles under 100 nanometers for faster absorption, consistent delivery, and cleaner hemp wellness.' -%}
  {%- elsif request.page_type == 'page' and page.handle == 'our-story' -%}
    {%- assign seo_title = 'Our Story | Wild Roots Hemp' -%}
    {%- assign seo_description = 'Meet the family behind Wild Roots Hemp and discover how Midwest values, West Coast living, and nano-science shaped our transparent wellness brand.' -%}
  {%- elsif request.page_type == 'blog' and blog.handle == 'news' -%}
    {%- assign seo_title = 'The Root Journal | Wild Roots Hemp' -%}
    {%- assign seo_description = 'Explore practical guides on nano-hemp science, product use, family wellness routines, ingredients, testing, and transparency from Wild Roots Hemp.' -%}
  {%- elsif request.page_type == 'collection' and collection.handle == 'all' -%}
    {%- assign seo_title = 'Shop All Nano-Hemp Products | Wild Roots Hemp' -%}
    {%- assign seo_description = 'Shop the complete Wild Roots Hemp collection, including nano-hemp drops, evening support, topical roll-ons and sprays, and pet wellness products.' -%}
  {%- else -%}
    {%- capture seo_title -%}
      {{ page_title }}
      {%- if current_tags %} – tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} – Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} | {{ shop.name }}{% endunless -%}
    {%- endcapture -%}
    {%- assign seo_title = seo_title | strip -%}
    {%- assign seo_description = page_description | default: shop.description | strip_html | strip_newlines | truncate: 155 -%}
  {%- endif -%}

  <title>{{ seo_title | escape }}</title>
  <meta name="description" content="{{ seo_description | escape }}">

  {% render 'meta-tags', seo_title: seo_title, seo_description: seo_description %}

  {% render 'wr-product-jsonld' %}

  {% if request.page_type == 'index' %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "{{ shop.url }}/#organization",
          "name": {{ shop.name | json }},
          "alternateName": "Wild Roots",
          "url": {{ shop.url | json }},
          "logo": {
            "@type": "ImageObject",
            "url": "https://raw.githubusercontent.com/lukymania/wildrootshemp/main/wildroots-site/assets/images/logo-nav.png"
          },
          "description": {{ seo_description | json }},
          "areaServed": {"@type": "Country", "name": "United States"},
          "contactPoint": {
            "@type": "ContactPoint",
            "contactType": "Customer Service",
            "email": {{ shop.email | json }},
            "availableLanguage": "English"
          }
        },
        {
          "@type": "WebSite",
          "@id": "{{ shop.url }}/#website",
          "url": {{ shop.url | json }},
          "name": {{ shop.name | json }},
          "publisher": {"@id": "{{ shop.url }}/#organization"},
          "potentialAction": {
            "@type": "SearchAction",
            "target": {"@type": "EntryPoint", "urlTemplate": "{{ shop.url }}/search?q={search_term_string}"},
            "query-input": "required name=search_term_string"
          }
        }
      ]
    }
    </script>
  {% endif %}

  {{ content_for_header }}

  {% render 'css-variables' %}
  {{ 'theme.css' | asset_url | stylesheet_tag }}

  <script src="{{ 'theme.js' | asset_url }}" defer></script>
  <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>

  {% if template contains 'wr-' %}
    <style>
      #MainContent,
      #MainContent > .shopify-section:first-child,
      #MainContent > .shopify-section:first-child > div:first-child,
      #MainContent .page-hero,
      #MainContent .family-hero,
      #MainContent [class$="-hero"] { margin-top: 0 !important; }
      #MainContent { padding-top: 0 !important; }
    </style>
  {% endif %}

  {% if request.page_type == 'page' and page.handle == 'family' %}
    <style>
      #MainContent .family-hero { min-height: 50vh !important; padding: 0 !important; display: flex !important; align-items: center !important; justify-content: center !important; }
      #MainContent .family-hero > .container { padding-top: 4rem !important; padding-bottom: 4rem !important; }
      #MainContent .family-hero h1 { color: #fff !important; }
    </style>
  {% endif %}

  {% if request.page_type == 'page' and page.handle == 'the-science' or request.page_type == 'product' and product.handle == 'deep-rest' %}
    <style>
      .announcement-bar-section, #shopify-section-announcement-bar, #shopify-section-header, .shopify-section-group-header-group { display: none !important; }
    </style>
  {% endif %}

  {% if request.page_type == 'page' and page.handle == 'the-science' %}
    <style>.skip-to-content-link { display: none !important; }</style>
  {% endif %}

  <style id="wr-accessibility-policy-fix">
    .skip-to-content-link.visually-hidden {
      position: absolute !important;
      width: 1px !important;
      height: 1px !important;
      padding: 0 !important;
      margin: -1px !important;
      overflow: hidden !important;
      clip: rect(0, 0, 0, 0) !important;
      clip-path: inset(50%) !important;
      white-space: nowrap !important;
      border: 0 !important;
    }
    .skip-to-content-link.visually-hidden:focus {
      position: fixed !important;
      top: 12px !important;
      left: 12px !important;
      width: auto !important;
      height: auto !important;
      padding: 10px 14px !important;
      margin: 0 !important;
      overflow: visible !important;
      clip: auto !important;
      clip-path: none !important;
      white-space: normal !important;
      background: #ffffff !important;
      color: #2D4A3E !important;
      border: 2px solid #2D4A3E !important;
      border-radius: 4px !important;
      z-index: 10000 !important;
    }

    body.template-product #MainContent .product-checkout {
      min-height: auto !important;
      padding-top: 0 !important;
    }

    body.template-policy #MainContent {
      padding-top: 80px !important;
      background: #FAF8F3;
    }
    body.template-policy #MainContent .shopify-policy__container {
      width: 100%;
      max-width: 900px;
      margin: 0 auto;
      padding: 56px 40px 88px;
      color: #3D2B1F;
    }
    body.template-policy #MainContent .shopify-policy__title {
      margin: 0 0 32px;
      text-align: left;
    }
    body.template-policy #MainContent .shopify-policy__title h1 {
      margin: 0;
      color: #2D4A3E;
      font-family: 'Playfair Display', serif;
      font-size: clamp(2.5rem, 4vw, 3.25rem);
      font-weight: 700;
      line-height: 1.08;
      letter-spacing: -0.025em;
    }
    body.template-policy #MainContent .shopify-policy__body {
      color: #3D2B1F;
      font-family: 'Lato', sans-serif;
      font-size: 1rem;
      line-height: 1.75;
    }
    body.template-policy #MainContent .shopify-policy__body h2 {
      margin: 2.6rem 0 1rem;
      color: #2D4A3E;
      font-family: 'Playfair Display', serif;
      font-size: 1.75rem;
      font-weight: 700;
      line-height: 1.25;
      letter-spacing: -0.01em;
    }
    body.template-policy #MainContent .shopify-policy__body h3 {
      margin: 2rem 0 .75rem;
      color: #2D4A3E;
      font-family: 'Lato', sans-serif;
      font-size: 1.2rem;
      font-weight: 700;
      line-height: 1.35;
    }
    body.template-policy #MainContent .shopify-policy__body p {
      margin: 0 0 1.1rem;
      color: #3D2B1F;
      font-size: 1rem;
      line-height: 1.75;
    }
    body.template-policy #MainContent .shopify-policy__body ul,
    body.template-policy #MainContent .shopify-policy__body ol {
      margin: 0 0 1.5rem 1.35rem;
      padding-left: .5rem;
    }
    body.template-policy #MainContent .shopify-policy__body li {
      margin: 0 0 .55rem;
      line-height: 1.7;
    }
    body.template-policy #MainContent .shopify-policy__body a {
      color: #2D4A3E;
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 2px;
    }
    @media (max-width: 749px) {
      body.template-policy #MainContent .shopify-policy__container {
        padding: 40px 24px 64px;
      }
      body.template-policy #MainContent .shopify-policy__title {
        margin-bottom: 24px;
      }
      body.template-policy #MainContent .shopify-policy__title h1 {
        font-size: 2.4rem;
      }
      body.template-policy #MainContent .shopify-policy__body h2 {
        margin-top: 2.2rem;
        font-size: 1.5rem;
      }
    }
  </style>

</head>

<body class="template-{{ request.page_type }} {{ template | replace: '.', ' ' | prepend: 'template-' }}">
  <a class="skip-to-content-link visually-hidden" href="#MainContent">{{ 'accessibility.skip_to_text' | t }}</a>

  {% assign wr_custom_shell = false %}
  {% if template contains 'wr-' or request.page_type == 'index' or request.page_type == 'cart' or request.page_type == 'policy' or request.page_type == 'article' %}
    {% assign wr_custom_shell = true %}
  {% endif %}

  {% assign wr_custom_footer = wr_custom_shell %}
  {% if request.page_type == 'collection' %}
    {% assign wr_custom_footer = true %}
  {% endif %}

  {% unless wr_custom_shell %}
    {% section 'announcement-bar' %}
    {% section 'header' %}
  {% endunless %}

  {% if request.page_type == 'cart' or request.page_type == 'policy' or request.page_type == 'article' or request.page_type == 'blog' %}{% render 'wr-site-header' %}{% endif %}

  <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
    {% if request.page_type == 'product' %}
      {% render 'wr-product-microdata-source-fix', page_content: content_for_layout %}
    {% elsif request.page_type == 'index' %}
      {% render 'wr-homepage-render-cleanup', page_content: content_for_layout %}
    {% else %}
      {% capture wr_rendered_content %}{{ content_for_layout }}{% endcapture %}
      {% assign wr_rendered_content = wr_rendered_content
        | replace: 'href="faq-/pages/contact">FAQ</a>', 'href="/pages/faq">FAQ</a>'
        | replace: 'href="faq-/pages/contact">Contact Us</a>', 'href="/pages/contact">Contact Us</a>'
        | replace: 'href="faq-/pages/contact">Shipping Info</a>', 'href="/pages/faq">Shipping Info</a>'
        | replace: 'href="faq-/pages/contact">Privacy Policy</a>', 'href="/policies/privacy-policy">Privacy Policy</a>'
        | replace: 'href="faq-/pages/contact"', 'href="/pages/contact"'
      %}
      {% assign wr_rendered_content = wr_rendered_content | replace: 'href="/journal.html"', 'href="/blogs/news"' %}
      {% assign wr_rendered_content = wr_rendered_content | replace: 'href="/journal"', 'href="/blogs/news"' %}
      {% assign wr_rendered_content = wr_rendered_content | replace: 'href="/blogs/journal/', 'href="/blogs/news/' %}
      {% if template contains 'wr-' %}
        {% assign wr_rendered_content = wr_rendered_content | replace: 'href="/#products"', 'href="/collections/all"' %}
        {% assign wr_rendered_content = wr_rendered_content | replace: 'href="#products"', 'href="/collections/all"' %}
      {% endif %}
      {% if request.page_type == 'page' and page.handle == 'the-science' %}
        {% assign wr_rendered_content = wr_rendered_content | replace: 'alt="" aria-hidden="true"', 'alt="Decorative hemp root illustration"' %}
      {% endif %}
      {{ wr_rendered_content }}
    {% endif %}
  </main>

  {% if request.page_type == 'cart' or request.page_type == 'collection' or request.page_type == 'policy' or request.page_type == 'blog' %}
    {% render 'wr-site-footer' %}
  {% elsif request.page_type == 'article' %}
    {% unless template contains 'wr-' %}{% render 'wr-site-footer' %}{% endunless %}
  {% endif %}

  <style>
    #MainContent h1 { font-size: clamp(2.75rem, 5.5vw, 4.75rem); line-height: 1.05; letter-spacing: -0.035em; text-wrap: balance; }
    #MainContent h2 { font-size: clamp(2.15rem, 4vw, 3.5rem); line-height: 1.12; letter-spacing: -0.025em; text-wrap: balance; }
    #MainContent h3 { font-size: clamp(1.35rem, 2.2vw, 1.85rem); line-height: 1.22; letter-spacing: -0.012em; text-wrap: balance; }
    #MainContent h4 { font-size: clamp(1.05rem, 1.4vw, 1.3rem); line-height: 1.3; text-wrap: balance; }
    #MainContent .article-title { font-size: clamp(2.5rem, 5vw, 4.25rem); line-height: 1.08; }
    #MainContent .section-label, #MainContent .section-eyebrow { display: inline-block; font-size: clamp(0.9rem, 1.2vw, 1.1rem); line-height: 1.3; letter-spacing: 0.13em; margin-bottom: 0.85rem; }
    #MainContent .site-footer h4 { font-size: 0.75rem; line-height: 1.3; letter-spacing: 0.12em; }
    @media (max-width: 749px) {
      #MainContent h1 { font-size: clamp(2.4rem, 11vw, 3.25rem); }
      #MainContent h2 { font-size: clamp(1.9rem, 8vw, 2.5rem); }
      #MainContent h3 { font-size: clamp(1.25rem, 5.5vw, 1.6rem); }
    }

    body.template-article #MainContent{background:#FDFCF9;color:#3D2B1F}
    body.template-article #MainContent .article-hero-inner,
    body.template-article #MainContent .article-content-inner,
    body.template-article #MainContent .container{
      width:100%;max-width:1040px!important;margin-left:auto!important;margin-right:auto!important;
      padding-left:clamp(24px,4.5vw,56px)!important;padding-right:clamp(24px,4.5vw,56px)!important;box-sizing:border-box
    }
    body.template-article #MainContent .article-hero-image,
    body.template-article #MainContent .article-image{
      width:100%;max-width:1120px!important;margin-left:auto!important;margin-right:auto!important;
      padding-left:clamp(20px,3vw,40px);padding-right:clamp(20px,3vw,40px);box-sizing:border-box
    }
    body.template-article #MainContent .article-hero-image img,
    body.template-article #MainContent .article-image img{
      width:100%;height:auto!important;max-height:none!important;display:block;object-fit:contain!important;border-radius:18px
    }
    body.template-article #MainContent .article-header{padding-top:calc(80px + 64px)!important;padding-bottom:44px!important}
    body.template-article #MainContent .article-hero-title,
    body.template-article #MainContent .article-title{
      color:#2D4A3E!important;font-family:'Playfair Display',serif!important;
      font-size:clamp(2.6rem,5.5vw,4.35rem)!important;font-weight:700!important;line-height:1.06!important;letter-spacing:-.035em!important
    }
    body.template-article #MainContent .article-body,
    body.template-article #MainContent .article-body-content{
      width:100%;max-width:none!important;color:#3D2B1F;font-family:'Lato',sans-serif;
      font-size:clamp(1.02rem,1.35vw,1.12rem)!important;line-height:1.82!important
    }
    body.template-article #MainContent .article-body p,
    body.template-article #MainContent .article-body-content p{margin:0 0 1.35em;font-size:inherit!important;line-height:inherit!important}
    body.template-article #MainContent .article-body h2,
    body.template-article #MainContent .article-body-content h2{
      margin:3.1rem 0 1.15rem!important;color:#2D4A3E!important;font-family:'Playfair Display',serif!important;
      font-size:clamp(2rem,3.2vw,2.55rem)!important;font-weight:700!important;line-height:1.16!important;letter-spacing:-.02em!important
    }
    body.template-article #MainContent .article-body h3,
    body.template-article #MainContent .article-body-content h3{
      margin:2.35rem 0 .9rem!important;color:#2D4A3E!important;font-family:'Playfair Display',serif!important;
      font-size:clamp(1.45rem,2.35vw,1.85rem)!important;font-weight:700!important;line-height:1.23!important
    }
    body.template-article #MainContent .article-body h4,
    body.template-article #MainContent .article-body-content h4{
      margin:1.8rem 0 .7rem!important;color:#2D4A3E!important;font-family:'Lato',sans-serif!important;
      font-size:1.16rem!important;font-weight:700!important;line-height:1.35!important
    }
    body.template-article #MainContent .article-body ul,
    body.template-article #MainContent .article-body ol,
    body.template-article #MainContent .article-body-content ul,
    body.template-article #MainContent .article-body-content ol{margin:0 0 1.6rem;padding-left:1.55rem}
    body.template-article #MainContent .article-body li,
    body.template-article #MainContent .article-body-content li{margin-bottom:.58rem;line-height:1.7}
    body.template-article #MainContent .article-body blockquote,
    body.template-article #MainContent .article-body-content blockquote{
      margin:2.4rem 0;padding:1.5rem 1.7rem;border-left:4px solid #C17A5F;border-radius:0 12px 12px 0;
      background:#F5F0E8;color:#3D2B1F;font-style:italic
    }
    body.template-article #MainContent .article-body a,
    body.template-article #MainContent .article-body-content a{color:#8E5542;text-decoration-thickness:1px;text-underline-offset:3px}
    body.template-article #MainContent .wr-article-figure{width:100%;margin:3rem 0 3.25rem}
    body.template-article #MainContent .wr-article-figure img{width:100%;height:auto;display:block;margin:0;border-radius:18px;box-shadow:0 10px 32px rgba(45,74,62,.1)}
    body.template-article #MainContent .wr-article-figure figcaption{max-width:820px;margin:.85rem auto 0;color:rgba(61,43,31,.62);font-size:.82rem;line-height:1.55;text-align:center}
    body.template-article #MainContent .article-body table,
    body.template-article #MainContent .article-body-content table{width:100%;min-width:680px;border-collapse:collapse;background:#fff;font-size:.93rem}
    body.template-article #MainContent .article-body th,
    body.template-article #MainContent .article-body td,
    body.template-article #MainContent .article-body-content th,
    body.template-article #MainContent .article-body-content td{padding:14px 16px;border:1px solid rgba(45,74,62,.16);text-align:left;vertical-align:top;line-height:1.55}
    body.template-article #MainContent .article-body th,
    body.template-article #MainContent .article-body-content th{background:#E8EFE3;color:#2D4A3E;font-weight:700}
    body.template-article #MainContent .stats-row,
    body.template-article #MainContent .ritual-grid,
    body.template-article #MainContent .benefits-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;margin:2rem 0}
    body.template-article #MainContent .stat-item,
    body.template-article #MainContent .ritual-item,
    body.template-article #MainContent .benefit-item{padding:22px;border:1px solid rgba(45,74,62,.12);border-radius:14px;background:#F5F0E8}
    body.template-article #MainContent .stat-num{display:block;color:#C17A5F;font-family:'Playfair Display',serif;font-size:2rem;font-weight:700;line-height:1.05}
    body.template-article #MainContent .stat-label{display:block;margin-top:7px;color:#2D4A3E;font-size:.78rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase}
    body.template-article #MainContent .highlight-box,
    body.template-article #MainContent .science-box,
    body.template-article #MainContent .product-recommendation{margin:2.25rem 0;padding:1.6rem 1.7rem;border-left:4px solid #9CAF88;border-radius:0 14px 14px 0;background:#EEF3E9}
    @media(max-width:749px){
      body.template-article #MainContent .article-header{padding-top:calc(80px + 44px)!important}
      body.template-article #MainContent .stats-row,
      body.template-article #MainContent .ritual-grid,
      body.template-article #MainContent .benefits-grid{grid-template-columns:1fr}
      body.template-article #MainContent .article-body table,
      body.template-article #MainContent .article-body-content table{font-size:.86rem}
    }

    body.template-article #MainContent .blog-lead{
      margin:0 0 2.2rem;padding:0 0 2rem;border-bottom:2px solid #C5D4B8;
      color:#8E5542;font-family:'Cormorant Garamond',serif;font-size:1.3rem!important;font-style:italic;line-height:1.65!important
    }
    body.template-article #MainContent .study-box{
      position:relative;margin:1.7rem 0;padding:1.45rem 1.55rem;border:1px solid rgba(45,74,62,.14);
      border-radius:14px;background:#fff;box-shadow:0 6px 20px rgba(45,74,62,.05)
    }
    body.template-article #MainContent .study-box:before{
      content:'';position:absolute;inset:0 auto 0 0;width:4px;border-radius:14px 0 0 14px;background:linear-gradient(#C17A5F,#9CAF88)
    }
    body.template-article #MainContent .study-box-title{margin-bottom:.5rem;color:#2D4A3E;font-family:'Playfair Display',serif;font-size:1.08rem;font-weight:700;line-height:1.35}
    body.template-article #MainContent .study-box-authors,
    body.template-article #MainContent .study-box-journal,
    body.template-article #MainContent .study-box-findings{margin-bottom:.55rem;font-size:.93rem!important;line-height:1.55!important}
    body.template-article #MainContent .study-box-journal{color:#8E5542;font-style:italic}
    body.template-article #MainContent .mechanism-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;margin:2rem 0}
    body.template-article #MainContent .mechanism-step{display:flex;align-items:flex-start;gap:16px;padding:22px;border:1px solid rgba(45,74,62,.12);border-radius:14px;background:#F5F0E8}
    body.template-article #MainContent .mechanism-number{width:42px;height:42px;min-width:42px;display:grid;place-items:center;border-radius:50%;background:#2D4A3E;color:#fff;font-family:'Playfair Display',serif;font-size:1.1rem;font-weight:700}
    body.template-article #MainContent .lucy-story{margin:2.6rem 0;padding:2rem;border-radius:16px;background:linear-gradient(145deg,#EEF3E9,#F8EFEA)}
    body.template-article #MainContent .lucy-story-header{display:flex;align-items:center;gap:16px;margin-bottom:1.2rem}
    body.template-article #MainContent .lucy-avatar{width:64px!important;height:64px!important;min-width:64px;display:block;margin:0!important;border:3px solid #9CAF88;border-radius:50%!important;object-fit:cover;box-shadow:none!important}
    body.template-article #MainContent .lucy-story-header h3{margin:0 0 .2rem!important}
    body.template-article #MainContent .lucy-tag{color:#8E5542;font-size:.76rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase}
    body.template-article #MainContent .product-cta{margin:2.8rem 0;padding:2rem;border-radius:16px;background:#2D4A3E;color:#F5F0E8;text-align:center}
    body.template-article #MainContent .product-cta h3{margin:0 0 .7rem!important;color:#fff!important}
    body.template-article #MainContent .product-cta p{color:rgba(245,240,232,.82)}
    body.template-article #MainContent .btn-cta{display:inline-block;padding:12px 22px;border-radius:999px;background:#C17A5F;color:#fff!important;font-size:.8rem;font-weight:700;letter-spacing:.08em;text-decoration:none!important;text-transform:uppercase}
    body.template-article #MainContent .blog-tags{display:flex;flex-wrap:wrap;gap:9px;margin:2.2rem 0 0}
    body.template-article #MainContent .blog-tag{padding:7px 12px;border-radius:999px;background:#E8EFE3;color:#2D4A3E;font-size:.72rem;font-weight:700;letter-spacing:.05em;text-transform:uppercase}
    @media(max-width:749px){
      body.template-article #MainContent .mechanism-grid{grid-template-columns:1fr}
      body.template-article #MainContent .lucy-story{padding:1.45rem}
      body.template-article #MainContent .lucy-story-header{align-items:flex-start}
    }
  </style>

  {% unless wr_custom_footer %}{% section 'footer' %}{% endunless %}

  {% unless wr_custom_shell %}
  <div id="cart-drawer" class="cart-drawer" aria-hidden="true">
    <div class="cart-drawer-overlay" onclick="WildRoots.cart.close()"></div>
    <div class="cart-drawer-panel">
      <div class="cart-drawer-header">
        <h3>Your Cart</h3>
        <button class="cart-drawer-close" onclick="WildRoots.cart.close()" aria-label="Close cart"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
      </div>
      <div class="cart-drawer-body" id="cart-drawer-items"><p class="cart-empty-msg">Your cart is empty</p></div>
      <div class="cart-drawer-footer" id="cart-drawer-footer" style="display:none;">
        <div class="cart-subtotal"><span>Subtotal</span><span id="cart-subtotal-amount">$0.00</span></div>
        <a href="/cart" class="btn btn-primary cart-view-btn">View Cart</a>
        <form action="/cart" method="post" novalidate><button type="submit" name="checkout" class="btn btn-accent cart-checkout-btn">Checkout</button></form>
      </div>
    </div>
  </div>
  {% endunless %}
</body>
</html>
