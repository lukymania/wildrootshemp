{% comment %}
  Wild Roots Hemp - Collection Template
  Displays collection title, description, and product grid
{% endcomment %}

<!-- ====== COLLECTION HERO ====== -->
<section class="collection-hero">
  <div class="collection-hero-inner">
    <div class="collection-hero-content">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb-sep">/</span>
        <span class="breadcrumb-current">{{ collection.title }}</span>
      </nav>
      <h1 class="collection-title">{{ collection.title }}</h1>
      {% if collection.description != blank %}
        <div class="collection-description">
          {{ collection.description }}
        </div>
      {% endif %}
      <p class="collection-product-count">{{ collection.products_count }} Product{% if collection.products_count != 1 %}s{% endif %}</p>
    </div>
    {% if collection.image %}
      <div class="collection-hero-image">
        <img src="{{ collection.image | img_url: 'master' }}" alt="{{ collection.title | escape }}" loading="eager">
      </div>
    {% endif %}
  </div>
</section>

<!-- ====== COLLECTION TOOLBAR ====== -->
<section class="collection-toolbar">
  <div class="toolbar-inner">
    <!-- Sort Dropdown -->
    <div class="toolbar-sort">
      <label for="sortBy" class="toolbar-label">Sort by:</label>
      <select id="sortBy" class="toolbar-select" onchange="window.location.href = this.value;">
        {% assign sort_options = "manual,best-selling,title-ascending,title-descending,price-ascending,price-descending,created-descending" | split: "," %}
        {% assign sort_labels = "Featured,Best Selling,Title: A-Z,Title: Z-A,Price: Low to High,Price: High to Low,Newest" | split: "," %}
        {% for option in sort_options %}
          {% assign sort_url = collection.url | append: '?sort_by=' | append: option %}
          <option value="{{ sort_url }}" {% if collection.sort_by == option %}selected{% endif %}>
            {{ sort_labels[forloop.index0] }}
          </option>
        {% endfor %}
      </select>
    </div>

    <!-- View Toggle -->
    <div class="toolbar-view">
      <button class="view-btn active" data-view="grid" aria-label="Grid view">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
      </button>
      <button class="view-btn" data-view="list" aria-label="List view">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
      </button>
    </div>
  </div>
</section>

<!-- ====== PRODUCT GRID ====== -->
<section class="collection-products">
  <div class="section-inner">
    {% paginate collection.products by 12 %}
      {% if collection.products.size > 0 %}
        <div class="product-grid" id="productGrid">
          {% for product in collection.products %}
            <div class="product-card{% if product.images[1] != blank %} product-card--has-hover{% endif %}" data-product-handle="{{ product.handle }}">
              <a href="{{ product.url }}" class="product-card-link">
                <!-- Card Image -->
                <div class="product-card-img">
                  {% if product.featured_image %}
                    <img
                      src="{{ product.featured_image | img_url: 'medium' }}"
                      alt="{{ product.featured_image.alt | escape }}"
                      loading="lazy"
                      class="product-card-image-primary"
                    >
                    {% if product.images[1] != blank %}
                      <img
                        src="{{ product.images[1] | img_url: 'medium' }}"
                        alt="{{ product.images[1].alt | escape }}"
                        loading="lazy"
                        class="product-card-image-hover"
                      >
                    {% endif %}
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag: 'product-card-placeholder' }}
                  {% endif %}

                  <!-- Badges -->
                  <div class="product-card-badges">
                    {% unless product.available %}
                      <span class="badge badge-soldout">Sold Out</span>
                    {% endunless %}
                    {% if product.compare_at_price > product.price %}
                      <span class="badge badge-sale">Sale</span>
                    {% endif %}
                    {% if product.tags contains 'bestseller' %}
                      <span class="badge badge-bestseller">Bestseller</span>
                    {% endif %}
                    {% if product.tags contains 'new' %}
                      <span class="badge badge-new">New</span>
                    {% endif %}
                  </div>

                  <!-- Quick Add Button -->
                  {% if product.available and product.variants.size == 1 %}
                    <button
                      type="button"
                      class="quick-add-btn"
                      data-variant-id="{{ product.variants.first.id }}"
                      onclick="event.preventDefault(); quickAddToCart({{ product.variants.first.id }}, 1);"
                    >
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M6 6h15l-1.5 9h-12z"/>
                        <circle cx="9" cy="20" r="1"/>
                        <circle cx="18" cy="20" r="1"/>
                        <path d="M6 6L5 3H2"/>
                      </svg>
                      Quick Add
                    </button>
                  {% endif %}
                </div>

                <!-- Card Content -->
                <div class="product-card-content">
                  {% if product.type != blank %}
                    <span class="product-card-type">{{ product.type }}</span>
                  {% endif %}
                  <h3 class="product-card-title">{{ product.title }}</h3>

                  <!-- Price -->
                  <div class="product-card-price">
                    {% if product.compare_at_price > product.price %}
                      <span class="price-sale">{{ product.price | money }}</span>
                      <s class="price-compare">{{ product.compare_at_price | money }}</s>
                    {% else %}
                      <span class="price-regular">{{ product.price | money }}</span>
                    {% endif %}
                  </div>

                  <!-- Rating (placeholder) -->
                  <div class="product-card-rating">
                    {% for i in (1..5) %}
                      <svg viewBox="0 0 16 16" class="star"><path d="M8 0l2.47 5.01L16 5.8l-4 3.9.94 5.5L8 12.26l-4.94 2.94.94-5.5L0 5.8l5.53-.79z"/></svg>
                    {% endfor %}
                    <span class="rating-count">{% if product.metafields.reviews.rating_count %}{{ product.metafields.reviews.rating_count }}{% endif %}</span>
                  </div>

                  <!-- Nano Badge -->
                  {% if product.tags contains 'nano-enhanced' or product.metafields.custom.nano_enhanced == true %}
                    <div class="product-card-nano-badge">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="3"/>
                        <path d="M12 2v4m0 12v4m-8.5-6.5l2.8-2.8m11.4 0l2.8 2.8M2 12h4m12 0h4M5.5 5.5l2.8 2.8m7.4 0l2.8-2.8"/>
                      </svg>
                      Nano-Enhanced
                    </div>
                  {% endif %}
                </div>
              </a>
            </div>
          {% endfor %}
        </div>

        <!-- Pagination -->
        {% if paginate.pages > 1 %}
          <div class="collection-pagination">
            {{ paginate | default_pagination: next: 'Next', previous: 'Previous' }}
          </div>
        {% endif %}

      {% else %}
        <!-- Empty State -->
        <div class="collection-empty">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" class="empty-icon">
            <path d="M6 6h15l-1.5 9h-12z"/>
            <circle cx="9" cy="20" r="1"/>
            <circle cx="18" cy="20" r="1"/>
            <path d="M6 6L5 3H2"/>
          </svg>
          <h2>No products found</h2>
          <p>This collection is currently empty. Check back soon for new products.</p>
          <a href="/collections/shop" class="btn-primary">View All Products</a>
        </div>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

<!-- ====== STYLES ====== -->
<style>
  /* ===== Collection Hero ===== */
  .collection-hero {
    padding-top: 80px;
    background: linear-gradient(135deg, var(--cream, #f5f0e8) 0%, var(--warm-white, #fdfcf9) 100%);
    border-bottom: 1px solid var(--border-light, #f0ece5);
  }

  .collection-hero-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 60px 40px;
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 60px;
    align-items: center;
  }

  .collection-hero-content {
    max-width: 600px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 20px;
    font-size: 0.75rem;
    color: var(--stone, #8a8278);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .breadcrumb a {
    color: var(--stone, #8a8278);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .breadcrumb a:hover {
    color: var(--forest, #1a3a2f);
  }

  .breadcrumb-sep {
    opacity: 0.4;
  }

  .breadcrumb-current {
    color: var(--forest, #1a3a2f);
    font-weight: 500;
  }

  .collection-title {
    font-family: var(--font-display, 'Cormorant Garamond', Georgia, serif);
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 600;
    color: var(--forest, #1a3a2f);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-bottom: 16px;
  }

  .collection-description {
    font-size: 1.0625rem;
    color: var(--stone, #8a8278);
    line-height: 1.7;
    margin-bottom: 16px;
  }

  .collection-description p {
    margin-bottom: 12px;
  }

  .collection-product-count {
    font-size: 0.875rem;
    color: var(--evening-accent, #9b8db0);
    font-weight: 500;
  }

  .collection-hero-image {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .collection-hero-image img {
    max-width: 100%;
    max-height: 320px;
    object-fit: cover;
    border-radius: 20px;
    box-shadow: var(--shadow-lg, 0 8px 40px rgba(0,0,0,0.08));
  }

  /* ===== Toolbar ===== */
  .collection-toolbar {
    background: var(--warm-white, #fdfcf9);
    border-bottom: 1px solid var(--border-light, #f0ece5);
    padding: 16px 0;
    position: sticky;
    top: 80px;
    z-index: 100;
  }

  .toolbar-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .toolbar-label {
    font-size: 0.8125rem;
    color: var(--charcoal-light, #4a4a4a);
    margin-right: 8px;
    font-weight: 500;
  }

  .toolbar-select {
    padding: 8px 32px 8px 12px;
    border: 1px solid var(--border, #e5e0d8);
    border-radius: 8px;
    background: white;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-size: 0.8125rem;
    color: var(--charcoal, #2c2c2c);
    cursor: pointer;
    appearance: none;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' fill='none' stroke='%238a8278' stroke-width='2'%3E%3Cpath d='M6 9l6 6 6-6'/%3E%3C/svg%3E");
    background-repeat: no-repeat;
    background-position: right 8px center;
    background-size: 16px;
  }

  .toolbar-view {
    display: flex;
    gap: 4px;
  }

  .view-btn {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid var(--border, #e5e0d8);
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.3s ease;
    color: var(--stone, #8a8278);
  }

  .view-btn svg {
    width: 16px;
    height: 16px;
  }

  .view-btn:hover {
    border-color: var(--evening-accent, #9b8db0);
    color: var(--evening-accent, #9b8db0);
  }

  .view-btn.active {
    background: var(--forest, #1a3a2f);
    border-color: var(--forest, #1a3a2f);
    color: white;
  }

  /* ===== Product Grid ===== */
  .collection-products {
    padding: 60px 0 100px;
    background: var(--warm-white, #fdfcf9);
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  .product-card {
    background: var(--linen, #faf8f3);
    border-radius: 16px;
    border: 1px solid var(--border-light, #f0ece5);
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .product-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 48px rgba(0,0,0,0.08);
    border-color: var(--border, #e5e0d8);
  }

  .product-card-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .product-card-img {
    position: relative;
    height: 280px;
    background: var(--cream, #f5f0e8);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .product-card-img img {
    max-height: 200px;
    width: auto;
    transition: transform 0.5s ease, opacity 0.4s ease;
  }

  .product-card-image-hover {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    opacity: 0;
  }

  .product-card.product-card--has-hover:hover .product-card-image-primary {
    opacity: 0;
  }

  .product-card.product-card--has-hover:hover .product-card-image-hover {
    opacity: 1;
  }

  .product-card.product-card--has-hover:hover .product-card-img img {
    transform: scale(1.05);
  }

  .product-card-placeholder {
    width: 60%;
    height: auto;
    opacity: 0.3;
  }

  /* Badges */
  .product-card-badges {
    position: absolute;
    top: 12px;
    left: 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .badge {
    padding: 4px 12px;
    border-radius: 100px;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .badge-sale {
    background: var(--terra-cotta, #c17c5b);
    color: white;
  }

  .badge-soldout {
    background: var(--charcoal-light, #4a4a4a);
    color: white;
  }

  .badge-bestseller {
    background: var(--gold, #c9a84c);
    color: white;
  }

  .badge-new {
    background: var(--sage-mist, #8b9a7d);
    color: white;
  }

  /* Quick Add Button */
  .quick-add-btn {
    position: absolute;
    bottom: 16px;
    left: 50%;
    transform: translateX(-50%) translateY(10px);
    padding: 10px 24px;
    background: var(--forest, #1a3a2f);
    color: white;
    border: none;
    border-radius: 8px;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
    opacity: 0;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }

  .quick-add-btn svg {
    width: 16px;
    height: 16px;
  }

  .product-card:hover .quick-add-btn {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  .quick-add-btn:hover {
    background: var(--forest-light, #2d5a48);
  }

  /* Card Content */
  .product-card-content {
    padding: 24px;
  }

  .product-card-type {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--evening-accent, #9b8db0);
    margin-bottom: 6px;
    display: block;
  }

  .product-card-title {
    font-family: var(--font-display, 'Cormorant Garamond', Georgia, serif);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--charcoal, #2c2c2c);
    margin-bottom: 10px;
    line-height: 1.3;
  }

  .product-card-price {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }

  .price-regular {
    font-family: var(--font-display, 'Cormorant Garamond', Georgia, serif);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--charcoal, #2c2c2c);
  }

  .price-sale {
    font-family: var(--font-display, 'Cormorant Garamond', Georgia, serif);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--terra-cotta, #c17c5b);
  }

  .price-compare {
    font-family: var(--font-display, 'Cormorant Garamond', Georgia, serif);
    font-size: 0.95rem;
    color: var(--stone, #8a8278);
  }

  .product-card-rating {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-bottom: 10px;
  }

  .product-card-rating .star {
    width: 12px;
    height: 12px;
    fill: var(--gold, #c9a84c);
  }

  .rating-count {
    font-size: 0.75rem;
    color: var(--stone, #8a8278);
    margin-left: 4px;
  }

  .product-card-nano-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: linear-gradient(135deg, rgba(156,175,136,0.15) 0%, rgba(45,74,62,0.08) 100%);
    border: 1.5px solid rgba(156,175,136,0.4);
    border-radius: 100px;
    padding: 4px 10px;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--deep-forest, #1a3a2f);
  }

  .product-card-nano-badge svg {
    width: 10px;
    height: 10px;
  }

  /* ===== Pagination ===== */
  .collection-pagination {
    margin-top: 60px;
    display: flex;
    justify-content: center;
  }

  .collection-pagination .pagination {
    display: flex;
    align-items: center;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .collection-pagination .pagination a,
  .collection-pagination .pagination .current {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    height: 40px;
    padding: 0 12px;
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .collection-pagination .pagination a {
    color: var(--charcoal, #2c2c2c);
    border: 1px solid var(--border, #e5e0d8);
    background: white;
  }

  .collection-pagination .pagination a:hover {
    border-color: var(--forest, #1a3a2f);
    color: var(--forest, #1a3a2f);
  }

  .collection-pagination .pagination .current {
    background: var(--forest, #1a3a2f);
    color: white;
    border: 1px solid var(--forest, #1a3a2f);
  }

  .collection-pagination .pagination .deco {
    color: var(--stone, #8a8278);
    padding: 0 4px;
  }

  /* ===== Empty State ===== */
  .collection-empty {
    text-align: center;
    padding: 80px 24px;
    max-width: 500px;
    margin: 0 auto;
  }

  .collection-empty .empty-icon {
    width: 64px;
    height: 64px;
    stroke: var(--border, #e5e0d8);
    margin: 0 auto 24px;
  }

  .collection-empty h2 {
    font-family: var(--font-display, 'Cormorant Garamond', Georgia, serif);
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--forest, #1a3a2f);
    margin-bottom: 12px;
  }

  .collection-empty p {
    font-size: 1rem;
    color: var(--stone, #8a8278);
    margin-bottom: 24px;
  }

  .collection-empty .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 32px;
    background: var(--forest, #1a3a2f);
    color: white;
    border: none;
    border-radius: 10px;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .collection-empty .btn-primary:hover {
    background: var(--forest-light, #2d5a48);
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(26, 58, 47, 0.25);
  }

  /* ===== Responsive ===== */
  @media (max-width: 1024px) {
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .collection-hero-inner {
      grid-template-columns: 1fr;
      gap: 40px;
      text-align: center;
    }
    .collection-hero-image {
      order: -1;
    }
    .collection-hero-image img {
      max-height: 240px;
    }
    .breadcrumb {
      justify-content: center;
    }
  }

  @media (max-width: 768px) {
    .collection-hero-inner {
      padding: 40px 20px;
    }
    .toolbar-inner {
      padding: 0 20px;
    }
    .collection-products .section-inner {
      padding: 0 20px;
    }
    .product-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .product-card-img {
      height: 240px;
    }
    .collection-hero-image img {
      max-height: 200px;
    }
  }

  /* ===== List View ===== */
  .product-grid.list-view {
    grid-template-columns: 1fr;
  }

  .product-grid.list-view .product-card {
    display: grid;
    grid-template-columns: 280px 1fr;
  }

  .product-grid.list-view .product-card-img {
    height: auto;
    min-height: 220px;
  }

  .product-grid.list-view .product-card-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 32px;
  }

  .product-grid.list-view .product-card-title {
    font-size: 1.5rem;
  }

  @media (max-width: 768px) {
    .product-grid.list-view .product-card {
      grid-template-columns: 1fr;
    }
    .product-grid.list-view .product-card-img {
      height: 240px;
    }
  }
</style>

<!-- ====== JAVASCRIPT ====== -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  // View toggle
  var viewBtns = document.querySelectorAll('.view-btn');
  var productGrid = document.getElementById('productGrid');

  viewBtns.forEach(function(btn) {
    btn.addEventListener('click', function() {
      var view = this.dataset.view;
      viewBtns.forEach(function(b) { b.classList.remove('active'); });
      this.classList.add('active');
      if (view === 'list') {
        productGrid.classList.add('list-view');
      } else {
        productGrid.classList.remove('list-view');
      }
    });
  });
});

// Quick Add to Cart
function quickAddToCart(variantId, quantity) {
  fetch('/cart/add.js', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json'
    },
    body: JSON.stringify({
      id: variantId,
      quantity: quantity
    })
  })
  .then(function(response) { return response.json(); })
  .then(function(item) {
    // Show success toast
    showToast(item.title + ' added to cart');
    // Refresh cart count
    refreshCartCount();
  })
  .catch(function(error) {
    showToast('Error adding to cart');
  });
}

function showToast(message) {
  var toast = document.getElementById('toast');
  if (toast) {
    toast.textContent = message;
    toast.classList.add('show');
    setTimeout(function() {
      toast.classList.remove('show');
    }, 3000);
  }
}

function refreshCartCount() {
  fetch('/cart.js')
    .then(function(response) { return response.json(); })
    .then(function(cart) {
      var cartCount = document.getElementById('cartCount');
      if (cartCount) {
        cartCount.textContent = cart.item_count;
        cartCount.style.display = cart.item_count > 0 ? 'flex' : 'none';
      }
    });
}
</script>
