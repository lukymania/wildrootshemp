{% comment %}
  Wild Roots Hemp - Generic Page Template
  Used for static pages like About, Contact, FAQ, Shipping Policy, etc.
{% endcomment %}

<!-- ====== PAGE HERO ====== -->
<section class="page-hero">
  <div class="page-hero-inner">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="breadcrumb-sep">/</span>
      <span class="breadcrumb-current">{{ page.title }}</span>
    </nav>
    <h1 class="page-title">{{ page.title }}</h1>
  </div>
</section>

<!-- ====== PAGE CONTENT ====== -->
<section class="page-content-section">
  <div class="page-content-inner">
    <article class="page-body" itemscope itemtype="https://schema.org/WebPage">
      <meta itemprop="name" content="{{ page.title | escape }}">
      <meta itemprop="description" content="{{ page.content | strip_html | truncate: 200 | escape }}">

      {% if page.content != blank %}
        <div class="page-body-content" itemprop="mainContentOfPage">
          {{ page.content }}
        </div>
      {% else %}
        <div class="page-empty">
          <p>This page is currently being updated. Please check back soon.</p>
        </div>
      {% endif %}
    </article>
  </div>
</section>

<!-- ====== SCHEMA.ORG JSON-LD ====== -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": {{ page.title | json }},
  "description": {{ page.content | strip_html | truncate: 300 | json }},
  "url": {{ shop.url | append: page.url | json }},
  "publisher": {
    "@id": "{{ shop.url }}/#organization"
  }
}
</script>

<!-- ====== STYLES ====== -->
<style>
  /* ===== Page Hero ===== */
  .page-hero {
    padding-top: 80px;
    background: linear-gradient(135deg, var(--cream, #f5f0e8) 0%, var(--warm-white, #fdfcf9) 100%);
    border-bottom: 1px solid var(--border-light, #f0ece5);
  }

  .page-hero-inner {
    max-width: 800px;
    margin: 0 auto;
    padding: 60px 40px;
    text-align: center;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-bottom: 24px;
    font-size: 0.75rem;
    color: var(--stone, #8a8278);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .breadcrumb a {
    color: var(--stone, #8a8278);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .breadcrumb a:hover {
    color: var(--forest, #1a3a2f);
  }

  .breadcrumb-sep {
    opacity: 0.4;
  }

  .breadcrumb-current {
    color: var(--forest, #1a3a2f);
    font-weight: 500;
  }

  .page-title {
    font-family: var(--font-display, 'Cormorant Garamond', Georgia, serif);
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 600;
    color: var(--forest, #1a3a2f);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  /* ===== Page Content ===== */
  .page-content-section {
    padding: 60px 0 100px;
    background: var(--warm-white, #fdfcf9);
  }

  .page-content-inner {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .page-body-content {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--charcoal, #2c2c2c);
  }

  /* Headings */
  .page-body-content h1 {
    font-family: var(--font-display, 'Cormorant Garamond', Georgia, serif);
    font-size: 2.25rem;
    font-weight: 600;
    color: var(--forest, #1a3a2f);
    margin: 48px 0 20px;
    line-height: 1.2;
  }

  .page-body-content h2 {
    font-family: var(--font-display, 'Cormorant Garamond', Georgia, serif);
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--forest, #1a3a2f);
    margin: 40px 0 16px;
    line-height: 1.2;
  }

  .page-body-content h3 {
    font-family: var(--font-display, 'Cormorant Garamond', Georgia, serif);
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--forest, #1a3a2f);
    margin: 32px 0 12px;
    line-height: 1.3;
  }

  .page-body-content h4 {
    font-family: var(--font-display, 'Cormorant Garamond', Georgia, serif);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--forest, #1a3a2f);
    margin: 24px 0 10px;
  }

  /* Paragraphs */
  .page-body-content p {
    margin-bottom: 20px;
  }

  /* Links */
  .page-body-content a {
    color: var(--evening-accent, #9b8db0);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.3s ease;
  }

  .page-body-content a:hover {
    color: var(--forest, #1a3a2f);
  }

  /* Bold */
  .page-body-content strong {
    font-weight: 600;
    color: var(--forest, #1a3a2f);
  }

  /* Lists */
  .page-body-content ul,
  .page-body-content ol {
    margin: 20px 0;
    padding-left: 24px;
  }

  .page-body-content ul {
    list-style: disc;
  }

  .page-body-content ol {
    list-style: decimal;
  }

  .page-body-content li {
    margin-bottom: 10px;
    line-height: 1.7;
  }

  .page-body-content ul ul,
  .page-body-content ol ol {
    margin: 8px 0 8px 16px;
  }

  /* Blockquotes */
  .page-body-content blockquote {
    border-left: 4px solid var(--evening-accent, #9b8db0);
    padding: 20px 28px;
    margin: 32px 0;
    background: var(--linen, #faf8f3);
    border-radius: 0 16px 16px 0;
    font-style: italic;
    color: var(--charcoal-light, #4a4a4a);
  }

  .page-body-content blockquote p:last-child {
    margin-bottom: 0;
  }

  /* Images */
  .page-body-content img {
    max-width: 100%;
    height: auto;
    border-radius: 16px;
    margin: 32px 0;
    box-shadow: var(--shadow-md, 0 4px 20px rgba(0,0,0,0.06));
  }

  /* Tables */
  .page-body-content table {
    width: 100%;
    border-collapse: collapse;
    margin: 24px 0;
    font-size: 0.9375rem;
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: var(--shadow, 0 1px 3px rgba(0,0,0,0.04));
  }

  .page-body-content thead {
    background: var(--forest, #1a3a2f);
    color: white;
  }

  .page-body-content th {
    padding: 14px 20px;
    text-align: left;
    font-weight: 600;
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .page-body-content td {
    padding: 14px 20px;
    border-bottom: 1px solid var(--border-light, #f0ece5);
    color: var(--charcoal-light, #4a4a4a);
  }

  .page-body-content tbody tr:last-child td {
    border-bottom: none;
  }

  .page-body-content tbody tr:nth-child(even) {
    background: var(--linen, #faf8f3);
  }

  /* Horizontal Rule */
  .page-body-content hr {
    border: none;
    height: 1px;
    background: var(--border-light, #f0ece5);
    margin: 40px 0;
  }

  /* Iframe (Maps, Videos) */
  .page-body-content iframe {
    max-width: 100%;
    border-radius: 16px;
    margin: 24px 0;
  }

  /* Empty State */
  .page-empty {
    text-align: center;
    padding: 60px 24px;
  }

  .page-empty p {
    font-size: 1.0625rem;
    color: var(--stone, #8a8278);
  }

  /* ===== Responsive ===== */
  @media (max-width: 768px) {
    .page-hero-inner {
      padding: 40px 20px;
    }

    .page-content-inner {
      padding: 0 20px;
    }

    .page-body-content {
      font-size: 1rem;
    }

    .page-body-content h1 {
      font-size: 1.875rem;
    }

    .page-body-content h2 {
      font-size: 1.5rem;
    }

    .page-body-content h3 {
      font-size: 1.25rem;
    }

    .page-body-content img {
      border-radius: 12px;
    }

    .page-body-content table {
      display: block;
      overflow-x: auto;
      white-space: nowrap;
    }

    .page-body-content th,
    .page-body-content td {
      padding: 10px 14px;
    }

    .page-body-content blockquote {
      padding: 16px 20px;
      border-radius: 0 12px 12px 0;
    }
  }
</style>
