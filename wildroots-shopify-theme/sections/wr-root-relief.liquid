<style>
/* ============================================
   WILD ROOTS HEMP, ROOT RELIEF ROLL-ON
   PRODUCT PAGE STYLES
   ============================================ */

/* CSS Custom Properties */
:root {
  --deep-forest: #2D4A3E;
  --sage-mist: #9CAF88;
  --raw-umber: #6B4226;
  --terra-cotta: #C17A5F;
  --cream: #F5F0E8;
  --dark-brown: #3D2B1F;
  --light-sage: #C5D4B8;
  --kraft-brown: #C4A882;
  --white: #FFFFFF;
  --near-white: #FAFAF7;

  --font-headline: 'Playfair Display', serif;
  --font-body: 'Lato', sans-serif;
  --font-accent: 'Cormorant Garamond', serif;

  --max-width: 1200px;
  --header-height: 80px;
  --transition: all 0.3s ease;
  --shadow-sm: 0 2px 8px rgba(45, 74, 62, 0.08);
  --shadow-md: 0 8px 24px rgba(45, 74, 62, 0.12);
  --shadow-lg: 0 16px 48px rgba(45, 74, 62, 0.16);
      --forest-deep: #0f241c;
    }

/* Reset & Base */
*, *::before, *::after {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  font-size: 16px;
}

body {
  font-family: var(--font-body);
  font-weight: 400;
  color: var(--dark-brown);
  background-color: var(--cream);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  overflow-x: hidden;
}

h1, h2, h3, h4 {
  font-family: var(--font-headline);
  font-weight: 700;
  line-height: 1.2;
  color: var(--deep-forest);
}

h1 { font-size: clamp(2rem, 4vw, 3rem); }
h2 { font-size: clamp(2rem, 4vw, 3rem); }
h3 { font-size: clamp(1.25rem, 2vw, 1.5rem); }
h4 { font-size: 1.15rem; }

p {
  margin-bottom: 1rem;
  font-size: 1rem;
  line-height: 1.7;
}

a {
  color: var(--terra-cotta);
  text-decoration: none;
  transition: var(--transition);
}

a:hover {
  color: var(--raw-umber);
}

img {
  max-width: 100%;
  height: auto;
  display: block;
}

.container {
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 0 1.5rem;
}

.section-padding {
  padding: 5rem 0;
}

/* Scroll Reveal Animation */
.reveal {
  opacity: 1;
  transform: translateY(30px);
  transition: opacity 0.8s ease, transform 0.8s ease;
}

.reveal.active {
  opacity: 1;
  transform: translateY(0);
}

.reveal-delay-1 { transition-delay: 0.1s; }
.reveal-delay-2 { transition-delay: 0.2s; }
.reveal-delay-3 { transition-delay: 0.3s; }
.reveal-delay-4 { transition-delay: 0.4s; }

/* Section Label */
.section-label {
  font-family: var(--font-accent);
  font-style: italic;
  font-size: 1.15rem;
  color: var(--terra-cotta);
  margin-bottom: 0.75rem;
  display: block;
}

/* Buttons */
.btn {
  display: inline-block;
  padding: 1rem 2.5rem;
  font-family: var(--font-body);
  font-weight: 700;
  font-size: 0.95rem;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  border: none;
  cursor: pointer;
  transition: var(--transition);
  text-align: center;
  border-radius: 4px;
}

.btn-primary {
  background-color: var(--terra-cotta);
  color: #fff;
}

.btn-primary:hover {
  background-color: var(--raw-umber);
  color: #fff;
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
}

.btn-secondary {
  background-color: transparent;
  color: var(--deep-forest);
  border: 2px solid var(--deep-forest);
}

.btn-secondary:hover {
  background-color: var(--deep-forest);
  color: var(--cream);
  transform: translateY(-2px);
}

/* ============================================
   HEADER
   ============================================ */
.site-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: var(--header-height);
  background-color: var(--cream);
  z-index: 1000;
  border-bottom: 1px solid rgba(45, 74, 62, 0.12);
  transition: var(--transition);
}

.header-inner {
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 0 1.5rem;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.logo {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  text-decoration: none;
}

.logo-img {
  height: 68px;
  width: auto;
  display: block;
}

.nav-desktop {
  display: none;
}

.nav-list {
  display: flex;
  list-style: none;
  gap: 2.5rem;
}

.nav-list a {
  font-family: var(--font-body);
  font-weight: 400;
  font-size: 0.9rem;
  color: var(--dark-brown);
  text-transform: uppercase;
  letter-spacing: 1px;
  position: relative;
  padding-bottom: 4px;
}

.nav-list a::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 0;
  height: 2px;
  background-color: var(--terra-cotta);
  transition: width 0.3s ease;
}

.nav-list a:hover::after {
  width: 100%;
}

.nav-list a:hover {
  color: var(--terra-cotta);
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 1.5rem;
}

.cart-btn {
  position: relative;
  background: none;
  border: none;
  cursor: pointer;
  padding: 0.5rem;
}

.cart-btn svg {
  width: 24px;
  height: 24px;
  stroke: var(--deep-forest);
  transition: stroke 0.3s ease;
}

.cart-btn:hover svg {
  stroke: var(--terra-cotta);
}

.cart-count {
  position: absolute;
  top: -2px;
  right: -6px;
  background-color: var(--terra-cotta);
  color: #fff;
  font-size: 0.65rem;
  font-weight: 700;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Mobile Menu Toggle */
.menu-toggle {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  width: 28px;
  height: 20px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 0;
  z-index: 1001;
  touch-action: manipulation;
  -webkit-tap-highlight-color: transparent;
}

.menu-toggle span {
  display: block;
  width: 100%;
  height: 2px;
  background-color: var(--deep-forest);
  transition: var(--transition);
  transform-origin: center;
}

.menu-toggle.active span:nth-child(1) {
  transform: translateY(9px) rotate(45deg);
}

.menu-toggle.active span:nth-child(2) {
  opacity: 0;
}

.menu-toggle.active span:nth-child(3) {
  transform: translateY(-9px) rotate(-45deg);
}

/* Mobile Navigation */
.mobile-nav {
  position: fixed;
  top: var(--header-height);
  left: 0;
  right: 0;
  bottom: 0;
  background-color: var(--cream);
  z-index: 999;
  padding: 2rem;
  transform: translate3d(100%, 0, 0);
  transition: transform 0.4s ease;
  overflow-y: auto;
}

.mobile-nav.active {
  -moz-transform: translate3d(0, 0, 0);
  transform: translate3d(0, 0, 0);
}

.mobile-nav-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.mobile-nav-list a {
  font-family: var(--font-headline);
  font-weight: 700;
  font-size: 1.5rem;
  color: var(--deep-forest);
  display: block;
  padding: 0.5rem 0;
  border-bottom: 1px solid var(--light-sage);
}

.mobile-nav-list a:hover {
  color: var(--terra-cotta);
}

/* ============================================
   PRODUCT HERO
   ============================================ */
.product-hero {
  margin-top: var(--header-height);
  background: linear-gradient(135deg, var(--cream) 0%, var(--light-sage) 100%);
  padding: 4rem 0;
  min-height: calc(100vh - var(--header-height));
  display: flex;
  align-items: center;
}

.product-hero-inner {
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 0 1.5rem;
  display: grid;
  grid-template-columns: 1fr;
  gap: 3rem;
  align-items: center;
}

/* Product Image */
.product-image-wrap {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
}

.product-image-main {
  max-width: 400px;
  width: 100%;
  height: 400px;
  object-fit: contain;
  filter: drop-shadow(0 20px 40px rgba(45, 74, 62, 0.2));
  transition: transform 0.5s ease;
}

.product-image-main:hover {
  transform: scale(1.03);
}

/* Product Details */
.product-details {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.product-category-label {
  font-family: var(--font-accent);
  font-style: italic;
  font-size: 1.1rem;
  color: var(--terra-cotta);
}

.product-title {
  font-family: var(--font-headline);
  font-weight: 900;
  font-size: clamp(2rem, 4vw, 3rem);
  color: var(--deep-forest);
  line-height: 1.1;
  margin-bottom: 0.25rem;
}

.product-subtitle {
  font-family: var(--font-body);
  font-weight: 300;
  font-size: 1.15rem;
  color: var(--sage-mist);
  text-transform: uppercase;
  letter-spacing: 2px;
}

/* Star Rating */
.star-rating {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin: 0.5rem 0;
}

.stars {
  color: #E8A838;
  font-size: 1.1rem;
  letter-spacing: 2px;
}

.rating-count {
  font-size: 0.85rem;
  color: var(--raw-umber);
}

/* Product Price */
.product-price {
  font-family: var(--font-headline);
  font-weight: 700;
  font-size: 2rem;
  color: var(--deep-forest);
  margin: 0.5rem 0;
}

/* Quick Specs */
.quick-specs {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  margin: 0.75rem 0;
}

.spec-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  background-color: rgba(255,255,255,0.7);
  padding: 0.5rem 1rem;
  border-radius: 50px;
  font-size: 0.8rem;
  font-weight: 700;
  color: var(--deep-forest);
  text-transform: uppercase;
  letter-spacing: 0.5px;
  border: 1px solid var(--light-sage);
}

.spec-badge svg {
  width: 14px;
  height: 14px;
  stroke: var(--sage-mist);
}

/* Product Actions */
.product-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  margin: 1rem 0;
}

.btn-add-cart {
  background-color: var(--terra-cotta);
  color: #fff;
  padding: 1.1rem 3rem;
  font-size: 1rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  border: none;
  border-radius: 4px;
  cursor: pointer;
  transition: var(--transition);
  display: inline-flex;
  align-items: center;
  gap: 0.75rem;
}

.btn-add-cart:hover {
  background-color: var(--raw-umber);
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
}

.btn-add-cart svg {
  width: 20px;
  height: 20px;
}

/* Trust Badges Row */
.product-trust {
  display: flex;
  flex-wrap: wrap;
  gap: 1.25rem;
  margin-top: 1rem;
  padding-top: 1.5rem;
  border-top: 1px solid var(--light-sage);
}

.trust-item {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  font-size: 0.75rem;
  font-weight: 700;
  color: var(--deep-forest);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.trust-item svg {
  width: 16px;
  height: 16px;
  stroke: var(--sage-mist);
}

/* ============================================
   HOW IT WORKS
   ============================================ */
.how-it-works {
  background-color: var(--white);
  padding: 5rem 0;
}

.how-it-works-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 3rem;
  align-items: center;
}

.how-it-works-content {
  max-width: 540px;
}

.how-it-works-title {
  margin-bottom: 1.25rem;
}

.how-it-works-text {
  font-size: 1.05rem;
  line-height: 1.8;
  color: var(--dark-brown);
  margin-bottom: 1.5rem;
}

.how-it-works-image-wrap {
  position: relative;
}

.how-it-works-image {
  border-radius: 8px;
  box-shadow: var(--shadow-lg);
  width: 100%;
}

.image-caption {
  font-family: var(--font-accent);
  font-style: italic;
  font-size: 0.95rem;
  color: var(--raw-umber);
  margin-top: 0.75rem;
  text-align: center;
}

/* ============================================
   KEY FEATURES
   ============================================ */
.key-features {
  background: linear-gradient(to bottom, var(--cream), var(--near-white));
  padding: 5rem 0;
}

.key-features-header {
  text-align: center;
  margin-bottom: 3.5rem;
}

.features-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 2rem;
}

.feature-card {
  background-color: var(--white);
  padding: 2.5rem 2rem;
  border-radius: 8px;
  text-align: center;
  box-shadow: var(--shadow-sm);
  transition: var(--transition);
  border: 1px solid rgba(156, 175, 136, 0.15);
}

.feature-card:hover {
  transform: translateY(-6px);
  box-shadow: var(--shadow-md);
}

.feature-icon {
  width: 60px;
  height: 60px;
  margin: 0 auto 1.25rem;
  background-color: var(--cream);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.feature-icon svg {
  width: 28px;
  height: 28px;
  stroke: var(--deep-forest);
}

.feature-title {
  font-family: var(--font-headline);
  font-weight: 700;
  font-size: 1.2rem;
  color: var(--deep-forest);
  margin-bottom: 0.5rem;
}

.feature-desc {
  font-size: 0.95rem;
  color: var(--raw-umber);
  line-height: 1.6;
  margin-bottom: 0;
}

/* ============================================
   INGREDIENTS
   ============================================ */
.ingredients {
  background-color: var(--white);
  padding: 5rem 0;
}

.ingredients-header {
  text-align: center;
  margin-bottom: 3rem;
}

.ingredients-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1.5rem;
  max-width: 900px;
  margin: 0 auto;
}

.ingredient-card {
  display: flex;
  align-items: flex-start;
  gap: 1.25rem;
  padding: 1.75rem;
  background-color: var(--cream);
  border-radius: 8px;
  border-left: 4px solid var(--sage-mist);
  transition: var(--transition);
}

.ingredient-card:hover {
  box-shadow: var(--shadow-sm);
  transform: translateX(4px);
}

.ingredient-number {
  font-family: var(--font-headline);
  font-weight: 900;
  font-size: 1.75rem;
  color: var(--sage-mist);
  line-height: 1;
  min-width: 36px;
}

.ingredient-info h4 {
  font-family: var(--font-headline);
  font-weight: 700;
  color: var(--deep-forest);
  margin-bottom: 0.35rem;
}

.ingredient-info p {
  font-size: 0.95rem;
  color: var(--raw-umber);
  margin-bottom: 0;
  line-height: 1.6;
}

/* ============================================
   HOW TO USE
   ============================================ */
.how-to-use {
  background: linear-gradient(to bottom, var(--near-white), var(--cream));
  padding: 5rem 0;
}

.how-to-use-header {
  text-align: center;
  margin-bottom: 3.5rem;
}

.steps-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 2rem;
  max-width: 1000px;
  margin: 0 auto;
}

.step-card {
  background-color: var(--white);
  padding: 2.5rem 2rem;
  border-radius: 8px;
  text-align: center;
  box-shadow: var(--shadow-sm);
  position: relative;
  transition: var(--transition);
}

.step-card:hover {
  box-shadow: var(--shadow-md);
  transform: translateY(-4px);
}

.step-number {
  font-family: var(--font-headline);
  font-weight: 900;
  font-size: 3rem;
  color: var(--light-sage);
  line-height: 1;
  margin-bottom: 1rem;
}

.step-icon {
  width: 50px;
  height: 50px;
  margin: 0 auto 1rem;
  stroke: var(--deep-forest);
}

.step-title {
  font-family: var(--font-headline);
  font-weight: 700;
  font-size: 1.2rem;
  color: var(--deep-forest);
  margin-bottom: 0.5rem;
}

.step-desc {
  font-size: 0.95rem;
  color: var(--raw-umber);
  margin-bottom: 0;
}

/* Connecting line for steps */
.step-connector {
  display: none;
}

/* ============================================
   NANO-HEMP DIFFERENCE
   ============================================ */
.nano-difference {
  background-color: var(--deep-forest);
  padding: 5rem 0;
  color: var(--cream);
}

.nano-difference-inner {
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 0 1.5rem;
  display: grid;
  grid-template-columns: 1fr;
  gap: 3rem;
  align-items: center;
}

.nano-difference-content {
  max-width: 540px;
}

.nano-difference-label {
  font-family: var(--font-accent);
  font-style: italic;
  font-size: 1.15rem;
  color: var(--terra-cotta);
  margin-bottom: 0.75rem;
  display: block;
}

.nano-difference-title {
  color: var(--cream);
  margin-bottom: 1.25rem;
}

.nano-difference-text {
  font-size: 1.05rem;
  line-height: 1.8;
  color: rgba(245, 240, 232, 0.9);
  margin-bottom: 1.5rem;
}

.nano-difference-text strong {
  color: var(--cream);
}

.nano-highlight-box {
  background-color: rgba(255,255,255,0.08);
  border-left: 4px solid var(--terra-cotta);
  padding: 1.5rem;
  border-radius: 0 8px 8px 0;
  margin-top: 1.5rem;
}

.nano-highlight-box p {
  font-size: 0.95rem;
  color: rgba(245, 240, 232, 0.85);
  margin-bottom: 0;
}

.nano-difference-visual {
  display: flex;
  justify-content: center;
  align-items: center;
}

.nano-visual-circle {
  width: 260px;
  height: 260px;
  border-radius: 50%;
  background: radial-gradient(circle at center, rgba(156, 175, 136, 0.3) 0%, rgba(45, 74, 62, 0.6) 70%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  border: 2px solid rgba(156, 175, 136, 0.3);
}

.nano-visual-number {
  font-family: var(--font-headline);
  font-weight: 900;
  font-size: 3.5rem;
  color: var(--cream);
  line-height: 1;
}

.nano-visual-label {
  font-family: var(--font-body);
  font-size: 0.9rem;
  color: var(--sage-mist);
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-top: 0.5rem;
}

/* ============================================
   PRODUCT FAQ
   ============================================ */
.product-faq {
  background: linear-gradient(to bottom, var(--near-white), var(--cream));
  padding: 5rem 0;
}

.faq-header {
  text-align: center;
  margin-bottom: 3rem;
}

.faq-accordion {
  max-width: 800px;
  margin: 0 auto;
}

.faq-item {
  background-color: var(--white);
  border-radius: 8px;
  margin-bottom: 1rem;
  box-shadow: var(--shadow-sm);
  overflow: hidden;
  transition: var(--transition);
}

.faq-item:hover {
  box-shadow: var(--shadow-md);
}

.faq-question {
  width: 100%;
  background: none;
  border: none;
  padding: 1.5rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  cursor: pointer;
  font-family: var(--font-headline);
  font-weight: 700;
  font-size: 1.1rem;
  color: var(--deep-forest);
  text-align: left;
}

.faq-question svg {
  width: 20px;
  height: 20px;
  stroke: var(--terra-cotta);
  transition: transform 0.3s ease;
  flex-shrink: 0;
  margin-left: 1rem;
}

.faq-item.active .faq-question svg {
  transform: rotate(180deg);
}

.faq-answer {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.4s ease, padding 0.4s ease;
  padding: 0 1.5rem;
}

.faq-item.active .faq-answer {
  max-height: 300px;
  padding: 0 1.5rem 1.5rem;
}

.faq-answer p {
  font-size: 0.95rem;
  line-height: 1.7;
  color: var(--raw-umber);
  margin-bottom: 0;
}

/* ============================================
   FOOTER
   ============================================ */






.footer-brand p {
  font-size: 0.95rem;
  line-height: 1.7;
  color: rgba(245, 240, 232, 0.85);
  margin-bottom: 1.25rem;
}

.footer-brand .logo-img {
  height: 40px;
}

.footer-title {
  font-family: var(--font-headline);
  font-weight: 700;
  font-size: 1.1rem;
  color: var(--cream);
  margin-bottom: 1.25rem;
}

.footer-links {
  list-style: none;
}

.footer-links li {
  margin-bottom: 0.75rem;
}

.footer-links a {
  color: rgba(245, 240, 232, 0.8);
  font-size: 0.9rem;
  transition: color 0.3s ease;
}

.footer-links a:hover {
