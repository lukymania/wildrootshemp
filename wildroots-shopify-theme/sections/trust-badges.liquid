{% comment %}
  Trust Badges Section
  - Icon row: Nano-Enhanced, Family-Founded, 3rd Party Tested, Cruelty-Free
  - Certifications grid
{% endcomment %}

{%- style -%}
.trust-badges-section {
  background-color: #fff;
  padding: 5rem 0;
  border-top: 1px solid rgba(196, 168, 130, 0.2);
  border-bottom: 1px solid rgba(196, 168, 130, 0.2);
}

.trust-badges__header {
  text-align: center;
  margin-bottom: 3rem;
}

.trust-badges__header h2 {
  color: var(--forest-deep, #0f241c);
  margin-bottom: 0.75rem;
}

.trust-badges__grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.5rem;
  margin-bottom: 3rem;
}

.trust-badge-item {
  text-align: center;
  padding: 1.5rem 1rem;
  background-color: var(--cream, #F5F0E8);
  border-radius: 10px;
  transition: all 0.3s ease;
}

.trust-badge-item:hover {
  transform: translateY(-4px);
  box-shadow: 0 2px 8px rgba(45, 74, 62, 0.08);
}

.trust-badge-item__icon {
  width: 56px;
  height: 56px;
  margin: 0 auto 1rem;
  background-color: var(--light-sage, #C5D4B8);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.trust-badge-item__icon svg {
  width: 28px;
  height: 28px;
  stroke: var(--forest-deep, #0f241c);
  fill: none;
  stroke-width: 1.5;
}

.trust-badge-item h4 {
  font-size: 1rem;
  color: var(--forest-deep, #0f241c);
  margin-bottom: 0.5rem;
}

.trust-badge-item p {
  font-size: 0.8rem;
  color: rgba(61, 43, 31, 0.65);
  line-height: 1.5;
  margin-bottom: 0;
}

.trust-badges__extra {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1.5rem;
}

.trust-extra-item {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 1.25rem;
  background-color: var(--cream, #F5F0E8);
  border-radius: 10px;
  border-left: 4px solid var(--terra-cotta, #C17A5F);
}

.trust-extra-item__icon {
  flex-shrink: 0;
  width: 44px;
  height: 44px;
  background-color: var(--light-sage, #C5D4B8);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.trust-extra-item__icon svg {
  width: 22px;
  height: 22px;
  stroke: var(--forest-deep, #0f241c);
  fill: none;
  stroke-width: 1.5;
}

.trust-extra-item__text h4 {
  font-size: 1rem;
  margin-bottom: 0.25rem;
  color: var(--forest-deep, #0f241c);
}

.trust-extra-item__text p {
  font-size: 0.85rem;
  color: rgba(61, 43, 31, 0.65);
  margin-bottom: 0;
}

@media (min-width: 640px) {
  .trust-badges__grid {
    grid-template-columns: repeat(4, 1fr);
  }
}

@media (min-width: 768px) {
  .trust-badges__extra {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1024px) {
  .trust-badges-section {
    padding: 6rem 0;
  }
}
{%- endstyle -%}

<section class="trust-badges-section" id="trust" aria-labelledby="trust-badges-heading" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="trust-badges__header reveal">
      <span class="section-label">{{ section.settings.label | default: 'Our Promise' }}</span>
      <h2 id="trust-badges-heading">{{ section.settings.heading | default: 'Pure. Transparent. Trustworthy.' }}</h2>
    </div>

    <div class="trust-badges__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'badge' -%}
          <div class="trust-badge-item reveal reveal-delay-{{ forloop.index }}" {{ block.shopify_attributes }}>
            <div class="trust-badge-item__icon">
              {%- case block.settings.icon -%}
                {%- when 'nano' -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3"/><circle cx="12" cy="12" r="6" stroke-dasharray="2 2"/><circle cx="12" cy="12" r="9" stroke-dasharray="3 3"/></svg>
                {%- when 'family' -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                {%- when 'lab' -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 12l2 2 4-4"/><path d="M21 12c.552 0 1-.448 1-1s-.448-1-1-1"/><path d="M3 12c-.552 0-1-.448-1-1s.448-1 1-1"/></svg>
                {%- when 'heart' -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
                {%- when 'check' -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M8 12l2.5 2.5L16 9"/></svg>
                {%- when 'gluten_free' -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2z"/><path d="M8 12h8M12 8v8"/></svg>
                {%- when 'clock' -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                {%- when 'shield' -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M8 12l2.5 2.5L16 9"/></svg>
              {%- endcase -%}
            </div>
            <h4>{{ block.settings.title }}</h4>
            <p>{{ block.settings.description }}</p>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="trust-badges__extra">
      {%- for block in section.blocks -%}
        {%- if block.type == 'extra' -%}
          <div class="trust-extra-item reveal reveal-delay-{{ forloop.index }}" {{ block.shopify_attributes }}>
            <div class="trust-extra-item__icon">
              {%- case block.settings.icon -%}
                {%- when 'lab' -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 12l2 2 4-4"/><path d="M21 12c.552 0 1-.448 1-1s-.448-1-1-1"/><path d="M3 12c-.552 0-1-.448-1-1s.448-1 1-1"/></svg>
                {%- when 'shield' -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                {%- when 'leaf' -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 21l1.5-1.5c2.5-2.5 4-6 4-10h0c4 0 7.5 1.5 10 4L21 15c0 4-3 7-7 7h-8z"/><path d="M15 11c-2.5 0-4.5 1-6 2.5"/></svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M8 12l2.5 2.5L16 9"/></svg>
              {%- endcase -%}
            </div>
            <div class="trust-extra-item__text">
              <h4>{{ block.settings.title }}</h4>
              <p>{{ block.settings.description }}</p>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trust Badges",
  "tag": "section",
  "class": "trust-badges-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section label",
      "default": "Our Promise"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pure. Transparent. Trustworthy."
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "nano", "label": "Nano (molecule)" },
            { "value": "family", "label": "Family" },
            { "value": "lab", "label": "Lab/tested" },
            { "value": "heart", "label": "Heart" },
            { "value": "check", "label": "Checkmark" },
            { "value": "gluten_free", "label": "Gluten Free" },
            { "value": "clock", "label": "Clock" },
            { "value": "shield", "label": "Shield" }
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Badge Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Description of this certification or promise."
        }
      ]
    },
    {
      "type": "extra",
      "name": "Extra Detail",
      "limit": 2,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "lab", "label": "Lab/tested" },
            { "value": "shield", "label": "Shield" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "check", "label": "Checkmark" }
          ],
          "default": "lab"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Third-Party Lab Tested"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Every batch is independently verified for purity, potency, and safety."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Badges",
      "category": "Content",
      "blocks": {
        "badge-0": { "type": "badge", "settings": { "icon": "nano", "title": "Nano-Enhanced", "description": "Proprietary nano fragmentation technology for 3-8x better absorption." } },
        "badge-1": { "type": "badge", "settings": { "icon": "family", "title": "Family-Founded", "description": "Built by a family, for families. Midwest roots, West Coast wild." } },
        "badge-2": { "type": "badge", "settings": { "icon": "lab", "title": "3rd Party Tested", "description": "Every batch independently verified for purity, potency, and safety." } },
        "badge-3": { "type": "badge", "settings": { "icon": "heart", "title": "Cruelty-Free", "description": "Never tested on animals. Leaping Bunny certified commitment." } },
        "extra-0": { "type": "extra", "settings": { "icon": "lab", "title": "Third-Party Lab Tested", "description": "Every batch is independently verified for purity, potency, and safety." } },
        "extra-1": { "type": "extra", "settings": { "icon": "shield", "title": "GMP Certified Facility", "description": "Manufactured in a Good Manufacturing Practice certified facility." } }
      }
    }
  ]
}
{% endschema %}
