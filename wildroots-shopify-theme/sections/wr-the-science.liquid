<style>
/* ========================================
 CSS CUSTOM PROPERTIES (Design Tokens)
======================================== */
:root {
 /* Brand Colors */
 --forest: #2D4A3E;
 --sage: #9CAF88;
 --terra: #C17A5F;
 --cream: #F5F0E8;
 --dark: #1A2E26;
 --dark-alt: #243D33;
 --white: #FFFFFF;
 --black: #1A1A1A;
 --gray: #6B7B6E;
 --light-gray: #E8E4DC;
 --border: rgba(45, 74, 62, 0.15);

 /* Science Section Dark Theme */
 --science-bg: #1a2e26;
 --science-card: #243D33;
 --science-card-hover: #2D4A3E;
 --science-border: rgba(156, 175, 136, 0.2);
 --science-text: #E8E2D6;
 --science-muted: #9CAF88;

 /* Typography */
 --font-display: 'Georgia', 'Times New Roman', serif;
 --font-body: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;

 /* Spacing */
 --space-xs: 0.5rem;
 --space-sm: 1rem;
 --space-md: 2rem;
 --space-lg: 4rem;
 --space-xl: 6rem;

 /* Container */
 --max-width: 1200px;
 --container-padding: 1.5rem;

 /* Border Radius */
 --radius-sm: 6px;
 --radius-md: 12px;
 --radius-lg: 20px;

 /* Shadows */
 --shadow-sm: 0 2px 8px rgba(26, 46, 38, 0.08);
 --shadow-md: 0 8px 30px rgba(26, 46, 38, 0.12);
 --shadow-lg: 0 20px 60px rgba(26, 46, 38, 0.18);

 /* Transitions */
 --transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
 --transition-slow: all 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);

 /* Header Height */
 --header-height: 80px;
      --forest-deep: #0f241c;
    }

/* ========================================
 RESET & BASE
======================================== */
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; font-size: 16px; }
body {
 font-family: var(--font-body);
 color: var(--black);
 background: var(--cream);
 line-height: 1.6;
 -webkit-font-smoothing: antialiased;
 overflow-x: hidden;
}
img { max-width: 100%; height: auto; display: block; }
a { color: inherit; text-decoration: none; transition: var(--transition); }
ul { list-style: none; }
button { cursor: pointer; border: none; background: none; font-family: inherit; }

/* ========================================
 UTILITIES
======================================== */
.container {
 max-width: var(--max-width);
 margin: 0 auto;
 padding-left: var(--container-padding);
 padding-right: var(--container-padding);
}
.section-padding { padding: var(--space-xl) 0; }
.section-padding-lg { padding: calc(var(--space-xl) * 1.5) 0; }
.text-center { text-align: center; }

/* ========================================
 HEADER / NAVIGATION
======================================== */
.site-header {
 position: sticky;
 top: 0;
 z-index: 1000;
 background: rgba(245, 240, 232, 0.95);
 backdrop-filter: blur(20px);
 -webkit-backdrop-filter: blur(20px);
 border-bottom: 1px solid rgba(45, 74, 62, 0.12);
 height: var(--header-height);
}
.header-inner {
 max-width: var(--max-width);
 margin: 0 auto;
 padding: 0 var(--container-padding);
 display: flex;
 align-items: center;
 justify-content: space-between;
 height: 100%;
}
.logo-img {
 height: 68px;
 width: auto;
 display: block;
}
.nav-desktop { display: none; }
.nav-list { display: flex; list-style: none; gap: 2.5rem; margin: 0; padding: 0; }
.nav-list li { display: flex; }
.nav-list a {
 font-family: var(--font-body);
 font-weight: 400;
 font-size: 0.9rem;
 letter-spacing: 1px;
 text-transform: uppercase;
 color: var(--dark-brown);
 position: relative;
 padding: 0.25rem 0;
 transition: var(--transition);
}
.nav-list a::after {
 content: '';
 position: absolute;
 bottom: -2px;
 left: 0;
 width: 0;
 height: 2px;
 background: var(--terra-cotta);
 transition: var(--transition);
}
.nav-list a:hover { color: var(--terra-cotta); }
.nav-list a:hover::after { width: 100%; }
.nav-list a.active { color: var(--terra-cotta); font-weight: 600; }
.nav-list a.active::after { width: 100%; }

.header-actions {
 display: flex;
 align-items: center;
 gap: 1rem;
}
.cart-btn {
 position: relative;
 width: 40px;
 height: 40px;
 display: flex;
 align-items: center;
 justify-content: center;
 border: 0;
 background: transparent;
 color: var(--forest);
 cursor: pointer;
 text-decoration: none;
}
.cart-btn svg {
 width: 24px;
 height: 24px;
 stroke: currentColor;
 fill: none;
}
.cart-btn:hover { color: var(--terra-cotta); }
.cart-count {
 position: absolute;
 top: -1px;
 right: -2px;
 min-width: 18px;
 height: 18px;
 padding: 0 4px;
 border-radius: 999px;
 display: flex;
 align-items: center;
 justify-content: center;
 background: var(--terra-cotta);
 color: #fff;
 font-size: 0.65rem;
 font-weight: 700;
 line-height: 1;
}

/* Mobile Menu Toggle */
.menu-toggle {
 display: none;
 flex-direction: column;
 gap: 5px;
 padding: 8px;
 z-index: 1001;
 touch-action: manipulation;
 -webkit-tap-highlight-color: transparent;
}
.menu-toggle span {
 display: block;
 width: 24px;
 height: 2px;
 background: var(--forest);
 transition: var(--transition);
}
.menu-toggle.active span:nth-child(1) { transform: rotate(45deg) translate(5px, 5px); }
.menu-toggle.active span:nth-child(2) { opacity: 0; }
.menu-toggle.active span:nth-child(3) { transform: rotate(-45deg) translate(5px, -5px); }

/* Mobile Nav */
.mobile-nav {
 display: none;
 position: fixed;
 top: var(--header-height);
 left: 0;
 right: 0;
 bottom: 0;
 background: rgba(245, 240, 232, 0.98);
 backdrop-filter: blur(20px);
 padding: 2rem;
 flex-direction: column;
 gap: 1.5rem;
 z-index: 999;
}
.mobile-nav.active { display: flex; }
.mobile-nav-list {
 list-style: none;
 display: flex;
 flex-direction: column;
 gap: 1.5rem;
}
.mobile-nav-list a {
 font-size: 1.125rem;
 padding: 0.75rem 0;
 border-bottom: 1px solid rgba(45, 74, 62, 0.12);
 color: var(--gray);
 text-decoration: none;
}

/* ========================================
 HERO BANNER
======================================== */
.hero {
 position: relative;
 min-height: 55vh;
 display: flex;
 align-items: center;
 justify-content: center;
 overflow: hidden;
 background: var(--dark);
}
.hero-video {
 position: absolute;
 inset: 0;
 width: 100%;
 height: 100%;
 object-fit: cover;
 opacity: 0.5;
}
.hero-video::-webkit-media-controls { display: none !important; }
.hero-bg {
 display: none;
}
.hero-overlay {
 position: absolute;
 inset: 0;
 background: linear-gradient(180deg, rgba(26, 46, 38, 0.7) 0%, rgba(26, 46, 38, 0.85) 60%, rgba(26, 46, 38, 0.95) 100%);
}
.hero-content {
 position: relative;
 z-index: 2;
 text-align: center;
 max-width: 800px;
 padding: var(--space-lg) var(--container-padding);
}
.hero-label {
 display: inline-block;
 font-size: 0.75rem;
 font-weight: 600;
 letter-spacing: 3px;
 text-transform: uppercase;
 color: var(--sage);
 margin-bottom: var(--space-sm);
 padding: 0.4rem 1rem;
 border: 1px solid var(--sage);
 border-radius: 50px;
}
.hero-title {
 font-family: var(--font-display);
 font-size: clamp(2.5rem, 6vw, 4.5rem);
 font-weight: 600;
 color: var(--cream);
 line-height: 1.15;
 margin-bottom: var(--space-sm);
}
.hero-subtitle {
 font-size: clamp(1rem, 2vw, 1.25rem);
 color: var(--sage);
 font-weight: 300;
 max-width: 500px;
 margin: 0 auto;
}
.hero-scroll {
 position: absolute;
 bottom: 2rem;
 left: 50%;
 transform: translateX(-50%);
 z-index: 2;
}
.hero-scroll svg {
 width: 24px;
 height: 24px;
 stroke: var(--sage);
 animation: bounce 2s infinite;
}
@keyframes bounce {
 0%, 100% { transform: translateY(0); }
 50% { transform: translateY(8px); }
}

/* ========================================
 SECTION HEADERS
======================================== */
.section-header {
 max-width: 700px;
 margin: 0 auto var(--space-lg);
 text-align: center;
}
.section-label {
 display: inline-block;
 font-size: 0.7rem;
 font-weight: 600;
 letter-spacing: 3px;
 text-transform: uppercase;
 color: var(--terra);
 margin-bottom: var(--space-xs);
}
.section-title {
 font-family: var(--font-display);
 font-size: clamp(2rem, 4.5vw, 3.25rem);
 font-weight: 600;
 color: var(--forest);
 line-height: 1.2;
 margin-bottom: var(--space-sm);
}
.section-subtitle {
 font-size: 1.05rem;
 color: var(--gray);
 line-height: 1.7;
}

/* ========================================
 SECTION 1: WHAT IS NANO-HEMP?
======================================== */
.intro-section { background: var(--cream); }
.intro-layout {
 display: grid;
 grid-template-columns: 1fr 1fr;
 gap: var(--space-lg);
 align-items: center;
}
.intro-content p {
 font-size: 1.05rem;
 line-height: 1.85;
 color: var(--black);
 margin-bottom: var(--space-sm);
}
.intro-content p strong {
 color: var(--forest);
 font-weight: 600;
}
.intro-highlight {
 display: inline-flex;
 align-items: center;
 gap: 0.5rem;
 background: var(--forest);
 color: var(--cream);
 padding: 0.5rem 1rem;
 border-radius: var(--radius-sm);
 font-size: 0.9rem;
 font-weight: 600;
 margin-top: var(--space-xs);
}
.intro-image {
 border-radius: var(--radius-lg);
 overflow: hidden;
 box-shadow: var(--shadow-lg);
}
.intro-image img {
 width: 100%;
 display: block;
 border-radius: var(--radius-lg);
 transition: var(--transition-slow);
}
.intro-image:hover img { transform: scale(1.02); }
.intro-image-caption {
 padding: 1rem 1.5rem;
 background: var(--cream);
 color: var(--gray);
 font-size: 0.8rem;
 text-align: center;
 font-style: italic;
}

/* Stats Bar */
.stats-bar {
 display: grid;
 grid-template-columns: repeat(3, 1fr);
 gap: var(--space-md);
 margin-top: var(--space-lg);
 padding-top: var(--space-lg);
 border-top: 1px solid var(--border);
}
.stat-item { text-align: center; }
.stat-number {
 font-family: var(--font-display);
 font-size: 2.5rem;
 color: var(--terra);
 line-height: 1;
 margin-bottom: 0.25rem;
}
.stat-label {
 font-size: 0.8rem;
 color: var(--gray);
 text-transform: uppercase;
 letter-spacing: 1px;
}

/* ========================================
 SECTION 2: THREE STAGES
======================================== */
.stages-section {
 background: var(--science-bg);
 color: var(--science-text);
 position: relative;
 overflow: hidden;
}
.stages-section::before {
 content: '';
 position: absolute;
 top: -50%;
 right: -20%;
 width: 600px;
 height: 600px;
 background: radial-gradient(circle, rgba(156, 175, 136, 0.05) 0%, transparent 70%);
 pointer-events: none;
}
.stages-section .section-title { color: var(--cream); }
.stages-section .section-subtitle { color: var(--sage); }
.stages-section .section-label { color: var(--terra); }

.stages-grid {
 display: grid;
 grid-template-columns: repeat(2, 1fr);
 gap: var(--space-md);
 position: relative;
 z-index: 1;
 max-width: 900px;
 margin: 0 auto;
}
.stage-card {
 background: var(--science-card);
 border: 1px solid var(--science-border);
 border-radius: var(--radius-md);
 padding: var(--space-md);
 text-align: center;
 transition: var(--transition);
 position: relative;
}
.stage-card:hover {
 background: var(--science-card-hover);
 transform: translateY(-4px);
 box-shadow: var(--shadow-lg);
 border-color: var(--sage);
}
.stage-number {
 display: inline-flex;
 align-items: center;
 justify-content: center;
 width: 56px;
 height: 56px;
 background: var(--forest);
 color: var(--sage);
 font-family: var(--font-display);
 font-size: 1.5rem;
 font-weight: 700;
 border-radius: 50%;
 margin-bottom: var(--space-sm);
 border: 2px solid var(--sage);
}
.stage-title {
 font-family: var(--font-display);
 font-size: 1.35rem;
 color: var(--cream);
 margin-bottom: var(--space-xs);
}
.stage-desc {
 font-size: 0.95rem;
 color: var(--science-muted);
 line-height: 1.7;
}
.stage-connector {
 display: none;
}

/* ========================================
 SECTION 3: COMPARISON TABLE
======================================== */
.compare-section { background: var(--cream); }
.compare-table-wrapper {
 max-width: 900px;
 margin: 0 auto;
 border-radius: var(--radius-md);
 overflow: hidden;
 box-shadow: var(--shadow-md);
}
.compare-table {
 width: 100%;
 border-collapse: collapse;
}
.compare-table thead th {
 background: var(--forest);
 color: var(--cream);
 padding: 1.25rem 1.5rem;
 font-size: 0.85rem;
 font-weight: 600;
 text-transform: uppercase;
 letter-spacing: 1px;
 text-align: left;
}
.compare-table thead th:nth-child(2) { background: var(--dark-alt); }
.compare-table thead th:nth-child(3) {
 background: var(--sage);
 color: var(--dark);
}
.compare-table tbody tr {
 background: var(--white);
 transition: var(--transition);
}
.compare-table tbody tr:nth-child(even) { background: var(--cream); }
.compare-table tbody tr:hover { background: rgba(156, 175, 136, 0.1); }
.compare-table tbody td {
 padding: 1.25rem 1.5rem;
 font-size: 0.95rem;
 border-bottom: 1px solid rgba(45, 74, 62, 0.12);
}
.compare-table tbody td:first-child {
 font-weight: 600;
 color: var(--forest);
}
.compare-table tbody td:nth-child(2) { color: var(--gray); }
.compare-table tbody td:nth-child(3) {
 font-weight: 600;
 color: var(--forest);
 background: rgba(156, 175, 136, 0.08);
}
.compare-table .highlight {
 display: inline-block;
 background: var(--sage);
 color: var(--dark);
 padding: 0.15rem 0.6rem;
 border-radius: 50px;
 font-size: 0.8rem;
 font-weight: 700;
}

/* Mobile Table Cards */
.table-cards { display: none; }
.table-card {
 background: var(--white);
 border-radius: var(--radius-md);
 padding: var(--space-md);
 margin-bottom: var(--space-sm);
 box-shadow: var(--shadow-sm);
 border-left: 4px solid var(--sage);
}
.table-card-header {
 font-family: var(--font-display);
 font-size: 1.15rem;
 color: var(--forest);
 margin-bottom: var(--space-xs);
}
.table-card-row {
 display: flex;
 justify-content: space-between;
 padding: 0.5rem 0;
 border-bottom: 1px solid rgba(45, 74, 62, 0.12);
}
.table-card-row:last-child { border-bottom: none; }
.table-card-label {
 font-size: 0.8rem;
 font-weight: 600;
 color: var(--gray);
 text-transform: uppercase;
}
.table-card-value {
 font-weight: 600;
 color: var(--forest);
}

/* ========================================
 SECTION 4: FOUR INGREDIENTS
======================================== */
.ingredients-section {
 background: var(--science-bg);
 color: var(--science-text);
 position: relative;
}
.ingredients-section .section-title { color: var(--cream); }
.ingredients-section .section-subtitle { color: var(--sage); }
.ingredients-section .section-label { color: var(--terra); }

.ingredients-grid {
 display: grid;
 grid-template-columns: repeat(2, 1fr);
 gap: var(--space-md);
 margin-bottom: var(--space-lg);
}
.ingredient-card {
 display: flex;
 gap: var(--space-sm);
 background: var(--science-card);
 border: 1px solid var(--science-border);
 border-radius: var(--radius-md);
 padding: var(--space-md);
 transition: var(--transition);
}
.ingredient-card:hover {
 background: var(--science-card-hover);
 border-color: var(--sage);
 transform: translateY(-3px);
}
.ingredient-icon {
 flex-shrink: 0;
 width: 56px;
 height: 56px;
 display: flex;
 align-items: center;
 justify-content: center;
 background: var(--forest);
 border-radius: var(--radius-sm);
 font-size: 1.5rem;
 border: 1px solid var(--sage);
}

.ingredient-icon svg {
 width: 30px;
 height: 30px;
 fill: none;
 stroke: currentColor;
 stroke-width: 1.6;
 stroke-linecap: round;
 stroke-linejoin: round;
}
.ingredient-info h3 {
 font-family: var(--font-display);
 font-size: 1.2rem;
 color: var(--cream);
 margin-bottom: 0.4rem;
}
.ingredient-info p {
 font-size: 0.9rem;
 color: var(--science-muted);
 line-height: 1.7;
}

/* Ingredients CTA */
.ingredients-cta {
 text-align: center;
 max-width: 700px;
 margin: 0 auto;
 padding: var(--space-md);
 background: rgba(156, 175, 136, 0.08);
 border: 1px dashed var(--science-border);
 border-radius: var(--radius-md);
}
.ingredients-cta p {
 font-size: 1.1rem;
 color: var(--science-text);
 font-style: italic;
}
.ingredients-cta-note {
 text-align: center;
 margin-top: var(--space-sm);
 font-size: 0.85rem;
 color: var(--sage);
}

/* ========================================
 SECTION 5: THIRD-PARTY TESTING
======================================== */
.testing-section { background: var(--cream); }
.testing-grid {
 display: grid;
 grid-template-columns: repeat(4, 1fr);
 gap: var(--space-md);
 margin-bottom: var(--space-lg);
}
.testing-card {
 background: var(--white);
 border: 1px solid var(--border);
 border-radius: var(--radius-md);
 padding: var(--space-md);
 text-align: center;
 transition: var(--transition);
}
.testing-card:hover {
 border-color: var(--sage);
 box-shadow: var(--shadow-md);
 transform: translateY(-4px);
}
.testing-icon {
 width: 64px;
 height: 64px;
 margin: 0 auto var(--space-sm);
 display: flex;
 align-items: center;
 justify-content: center;
 background: var(--forest);
 border-radius: 50%;
}
.testing-icon svg { stroke: var(--sage); }
.testing-card h3 {
 font-family: var(--font-display);
 font-size: 1.1rem;
 color: var(--forest);
 margin-bottom: 0.5rem;
}
.testing-card p {
 font-size: 0.85rem;
 color: var(--gray);
 line-height: 1.6;
}

/* Testing CTA Banner */
.testing-cta {
 background: var(--forest);
 border-radius: var(--radius-md);
 padding: var(--space-md) var(--space-lg);
 display: flex;
 align-items: center;
 justify-content: space-between;
 gap: var(--space-md);
}
.testing-cta-text {
 color: var(--cream);
 font-family: var(--font-display);
 font-size: 1.3rem;
}
.testing-cta-sub {
 color: var(--sage);
 font-size: 0.9rem;
 margin-top: 0.25rem;
}
.testing-cta-btn {
 display: inline-flex;
 align-items: center;
 gap: 0.5rem;
 background: var(--sage);
 color: var(--dark);
 padding: 0.875rem 2rem;
 border-radius: var(--radius-sm);
 font-size: 0.9rem;
 font-weight: 600;
 text-transform: uppercase;
 letter-spacing: 1px;
 transition: var(--transition);
 white-space: nowrap;
}
.testing-cta-btn:hover {
 background: var(--cream);
 transform: translateY(-2px);
}

/* ========================================
 SECTION 6: FAQ ACCORDION
======================================== */
.faq-section { background: var(--cream); }
.faq-container {
 max-width: 800px;
 margin: 0 auto;
}
.faq-item {
 background: var(--white);
 border: 1px solid var(--border);
 border-radius: var(--radius-md);
 margin-bottom: var(--space-xs);
 overflow: hidden;
 transition: var(--transition);
}
.faq-item:hover { border-color: var(--sage); }
.faq-item.active { border-color: var(--sage); box-shadow: var(--shadow-sm); }
.faq-question {
 display: flex;
 align-items: center;
 justify-content: space-between;
 width: 100%;
 padding: 1.25rem 1.5rem;
 font-size: 1.05rem;
 font-weight: 600;
 color: var(--forest);
 text-align: left;
 transition: var(--transition);
}
.faq-question:hover { background: rgba(156, 175, 136, 0.05); }
.faq-icon {
 flex-shrink: 0;
 width: 28px;
 height: 28px;
 display: flex;
 align-items: center;
 justify-content: center;
 border-radius: 50%;
 background: var(--light-gray);
 margin-left: var(--space-sm);
 transition: var(--transition);
}
.faq-icon svg { stroke: var(--forest); transition: var(--transition); }
.faq-item.active .faq-icon { background: var(--sage); }
.faq-item.active .faq-icon svg { stroke: var(--dark); transform: rotate(180deg); }
.faq-answer {
 max-height: 0;
 overflow: hidden;
 transition: max-height 0.4s ease-out, padding 0.4s ease;
}
.faq-item.active .faq-answer {
 max-height: 400px;
 padding: 0 1.5rem 1.5rem;
}
.faq-answer p {
 font-size: 0.95rem;
 color: var(--gray);
 line-height: 1.8;
}

/* ========================================
 FOOTER
======================================== */
.footer {
 background: var(--dark);
 color: var(--cream);
 padding-top: var(--space-xl);
}

.footer-brand .logo {
 color: var(--cream);
 margin-bottom: var(--space-sm);
 display: inline-block;
}
.footer-brand p {
 font-size: 0.9rem;
 color: var(--sage);
 line-height: 1.7;
 margin-bottom: var(--space-sm);
}
.footer-heading {
 font-family: var(--font-display);
 font-size: 1rem;
 color: var(--cream);
 margin-bottom: var(--space-sm);
 letter-spacing: 1px;
}
.footer-links li { margin-bottom: 0.6rem; }
.footer-links a {
 font-size: 0.9rem;
 color: var(--sage);
 transition: var(--transition);
}
.footer-links a:hover { color: var(--cream); padding-left: 4px; }
.footer-contact p {
 font-size: 0.9rem;
 color: var(--sage);
 margin-bottom: 0.5rem;
}

.footer-social a {
 width: 40px;
 height: 40px;
 display: flex;
 align-items: center;
 justify-content: center;
 background: rgba(156, 175, 136, 0.1);
 border-radius: 50%;
 transition: var(--transition);
}
.footer-social a:hover {
 background: var(--sage);
 transform: translateY(-3px);
}
