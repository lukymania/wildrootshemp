{% comment %}
  Featured Products Section
  - Product grid using Shopify collection
  - Shows product image, title, price, badge
  - "Shop All" link
{% endcomment %}

{%- style -%}
.featured-products {
  background-color: var(--cream, #F5F0E8);
  padding: 5rem 0;
}

.featured-products__header {
  text-align: center;
  margin-bottom: 3rem;
}

.featured-products__header h2 {
  margin-bottom: 0.75rem;
  color: var(--forest-deep, #0f241c);
}

.featured-products__header p {
  color: rgba(61, 43, 31, 0.7);
  font-size: 1.05rem;
  max-width: 500px;
  margin: 0 auto;
}

.featured-products__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 2rem;
}

.product-card {
  background-color: #fff;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(45, 74, 62, 0.08);
  transition: all 0.3s ease;
  border: 1px solid rgba(196, 168, 130, 0.2);
  display: flex;
  flex-direction: column;
  height: 100%;
  position: relative;
}

.product-card:hover {
  transform: translateY(-8px);
  box-shadow: 0 16px 48px rgba(45, 74, 62, 0.16);
}

.product-card__image-wrapper {
  position: relative;
  width: 100%;
  aspect-ratio: 4 / 3;
  overflow: hidden;
  background: linear-gradient(135deg, #F5F0E8 0%, #E8E0D4 100%);
}

.product-card__image-wrapper img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}

.product-card:hover .product-card__image-wrapper img {
  transform: scale(1.05);
}

.product-card__badge {
  position: absolute;
  top: 1rem;
  left: 1rem;
  color: #fff;
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1px;
  padding: 0.35rem 0.75rem;
  border-radius: 20px;
  z-index: 2;
}

.product-card__badge--rollon { background-color: #C17A5F; }
.product-card__badge--spray { background-color: #9CAF88; }
.product-card__badge--strength { background-color: #2D4A3E; }
.product-card__badge--evening { background-color: #7B6BA8; }
.product-card__badge--daily { background-color: #C8913A; }
.product-card__badge--pet { background-color: #A67C52; }

.product-card__info {
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  flex-grow: 1;
}

.product-card__title {
  font-family: var(--font-headline);
  font-weight: 700;
  font-size: 1.25rem;
  color: var(--forest-deep, #0f241c);
  margin-bottom: 0.5rem;
  text-decoration: none;
}

.product-card__title a {
  color: inherit;
  text-decoration: none;
}

.product-card__title a:hover {
  color: var(--terra-cotta, #C17A5F);
}

.product-card__description {
  font-size: 0.9rem;
  color: rgba(61, 43, 31, 0.75);
  line-height: 1.6;
  margin-bottom: 0.75rem;
}

.product-card__meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1rem;
}

.product-card__strength {
  font-family: var(--font-accent);
  font-style: italic;
  font-size: 1rem;
  color: var(--sage-mist, #9CAF88);
}

.product-card__price {
  font-family: var(--font-headline);
  font-weight: 900;
  font-size: 1.5rem;
  color: var(--raw-umber, #6B4226);
}

.product-card__btn {
  width: 100%;
  padding: 0.85rem;
  font-size: 0.8rem;
  margin-top: auto;
  display: inline-block;
  text-align: center;
}

.featured-products__footer {
  text-align: center;
  margin-top: 3rem;
}

@media (min-width: 640px) {
  .featured-products__grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1024px) {
  .featured-products__grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
  }

  .featured-products {
    padding: 6rem 0;
  }
}
{%- endstyle -%}

<section class="featured-products" id="products" aria-labelledby="featured-products-heading" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="featured-products__header reveal">
      <span class="section-label">{{ section.settings.label | default: 'Shop' }}</span>
      <h2 id="featured-products-heading">{{ section.settings.heading | default: 'The Wild Roots Collection' }}</h2>
      <p>{{ section.settings.description | default: 'Premium nano-enhanced hemp wellness, crafted for your entire family, including the four-legged members.' }}</p>
    </div>

    <div class="featured-products__grid">
      {%- assign collection = section.settings.collection -%}
      {%- if collection != blank -%}
        {%- for product in collection.products limit: section.settings.products_to_show -%}
          <article class="product-card reveal reveal-delay-{{ forloop.index | modulo: 3 | plus: 1 }}">
            <div class="product-card__image-wrapper">
              {%- if product.featured_image != blank -%}
                {{ product.featured_image | image_url: width: 600 | image_tag:
                  loading: 'lazy',
                  alt: product.title,
                  class: 'product-card__image'
                }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
              {%- endif -%}

              {%- assign tag_class = '' -%}
              {%- for tag in product.tags -%}
                {%- if tag contains 'badge:' -%}
                  {%- assign badge_text = tag | remove: 'badge:' | strip -%}
                  {%- assign badge_style = tag | remove: 'badge:' | strip | handleize -%}
                  <span class="product-card__badge product-card__badge--{{ badge_style }}">{{ badge_text }}</span>
                {%- endif -%}
              {%- endfor -%}

              {%- if product.compare_at_price > product.price and product.compare_at_price != blank -%}
                <span class="product-card__badge product-card__badge--sale">{{ 'products.product.sale' | t | default: 'Sale' }}</span>
              {%- endif -%}
            </div>

            <div class="product-card__info">
              <h3 class="product-card__title">
                <a href="{{ product.url }}">{{ product.title }}</a>
              </h3>

              {%- if section.settings.show_description -%}
                <p class="product-card__description">
                  {%- if product.metafields.custom.short_description != blank -%}
                    {{ product.metafields.custom.short_description }}
                  {%- else -%}
                    {{ product.description | strip_html | truncatewords: 15 }}
                  {%- endif -%}
                </p>
              {%- endif -%}

              <div class="product-card__meta">
                {%- if product.metafields.custom.strength != blank -%}
                  <span class="product-card__strength">{{ product.metafields.custom.strength }}</span>
                {%- endif -%}
                <span class="product-card__price">
                  {%- if product.price_varies -%}
                    {{ product.price_min | money }}+
                  {%- else -%}
                    {{ product.price | money }}
                  {%- endif -%}
                </span>
              </div>

              <a href="{{ product.url }}" class="btn btn-primary product-card__btn">
                {{ 'products.product.view_details' | t | default: 'Learn More' }}
              </a>
            </div>
          </article>
        {%- endfor -%}
      {%- else -%}
        {%- comment -%}Show placeholder products when no collection selected{%- endcomment -%}
        {%- for i in (1..6) -%}
          <article class="product-card reveal reveal-delay-{{ forloop.index | modulo: 3 | plus: 1 }}">
            <div class="product-card__image-wrapper">
              {{ 'product-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg placeholder' }}
            </div>
            <div class="product-card__info">
              <h3 class="product-card__title">
                <a href="#">{{ 'Product ' | append: forloop.index }}</a>
              </h3>
              <p class="product-card__description">Product description placeholder. Select a collection to display real products.</p>
              <div class="product-card__meta">
                <span class="product-card__strength">300MG</span>
                <span class="product-card__price">$65.00</span>
              </div>
              <a href="#" class="btn btn-primary product-card__btn">Learn More</a>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.show_shop_all -%}
      <div class="featured-products__footer reveal">
        <a href="{{ section.settings.shop_all_link | default: '/collections/shop' }}" class="btn btn-secondary">
          {{ section.settings.shop_all_text | default: 'Shop All Products' }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured Products",
  "tag": "section",
  "class": "featured-products-section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section label",
      "default": "Shop"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Wild Roots Collection"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Premium nano-enhanced hemp wellness, crafted for your entire family, including the four-legged members."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show product description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_shop_all",
      "label": "Show 'Shop All' button",
      "default": true
    },
    {
      "type": "text",
      "id": "shop_all_text",
      "label": "Shop All button text",
      "default": "Shop All Products"
    },
    {
      "type": "url",
      "id": "shop_all_link",
      "label": "Shop All button link"
    }
  ],
  "presets": [
    {
      "name": "Featured Products",
      "category": "Products"
    }
  ]
}
{% endschema %}
