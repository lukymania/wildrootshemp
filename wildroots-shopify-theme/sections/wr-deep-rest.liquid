<style>
    /* ============================================
       CSS VARIABLES & RESET
    ============================================ */
    :root {
  --header-height: 80px;
      --max-width: 1280px;
      --deep-forest: #1a3a2f;
      --forest: #1a3a2f;
      --terra-cotta: #c17c5b;
      --sage-mist: #8b9a7d;
      --raw-umber: #8a8278;
      --light-sage: #e5e8e0;
      --font-headline: 'Cormorant Garamond', Georgia, serif;
      --font-accent: 'Playfair Display', Georgia, serif;
      --forest-deep: #0f241c;
      --forest-light: #2d5a48;
      --sage: #a8b5a0;
      --cream: #f5f0e8;
      --linen: #faf8f3;
      --warm-white: #fdfcf9;
      --charcoal: #2c2c2c;
      --charcoal-light: #4a4a4a;
      --stone: #8a8278;
      --border: #e5e0d8;
      --border-light: #f0ece5;
      --lavender: #b8a9c9;
      --lavender-light: #e8e0f0;
      --lavender-deep: #8b7aa0;
      --evening-accent: #9b8db0;
      --gold: #c9a84c;
      --gold-light: #e0c97a;
      --glow: rgba(155, 141, 176, 0.08);
      --transition: 0.3s ease;
      --shadow: 0 1px 3px rgba(0,0,0,0.04);
      --shadow-md: 0 4px 20px rgba(0,0,0,0.06);
      --shadow-lg: 0 8px 40px rgba(0,0,0,0.08);
      --font-display: 'Cormorant Garamond', Georgia, serif;
      --font-serif: 'Playfair Display', Georgia, serif;
      --font-body: 'Inter', system-ui, sans-serif;
    }

    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
      font-family: var(--font-body);
      background: var(--warm-white);
      color: var(--charcoal);
      line-height: 1.6;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    img { max-width: 100%; display: block; }

    a { text-decoration: none; color: inherit; }

    ul { list-style: none; }

    /* ============================================
       HEADER
    ============================================ */
    .site-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: var(--header-height);
  background-color: var(--cream);
  z-index: 1000;
  border-bottom: 1px solid rgba(45, 74, 62, 0.12);
  transition: var(--transition);
}

.header-inner {
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 0 1.5rem;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.logo {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  text-decoration: none;
}

.logo-img {
  height: 68px;
  width: auto;
  display: block;
}

.nav-desktop {
  display: none;
}

.nav-list {
  display: flex;
  list-style: none;
  gap: 2.5rem;
}

.nav-list a {
  font-family: var(--font-body);
  font-weight: 400;
  font-size: 0.9rem;
  color: var(--dark-brown);
  text-transform: uppercase;
  letter-spacing: 1px;
  position: relative;
  padding-bottom: 4px;
}

.nav-list a::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 0;
  height: 2px;
  background-color: var(--terra-cotta);
  transition: width 0.3s ease;
}

.nav-list a:hover::after {
  width: 100%;
}

.nav-list a:hover {
  color: var(--terra-cotta);
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 1.5rem;
}

.cart-btn {
  position: relative;
  background: none;
  border: none;
  cursor: pointer;
  padding: 0.5rem;
}

.cart-btn svg {
  width: 24px;
  height: 24px;
  stroke: var(--deep-forest);
  transition: stroke 0.3s ease;
}

.cart-btn:hover svg {
  stroke: var(--terra-cotta);
}

.cart-count {
  position: absolute;
  top: -2px;
  right: -6px;
  background-color: var(--terra-cotta);
  color: #fff;
  font-size: 0.65rem;
  font-weight: 700;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Mobile Menu Toggle */
.menu-toggle {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  width: 28px;
  height: 20px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 0;
  z-index: 1001;
  touch-action: manipulation;
  -webkit-tap-highlight-color: transparent;
}

.menu-toggle span {
  display: block;
  width: 100%;
  height: 2px;
  background-color: var(--deep-forest);
  transition: var(--transition);
  transform-origin: center;
}

.menu-toggle.active span:nth-child(1) {
  transform: translateY(9px) rotate(45deg);
}

.menu-toggle.active span:nth-child(2) {
  opacity: 0;
}

.menu-toggle.active span:nth-child(3) {
  transform: translateY(-9px) rotate(-45deg);
}

/* Mobile Navigation */
.mobile-nav {
  position: fixed;
  top: var(--header-height);
  left: 0;
  right: 0;
  bottom: 0;
  background-color: var(--cream);
  z-index: 999;
  padding: 2rem;
  transform: translate3d(100%, 0, 0);
  transition: transform 0.4s ease;
  overflow-y: auto;
}

.mobile-nav.active {
  -moz-transform: translate3d(0, 0, 0);
  transform: translate3d(0, 0, 0);
}

.mobile-nav-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.mobile-nav-list a {
  font-family: var(--font-headline);
  font-weight: 700;
  font-size: 1.5rem;
  color: var(--deep-forest);
  display: block;
  padding: 0.5rem 0;
  border-bottom: 1px solid var(--light-sage);
}

.mobile-nav-list a:hover {
  color: var(--terra-cotta);
}

/* ============================================
       HERO SECTION
    ============================================ */
    .product-hero {
      padding-top: 64px;
      min-height: 100vh;
      background: var(--warm-white);
      position: relative;
      overflow: hidden;
    }

    .hero-bg-pattern {
      position: absolute;
      inset: 0;
      background-image:
        radial-gradient(circle at 20% 80%, var(--lavender-light) 0%, transparent 50%),
        radial-gradient(circle at 80% 20%, var(--glow) 0%, transparent 40%);
      pointer-events: none;
    }

    .hero-inner {
      max-width: 1280px;
      margin: 0 auto;
      padding: 80px 40px 60px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 80px;
      align-items: center;
      min-height: calc(100vh - 64px);
    }

    /* Hero Left: Product Image */
    .hero-image-col {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .hero-image-wrapper {
      position: relative;
      width: 100%;
      max-width: 480px;
    }

    .hero-product-img {
      width: 100%;
      height: 400px;
      object-fit: contain;
      border-radius: 20px;
      box-shadow: var(--shadow-lg);
      transition: transform 0.5s ease;
    }

    .hero-image-wrapper:hover .hero-product-img { transform: scale(1.02); }

    .hero-image-badge {
      position: absolute;
      top: 20px; left: -12px;
      background: var(--evening-accent);
      color: white;
      padding: 8px 18px;
      border-radius: 0 8px 8px 0;
      font-family: var(--font-body);
      font-size: 0.6875rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      box-shadow: 0 4px 12px rgba(155, 141, 176, 0.3);
    }

    /* Hero Right: Details */
    .hero-details {
      padding-left: 20px;
    }

    .hero-breadcrumb {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 24px;
      font-size: 0.75rem;
      color: var(--stone);
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .hero-breadcrumb a { color: var(--stone); transition: var(--transition); }
    .hero-breadcrumb a:hover { color: var(--forest); }

    .hero-breadcrumb .sep { opacity: 0.4; }

    .hero-product-name {
      font-family: var(--font-display);
      font-size: 3.25rem;
      font-weight: 600;
      color: var(--forest);
      line-height: 1.1;
      letter-spacing: -0.02em;
      margin-bottom: 8px;
    }

    .hero-product-subtitle {
      font-family: var(--font-serif);
      font-size: 1.25rem;
      font-style: italic;
      color: var(--evening-accent);
      margin-bottom: 24px;
    }

    .hero-rating {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 28px;
    }

    .hero-stars {
      display: flex;
      gap: 2px;
    }

    .hero-stars svg { width: 16px; height: 16px; fill: var(--gold); }

    .hero-rating-text {
      font-size: 0.8125rem;
      color: var(--stone);
    }

    .hero-rating-text strong { color: var(--charcoal); font-weight: 500; }

    .hero-price {
      font-family: var(--font-display);
      font-size: 2.5rem;
      font-weight: 600;
      color: var(--forest);
      margin-bottom: 6px;
    }

    .hero-price-note {
      font-size: 0.8125rem;
      color: var(--stone);
      margin-bottom: 32px;
    }

    /* Specs */
    .hero-specs {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      margin-bottom: 32px;
    }

    .spec-item {
      background: var(--linen);
      border: 1px solid var(--border-light);
      border-radius: 12px;
      padding: 16px;
      text-align: center;
    }

    .spec-icon {
      width: 28px; height: 28px;
      margin: 0 auto 8px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .spec-icon svg { width: 100%; height: 100%; stroke: var(--evening-accent); stroke-width: 1.5; fill: none; }

    .spec-label {
      font-size: 0.6875rem;
      font-weight: 600;
      color: var(--charcoal-light);
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    .spec-value {
      font-family: var(--font-body);
      font-size: 0.8125rem;
      color: var(--stone);
      margin-top: 2px;
    }

    /* Quantity & Add to Cart */
    .hero-actions {
      display: flex;
      gap: 12px;
      margin-bottom: 20px;
    }

    .qty-selector {
      display: flex;
      align-items: center;
      border: 1px solid var(--border);
      border-radius: 10px;
      overflow: hidden;
      background: white;
    }

    .qty-btn {
      width: 44px;
      height: 52px;
      background: none;
      border: none;
      font-size: 1.125rem;
      color: var(--charcoal);
      cursor: pointer;
      transition: var(--transition);
    }

    .qty-btn:hover { background: var(--cream); }

    .qty-input {
      width: 50px;
      height: 52px;
      border: none;
      text-align: center;
      font-family: var(--font-body);
      font-size: 0.9375rem;
      font-weight: 500;
      color: var(--charcoal);
      -moz-appearance: textfield;
    }

    .qty-input::-webkit-inner-spin-button,
    .qty-input::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }

    .btn-primary {
      flex: 1;
      height: 52px;
      background: var(--forest);
      color: white;
      border: none;
      border-radius: 10px;
      font-family: var(--font-body);
      font-size: 0.9375rem;
      font-weight: 500;
      letter-spacing: 0.02em;
      cursor: pointer;
      transition: var(--transition);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    .btn-primary:hover {
      background: var(--forest-light);
      transform: translateY(-1px);
      box-shadow: 0 6px 24px rgba(26, 58, 47, 0.25);
    }

    .hero-disclaimer {
      font-size: 0.6875rem;
      color: var(--stone);
      line-height: 1.5;
    }

    .hero-disclaimer a { color: var(--evening-accent); text-decoration: underline; }

    /* ============================================
       SECTION: HOW IT WORKS
    ============================================ */
    .how-it-works {
      padding: 100px 0;
      background: var(--cream);
      position: relative;
    }

    .section-inner {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 40px;
    }

    .section-header {
      text-align: center;
      margin-bottom: 60px;
    }

    .section-eyebrow {
      font-family: var(--font-body);
      font-size: 0.6875rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: var(--evening-accent);
      margin-bottom: 12px;
    }

    .section-title {
      font-family: var(--font-display);
      font-size: 2.75rem;
      font-weight: 600;
      color: var(--forest);
      line-height: 1.15;
      letter-spacing: -0.01em;
      margin-bottom: 16px;
    }

    .section-desc {
      font-size: 1.0625rem;
      color: var(--stone);
      max-width: 560px;
      margin: 0 auto;
      line-height: 1.7;
    }

    .how-steps {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 40px;
      max-width: 1100px;
      margin: 0 auto;
    }

    .how-step {
      text-align: center;
      padding: 40px 32px;
      background: var(--warm-white);
      border-radius: 16px;
      border: 1px solid var(--border-light);
      transition: var(--transition);
    }

    .how-step:hover {
      box-shadow: var(--shadow-md);
      transform: translateY(-4px);
    }

    .how-step-icon {
      width: 64px;
      height: 64px;
      margin: 0 auto 24px;
      background: var(--lavender-light);
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .how-step-icon svg {
      width: 28px;
      height: 28px;
      stroke: var(--evening-accent);
      stroke-width: 1.5;
      fill: none;
    }

    .how-step-title {
      font-family: var(--font-display);
      font-size: 1.375rem;
      font-weight: 600;
      color: var(--forest);
      margin-bottom: 12px;
    }

    .how-step-text {
      font-size: 0.9375rem;
      color: var(--stone);
      line-height: 1.65;
    }

    /* Connection arrows between steps */
    .how-steps { position: relative; }

    .step-connector {
      position: absolute;
      top: 72px;
      left: 33.33%;
      width: 33.33%;
      height: 2px;
      background: linear-gradient(90deg, var(--lavender-light), var(--evening-accent), var(--lavender-light));
      opacity: 0.3;
      z-index: 0;
    }
    .how-step { position: relative; z-index: 1; }

    /* ============================================
       SECTION: KEY FEATURES
    ============================================ */
    .key-features {
      padding: 100px 0;
      background: var(--warm-white);
    }

    .features-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
    }

    .feature-card {
      padding: 36px 28px;
      background: var(--linen);
      border: 1px solid var(--border-light);
      border-radius: 16px;
      text-align: center;
      transition: var(--transition);
    }

    .feature-card:hover {
      background: var(--warm-white);
      box-shadow: var(--shadow-md);
      transform: translateY(-3px);
    }

    .feature-icon {
      width: 56px;
      height: 56px;
      margin: 0 auto 20px;
      background: var(--lavender-light);
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .feature-icon svg {
      width: 26px;
      height: 26px;
      stroke: var(--evening-accent);
      stroke-width: 1.5;
      fill: none;
    }

    .feature-title {
      font-family: var(--font-display);
      font-size: 1.3rem;
      font-weight: 600;
      color: var(--forest);
      margin-bottom: 10px;
    }

    .feature-desc {
      font-size: 0.95rem;
      color: var(--stone);
      line-height: 1.6;
    }

    /* ============================================
       SECTION: INGREDIENTS
    ============================================ */
    .ingredients {
      padding: 100px 0;
      background: var(--cream);
    }

    .ingredients-layout {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 60px;
      align-items: center;
    }

    .ingredients-image-col {
      position: relative;
    }

    .ingredients-img {
      width: 100%;
      border-radius: 20px;
      box-shadow: var(--shadow-lg);
    }

    .ingredients-content h2 {
      font-family: var(--font-display);
      font-size: 2.5rem;
      font-weight: 600;
      color: var(--forest);
      margin-bottom: 16px;
      line-height: 1.15;
    }

    .ingredients-content .lead {
      font-family: var(--font-serif);
      font-style: italic;
      font-size: 1.125rem;
      color: var(--evening-accent);
      margin-bottom: 24px;
    }

    .ingredients-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-bottom: 28px;
    }

    .ingredient-item {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 14px 18px;
      background: var(--warm-white);
      border-radius: 10px;
      border: 1px solid var(--border-light);
    }

    .ingredient-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: var(--evening-accent);
      flex-shrink: 0;
    }

    .ingredient-dot.highlight {
      background: var(--evening-accent);
      box-shadow: 0 0 0 4px var(--lavender-light);
    }

    .ingredient-name {
      font-size: 0.9375rem;
      font-weight: 500;
      color: var(--charcoal);
    }

    .ingredient-note {
      font-size: 0.8125rem;
      color: var(--stone);
    }

    .cbn-highlight {
      background: linear-gradient(135deg, var(--lavender-light), rgba(155, 141, 176, 0.12));
      border: 1px solid var(--lavender);
      border-radius: 14px;
      padding: 24px;
      margin-top: 8px;
    }

    .cbn-highlight-icon {
      width: 36px;
      height: 36px;
      background: var(--evening-accent);
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 12px;
    }

    .cbn-highlight-icon svg {
      width: 18px;
      height: 18px;
      stroke: white;
      stroke-width: 2;
      fill: none;
    }

    .cbn-highlight-title {
      font-family: var(--font-display);
      font-size: 1.25rem;
      font-weight: 600;
      color: var(--forest);
      margin-bottom: 8px;
    }

    .cbn-highlight-text {
      font-size: 0.9375rem;
      color: var(--charcoal-light);
      line-height: 1.6;
    }

    /* ============================================
       SECTION: HOW TO USE
    ============================================ */
    .how-to-use {
      padding: 100px 0;
      background: var(--warm-white);
    }

    .usage-with-image {
      display: flex;
      flex-wrap: wrap;
      gap: 2rem;
      align-items: stretch;
      max-width: 1200px;
      margin: 48px auto 0;
    }

    .usage-image {
      flex: 0 0 380px;
      max-width: 380px;
      margin: 0 auto;
      display: flex;
    }

    .usage-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 16px;
      box-shadow: 0 12px 40px rgba(0,0,0,0.12);
      display: block;
    }

    .usage-steps-col {
      flex: 1;
      min-width: 280px;
      display: flex;
      flex-direction: column;
      gap: 1rem;
      justify-content: space-between;
    }

    .usage-steps-col .step-row {
      display: flex;
      align-items: center;
      gap: 1.25rem;
      padding: 20px 24px;
      background: var(--linen);
      border-radius: 12px;
      border: 1px solid var(--border-light);
      text-align: left;
      flex: 1 1 0;
      min-height: 0;
    }

    .usage-steps-col .step-row .use-step-num {
      margin: 0;
      flex-shrink: 0;
      position: static;
      transform: none;
      width: 44px;
      height: 44px;
      font-size: 1.05rem;
    }

    .usage-steps-col .step-row .step-text h4 {
      font-size: 1rem;
      font-weight: 600;
      color: var(--deep-forest);
      margin: 0 0 4px 0;
    }

    .usage-steps-col .step-row .step-text p {
      font-size: 0.875rem;
      color: rgba(61, 43, 31, 0.75);
      margin: 0;
      line-height: 1.5;
    }

    .use-step:hover {
      box-shadow: var(--shadow-md);
      transform: translateY(-3px);
    }

    .use-step-num {
      position: absolute;
      top: -16px;
      left: 50%;
      transform: translateX(-50%);
      width: 36px;
      height: 36px;
      background: var(--evening-accent);
      color: white;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-display);
      font-size: 0.9375rem;
      font-weight: 600;
      box-shadow: 0 2px 8px rgba(155, 141, 176, 0.3);
    }

    .use-step-icon {
      width: 52px;
      height: 52px;
      margin: 8px auto 16px;
      background: var(--lavender-light);
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .use-step-icon svg {
      width: 24px;
      height: 24px;
      stroke: var(--evening-accent);
      stroke-width: 1.5;
      fill: none;
    }

    .use-step-title {
      font-family: var(--font-display);
      font-size: 1.125rem;
      font-weight: 600;
      color: var(--forest);
      margin-bottom: 8px;
    }

    .use-step-desc {
      font-size: 0.8125rem;
      color: var(--stone);
      line-height: 1.55;
    }

    /* ============================================
       SECTION: NANO-HEMP DIFFERENCE
    ============================================ */
    .nano-difference {
      padding: 100px 0;
      background: linear-gradient(180deg, var(--forest-deep) 0%, var(--forest) 100%);
      position: relative;
      overflow: hidden;
    }

    .nano-difference::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image: radial-gradient(circle at 30% 50%, rgba(155, 141, 176, 0.08) 0%, transparent 50%);
      pointer-events: none;
    }

    .nano-inner {
      position: relative;
      z-index: 1;
    }

    .nano-difference .section-eyebrow { color: var(--lavender); }
    .nano-difference .section-title { color: var(--cream); }
    .nano-difference .section-desc { color: rgba(245, 240, 232, 0.7); }

    .nano-content {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 60px;
      align-items: center;
      margin-top: 48px;
    }

    .nano-visual {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    .nano-comparison {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    .nano-card {
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 16px;
      padding: 28px;
      text-align: center;
    }

    .nano-card.active {
      border-color: var(--evening-accent);
      background: rgba(155, 141, 176, 0.1);
    }

    .nano-card-label {
      font-size: 0.6875rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: rgba(245, 240, 232, 0.6);
      margin-bottom: 12px;
    }

    .nano-card.active .nano-card-label { color: var(--lavender); }

    .nano-card-time {
      font-family: var(--font-display);
      font-size: 2.5rem;
      font-weight: 600;
      color: var(--cream);
      margin-bottom: 8px;
    }

    .nano-card-desc {
      font-size: 0.8125rem;
      color: rgba(245, 240, 232, 0.5);
    }

    .nano-card.active .nano-card-desc { color: rgba(245, 240, 232, 0.7); }

    .nano-text h3 {
      font-family: var(--font-display);
      font-size: 1.75rem;
      font-weight: 600;
      color: var(--cream);
      margin-bottom: 16px;
    }

    .nano-text p {
      font-size: 1rem;
      color: rgba(245, 240, 232, 0.7);
      line-height: 1.7;
      margin-bottom: 20px;
    }

    .nano-text ul {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .nano-text ul li {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      font-size: 0.9375rem;
      color: rgba(245, 240, 232, 0.75);
    }

    .nano-text ul li svg {
      width: 18px;
      height: 18px;
      stroke: var(--lavender);
      stroke-width: 2;
      flex-shrink: 0;
      margin-top: 2px;
    }

    /* ============================================
       SECTION: PRODUCT FAQ
    ============================================ */
    .product-faq {
      padding: 100px 0;
      background: var(--warm-white);
    }

    .faq-list {
      max-width: 720px;
      margin: 48px auto 0;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .faq-item {
      background: var(--linen);
      border: 1px solid var(--border-light);
      border-radius: 12px;
      overflow: hidden;
    }

    .faq-question {
      width: 100%;
      padding: 20px 24px;
      background: none;
      border: none;
      display: flex;
      align-items: center;
      justify-content: space-between;
      cursor: pointer;
      font-family: var(--font-body);
      font-size: 1rem;
      font-weight: 500;
      color: var(--forest);
      text-align: left;
      transition: var(--transition);
    }

    .faq-question:hover { color: var(--evening-accent); }

    .faq-question svg {
      width: 18px;
      height: 18px;
      stroke: var(--evening-accent);
      stroke-width: 2;
      flex-shrink: 0;
      transition: transform var(--transition);
    }

    .faq-item.open .faq-question svg { transform: rotate(45deg); }

    .faq-answer {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.35s ease, padding 0.35s ease;
    }

    .faq-item.open .faq-answer {
      max-height: 300px;
      padding: 0 24px 20px;
    }

    .faq-answer p {
      font-size: 0.9375rem;
      color: var(--charcoal-light);
      line-height: 1.65;
    }

    /* ============================================
       FOOTER
    ============================================ */
    .site-footer {
      background: var(--forest-deep);
      color: rgba(245, 240, 232, 0.7);
      padding: 72px 0 32px;
    }

    .footer-inner {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 40px;
    }

    .footer-top {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: 48px;
      padding-bottom: 48px;
      border-bottom: 1px solid rgba(255,255,255,0.08);
    }

        .footer-brand-logo {
      height: 70px;
      width: auto;
      margin-bottom: 16px;
      display: block;
    }

    .footer-brand-desc {
      font-size: 0.875rem;
      line-height: 1.6;
      margin-bottom: 20px;
    }

    .footer-socials { display: flex; gap: 12px; }

    .footer-socials a {
      width: 36px;
      height: 36px;
      border: 1px solid rgba(255,255,255,0.15);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: var(--transition);
    }

    .footer-socials a:hover { background: rgba(255,255,255,0.1); border-color: var(--lavender); }

    .footer-socials a svg { width: 16px; height: 16px; stroke: var(--cream); stroke-width: 1.5; fill: none; }

    .footer-col h4 {
      font-family: var(--font-body);
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--cream);
      margin-bottom: 20px;
    }

    .footer-col ul { display: flex; flex-direction: column; gap: 12px; }

    .footer-col ul li a {
      font-size: 0.875rem;
      color: rgba(245, 240, 232, 0.6);
      transition: var(--transition);
    }

    .footer-col ul li a:hover { color: var(--lavender); }

    .footer-bottom {
      padding-top: 28px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 16px;
    }

    .footer-disclaimer {
      font-size: 0.6875rem;
      color: rgba(245, 240, 232, 0.35);
      max-width: 600px;
      line-height: 1.5;
    }

    .footer-copyright {
      font-size: 0.75rem;
      color: rgba(245, 240, 232, 0.4);
    }

    /* ============================================
       STICKY ADD TO CART BAR
    ============================================ */
    .sticky-bar {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: rgba(253, 252, 249, 0.95);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-top: 1px solid var(--border-light);
      padding: 12px 0;
      z-index: 900;
      transform: translateY(100%);
      transition: transform 0.4s ease;
    }

    .sticky-bar.visible { transform: translateY(0); }

    .sticky-inner {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 40px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .sticky-product {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .sticky-product img {
      width: 44px;
      height: 44px;
      border-radius: 8px;
      object-fit: cover;
      background: var(--linen);
    }

    .sticky-product-info h4 {
      font-family: var(--font-display);
      font-size: 1rem;
      font-weight: 600;
      color: var(--forest);
    }

    .sticky-product-info span {
      font-size: 0.75rem;
      color: var(--stone);
    }

    .sticky-actions { display: flex; align-items: center; gap: 16px; }

    .sticky-price {
      font-family: var(--font-display);
      font-size: 1.375rem;
      font-weight: 600;
      color: var(--forest);
    }

    .sticky-btn {
      padding: 12px 32px;
      background: var(--forest);
      color: white;
      border: none;
      border-radius: 8px;
      font-family: var(--font-body);
      font-size: 0.875rem;
      font-weight: 500;
      cursor: pointer;
      transition: var(--transition);
    }

    .sticky-btn:hover { background: var(--forest-light); }

    /* ============================================
       CART DRAWER
    ============================================ */
    .cart-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.3);
      z-index: 1100;
      opacity: 0;
      visibility: hidden;
      transition: var(--transition);
    }

    .cart-overlay.open { opacity: 1; visibility: visible; }

    .cart-drawer {
      position: fixed;
      top: 0;
      right: 0;
      width: 420px;
      max-width: 100vw;
      height: 100vh;
      background: var(--warm-white);
      z-index: 1101;
      transform: translate3d(100%, 0, 0);
      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      display: flex;
      flex-direction: column;
    }

    .cart-drawer.open { transform: translate3d(0, 0, 0); }

    .cart-header {
      padding: 24px;
      border-bottom: 1px solid var(--border-light);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .cart-header h3 {
      font-family: var(--font-display);
      font-size: 1.375rem;
      font-weight: 600;
      color: var(--forest);
    }

    .cart-close {
      background: none;
      border: none;
      cursor: pointer;
      padding: 8px;
    }

    .cart-close svg { width: 20px; height: 20px; stroke: var(--charcoal); stroke-width: 2; }

    .cart-items { flex: 1; overflow-y: auto; padding: 24px; }

    .cart-empty {
      text-align: center;
      padding: 60px 24px;
      color: var(--stone);
    }

    .cart-empty svg { width: 56px; height: 56px; stroke: var(--border); stroke-width: 1; margin: 0 auto 16px; }

    .cart-empty p { font-size: 1rem; }

    .cart-footer {
      padding: 24px;
      border-top: 1px solid var(--border-light);
      background: var(--linen);
    }

    .cart-subtotal {
      display: flex;
      justify-content: space-between;
      margin-bottom: 16px;
      font-size: 1rem;
    }

    .cart-subtotal span:last-child {
      font-family: var(--font-display);
      font-size: 1.25rem;
      font-weight: 600;
      color: var(--forest);
    }

    .cart-note {
      font-size: 0.6875rem;
      color: var(--stone);
      margin-bottom: 16px;
    }

    .cart-checkout-btn {
      width: 100%;
      padding: 14px;
      background: var(--forest);
      color: white;
      border: none;
      border-radius: 10px;
      font-family: var(--font-body);
      font-size: 0.9375rem;
      font-weight: 500;
      cursor: pointer;
      transition: var(--transition);
    }

    .cart-checkout-btn:hover { background: var(--forest-light); }

    /* Cart Item */
    .cart-item {
      display: flex;
      gap: 16px;
      padding: 16px 0;
      border-bottom: 1px solid var(--border-light);
    }

    .cart-item-img {
      width: 64px;
      height: 64px;
      border-radius: 10px;
      object-fit: cover;
      background: var(--linen);
      border: 1px solid var(--border-light);
    }

    .cart-item-details { flex: 1; }

    .cart-item-name {
      font-family: var(--font-display);
      font-size: 1rem;
      font-weight: 600;
      color: var(--forest);
      margin-bottom: 2px;
    }

    .cart-item-variant {
      font-size: 0.75rem;
      color: var(--stone);
      margin-bottom: 8px;
    }

    .cart-item-qty-price {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .cart-item-qty {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .cart-item-qty button {
      width: 28px;
      height: 28px;
      border: 1px solid var(--border);
      border-radius: 6px;
      background: white;
      cursor: pointer;
      font-size: 0.875rem;
      color: var(--charcoal);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .cart-item-qty span {
      font-size: 0.8125rem;
      font-weight: 500;
      min-width: 20px;
      text-align: center;
    }

    .cart-item-price {
      font-family: var(--font-display);
      font-size: 1rem;
      font-weight: 600;
      color: var(--forest);
    }

    .cart-item-remove {
      background: none;
      border: none;
      cursor: pointer;
      padding: 4px;
      align-self: flex-start;
    }

    .cart-item-remove svg { width: 14px; height: 14px; stroke: var(--stone); stroke-width: 1.5; }

    /* ============================================
       TOAST NOTIFICATION
    ============================================ */
    .toast {
      position: fixed;
      bottom: 88px;
      left: 50%;
      transform: translateX(-50%) translateY(20px);
      background: var(--forest);
      color: white;
      padding: 14px 28px;
      border-radius: 10px;
      font-size: 0.875rem;
      font-weight: 500;
      z-index: 1200;
      opacity: 0;
      transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: 0 8px 32px rgba(26, 58, 47, 0.3);
      white-space: nowrap;
    }

    .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

    /* ============================================
       RESPONSIVE
    ============================================ */
    @media (max-width: 1024px) {
      .hero-inner { gap: 40px; }
      .hero-product-name { font-size: 2.75rem; }
      .features-grid { grid-template-columns: repeat(2, 1fr); }
      .footer-top { grid-template-columns: 1fr 1fr; }
    }

    @media (max-width: 768px) {
      .header-nav { display: none; }
      .mobile-menu-btn { display: block; }
      .header-inner { padding: 0 20px; }

      .hero-inner {
        grid-template-columns: 1fr;
        padding: 40px 20px 60px;
        text-align: center;
      }
      .hero-image-col { order: -1; }
      .hero-image-wrapper { max-width: 320px; }
      .hero-details { padding-left: 0; }
      .hero-product-name { font-size: 2.5rem; }
      .hero-specs { max-width: 400px; margin: 0 auto 32px; }
      .hero-actions { max-width: 400px; margin: 0 auto 20px; }
      .hero-rating { justify-content: center; }

      .how-steps { grid-template-columns: 1fr; }
      .step-connector { display: none; }

      .features-grid { grid-template-columns: 1fr 1fr; gap: 16px; }

      .ingredients-layout { grid-template-columns: 1fr; }
      .ingredients-image-col { order: -1; }

      .use-steps { grid-template-columns: 1fr 1fr; }

      .nano-content { grid-template-columns: 1fr; }

      .footer-top { grid-template-columns: 1fr; gap: 36px; }
      .footer-bottom { flex-direction: column; text-align: center; }

      .section-inner { padding: 0 20px; }
      .section-title { font-size: 2.25rem; }

      .sticky-inner { padding: 0 20px; }
      .sticky-product { display: none; }
      .sticky-actions { width: 100%; justify-content: space-between; }
    }

    @media (max-width: 480px) {
      .hero-product-name { font-size: 2rem; }
      .hero-price { font-size: 2rem; }
      .section-title { font-size: 1.875rem; }
      .use-steps { grid-template-columns: 1fr; }
      .features-grid { grid-template-columns: 1fr; }
      .hero-specs { grid-template-columns: 1fr; }
      .nano-comparison { grid-template-columns: 1fr; }
    }

    /* Animations */
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(24px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .animate-in {
      opacity: 0;
      animation: fadeInUp 0.7s ease forwards;
    }

    .delay-1 { animation-delay: 0.1s; }
    .delay-2 { animation-delay: 0.2s; }
    .delay-3 { animation-delay: 0.3s; }
    .delay-4 { animation-delay: 0.4s; }

@media (min-width: 768px) {
  .nav-desktop {
    display: block;
  }

  .menu-toggle {
    display: none;
  }

  .product-hero-inner {
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
  }

  .product-hero {
    padding: 5rem 0;
  }

  .features-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .steps-grid {
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .footer-grid {
    grid-template-columns: 2fr 1fr 1fr 1.5fr;
  }

  .how-it-works-grid {
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
  }

  .nano-difference-inner {
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
  }

  .ingredients-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

/* ============================================
   UNIFIED PRODUCT CHECKOUT
   ============================================ */
.product-checkout { margin-top: var(--header-height); background: linear-gradient(135deg, var(--cream) 0%, rgba(156,175,136,0.15) 100%); padding: 4rem 0; min-height: calc(100vh - var(--header-height)); display: flex; align-items: center; }
.checkout-inner { max-width: var(--max-width); margin: 0 auto; padding: 0 1.5rem; display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; }
.checkout-image-wrap { position: relative; display: flex; flex-direction: column; justify-content: center; align-items: center; }
.checkout-image-main { max-width: 400px; width: 100%; filter: drop-shadow(0 20px 40px rgba(45,74,62,0.2)); transition: transform 0.5s ease; }
.checkout-image-main:hover { transform: scale(1.03); }
.checkout-content { display: flex; flex-direction: column; gap: 1rem; }
.checkout-category { display: inline-flex; align-items: center; gap: 8px; }
.checkout-category svg { width: 16px; height: 16px; flex-shrink: 0; }
.checkout-category { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-accent); font-style: italic; font-size: 1rem; color: var(--terra-cotta); }
.checkout-title { font-family: var(--font-headline); font-weight: 900; font-size: clamp(2rem,4vw,3rem); color: var(--deep-forest); line-height: 1.1; margin: 0; }
.checkout-subtitle { font-family: var(--font-body); font-weight: 300; font-size: 1.15rem; color: var(--sage-mist); margin-top: -0.25rem; }
    .nano-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: linear-gradient(135deg, rgba(156,175,136,0.15) 0%, rgba(45,74,62,0.08) 100%);
      border: 1.5px solid rgba(156,175,136,0.4);
      border-radius: 100px;
      padding: 5px 14px;
      font-family: var(--font-body);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--deep-forest);
      margin-bottom: 14px;
    }
    .nano-badge svg {
      width: 14px;
      height: 14px;
      flex-shrink: 0;
    }

.checkout-rating { display: flex; align-items: center; gap: 10px; }
.checkout-stars { display: flex; gap: 2px; }
.checkout-stars svg { width: 18px; height: 18px; fill: #D4A843; }
.checkout-rating-text { font-size: 0.85rem; color: var(--raw-umber); }
.checkout-rating-text strong { color: var(--deep-forest); }
.checkout-price-wrap { display: flex; align-items: baseline; gap: 16px; margin: 0.5rem 0; }
.checkout-price { font-family: var(--font-headline); font-size: 2.5rem; font-weight: 700; color: var(--deep-forest); letter-spacing: -0.02em; }
.checkout-price-note { font-size: 0.85rem; color: var(--raw-umber); }
.checkout-specs { display: flex; gap: 24px; margin: 0.5rem 0; }
.checkout-spec { display: flex; flex-direction: column; align-items: flex-start; gap: 4px; }
.checkout-spec-value { font-family: var(--font-headline); font-size: 1.3rem; font-weight: 700; color: var(--deep-forest); }
.checkout-spec-label { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--raw-umber); }
.checkout-spec-divider { width: 1px; background: var(--light-sage); align-self: stretch; min-height: 40px; }
.checkout-actions { display: flex; align-items: center; gap: 16px; margin: 0.75rem 0; flex-wrap: wrap; }
.quantity-selector { display: flex; align-items: center; border: 1px solid var(--light-sage); border-radius: 8px; overflow: hidden; background: #fff; }
.qty-btn { width: 44px; height: 48px; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; font-weight: 500; color: var(--raw-umber); transition: all 0.2s; background: transparent; border: none; cursor: pointer; }
.qty-btn:hover { background: var(--cream); color: var(--deep-forest); }
.qty-value { width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.95rem; border-left: 1px solid var(--light-sage); border-right: 1px solid var(--light-sage); }
.btn-add-cart { flex: 1; height: 52px; min-width: 200px; background: linear-gradient(135deg, var(--sage-mist) 0%, #7A8F6A 100%); color: #fff; font-family: var(--font-body); font-size: 0.9rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; border-radius: 8px; display: flex; align-items: center; justify-content: center; gap: 10px; transition: all 0.3s ease; box-shadow: 0 4px 16px rgba(122,143,106,0.3); border: none; cursor: pointer; }
.btn-add-cart:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(122,143,106,0.4); }
.btn-add-cart svg { width: 18px; height: 18px; flex-shrink: 0; }
.checkout-guarantee { display: flex; align-items: center; gap: 10px; font-size: 0.8rem; color: var(--raw-umber); }
