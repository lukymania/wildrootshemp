{% comment %}
  Testimonials Section
  - Customer reviews slider/cards
  - Uses section blocks for each testimonial
{% endcomment %}

{%- style -%}
.testimonials {
  background: linear-gradient(180deg, var(--cream, #F5F0E8) 0%, #ede8df 100%);
  padding: 5rem 0;
}

.testimonials__header {
  text-align: center;
  margin-bottom: 3rem;
}

.testimonials__header h2 {
  color: var(--forest-deep, #0f241c);
}

.testimonials__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 2rem;
}

.testimonial-card {
  background-color: #fff;
  border-radius: 12px;
  padding: 2rem;
  box-shadow: 0 2px 8px rgba(45, 74, 62, 0.08);
  border: 1px solid rgba(196, 168, 130, 0.15);
  transition: all 0.3s ease;
  position: relative;
}

.testimonial-card::before {
  content: '"';
  font-family: var(--font-headline);
  font-weight: 900;
  font-size: 5rem;
  color: var(--light-sage, #C5D4B8);
  position: absolute;
  top: -0.5rem;
  left: 1rem;
  line-height: 1;
  opacity: 0.5;
}

.testimonial-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 24px rgba(45, 74, 62, 0.12);
}

.testimonial-card__stars {
  display: flex;
  gap: 0.25rem;
  margin-bottom: 1rem;
  position: relative;
  z-index: 1;
}

.testimonial-card__stars svg {
  width: 18px;
  height: 18px;
  fill: var(--kraft-brown, #C4A882);
  stroke: none;
}

.testimonial-card__quote {
  font-family: var(--font-accent);
  font-style: italic;
  font-size: 1.15rem;
  color: var(--dark-brown, #3D2B1F);
  line-height: 1.7;
  margin-bottom: 1.25rem;
  position: relative;
  z-index: 1;
}

.testimonial-card__author {
  font-family: var(--font-body);
  font-weight: 700;
  font-size: 0.9rem;
  color: var(--forest-deep, #0f241c);
  text-transform: uppercase;
  letter-spacing: 1px;
}

.testimonial-card__location {
  font-size: 0.8rem;
  color: rgba(61, 43, 31, 0.5);
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0;
}

@media (min-width: 640px) {
  .testimonials__grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .testimonial-card:last-child:nth-child(odd) {
    grid-column: span 2;
    max-width: 50%;
    margin: 0 auto;
  }
}

@media (min-width: 1024px) {
  .testimonials {
    padding: 6rem 0;
  }

  .testimonials__grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .testimonial-card:last-child:nth-child(odd) {
    grid-column: auto;
    max-width: none;
    margin: 0;
  }
}
{%- endstyle -%}

<section class="testimonials" id="testimonials" aria-labelledby="testimonials-heading" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="testimonials__header reveal">
      <span class="section-label">{{ section.settings.label | default: 'Testimonials' }}</span>
      <h2 id="testimonials-heading">{{ section.settings.heading | default: 'What Our Community Says' }}</h2>
    </div>

    <div class="testimonials__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'testimonial' -%}
          <article class="testimonial-card reveal reveal-delay-{{ forloop.index | modulo: 3 | plus: 1 }}" {{ block.shopify_attributes }}>
            <div class="testimonial-card__stars" aria-label="{{ block.settings.rating | default: 5 }} out of 5 stars">
              {%- assign star_count = block.settings.rating | default: 5 | round -%}
              {%- for i in (1..star_count) -%}
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              {%- endfor -%}
            </div>
            <p class="testimonial-card__quote">{{ block.settings.quote }}</p>
            <div class="testimonial-card__author">
              {{ block.settings.author }}
              {%- if block.settings.location != blank -%}
                <span class="testimonial-card__location">, {{ block.settings.location }}</span>
              {%- endif -%}
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "testimonials-section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section label",
      "default": "Testimonials"
