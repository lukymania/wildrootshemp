{% comment %}
  Wild Roots dynamic journal index.
  Every card is generated from a real Shopify article and links to its independent page.
{% endcomment %}

<section class="wr-journal-page">
  <div class="wr-journal-hero">
    <div class="wr-journal-hero-inner">
      <p class="wr-journal-eyebrow">Field Notes and Family Wisdom</p>
      <h1>The Root Journal</h1>
      <p>Clear, practical reads on Nano Hemp science, thoughtful routines, product quality, and the family story behind Wild Roots.</p>
    </div>
  </div>

  <div class="wr-journal-shell">
    {% paginate blog.articles by 24 %}
      {% if blog.articles_count > 0 %}
        <div class="wr-journal-grid">
          {% for article in blog.articles %}
            <article class="wr-journal-card">
              <a class="wr-journal-card-link" href="{{ article.url }}" aria-label="Read {{ article.title | escape }}">
                <div class="wr-journal-card-media">
                  {% if article.image %}
                    <img
                      src="{{ article.image | image_url: width: 1000 }}"
                      srcset="{{ article.image | image_url: width: 600 }} 600w, {{ article.image | image_url: width: 1000 }} 1000w"
                      sizes="(min-width: 990px) 33vw, (min-width: 680px) 50vw, 100vw"
                      alt="{{ article.image.alt | default: article.title | escape }}"
                      loading="lazy"
                      width="{{ article.image.width }}"
                      height="{{ article.image.height }}"
                    >
                  {% else %}
                    <div class="wr-journal-card-placeholder" aria-hidden="true">
                      <svg viewBox="0 0 120 120" fill="none">
                        <path d="M60 105V46M60 66C48 62 39 53 35 40M60 78C73 74 83 64 88 51M60 55C68 49 73 41 75 31" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
                        <path d="M35 40C40 25 51 17 60 15C61 28 54 39 35 40ZM88 51C84 36 75 28 65 25C63 39 72 49 88 51Z" fill="currentColor" opacity=".2"/>
                      </svg>
                    </div>
                  {% endif %}
                  <span class="wr-journal-card-tag">{{ article.tags.first | default: 'The Root Journal' }}</span>
                </div>
                <div class="wr-journal-card-body">
                  <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%B %d, %Y' }}</time>
                  <h2>{{ article.title }}</h2>
                  <div class="wr-journal-card-summary">
                    {% if article.excerpt != blank %}
                      {{ article.excerpt | strip_html | truncatewords: 28 }}
                    {% elsif article.content != blank %}
                      {{ article.content | strip_html | truncatewords: 28 }}
                    {% else %}
                      Practical guidance and family-tested perspective from Wild Roots Hemp.
                    {% endif %}
                  </div>
                  <span class="wr-journal-card-cta">Read article <span aria-hidden="true">&rarr;</span></span>
                </div>
              </a>
            </article>
          {% endfor %}
        </div>
      {% else %}
        <p class="wr-journal-empty">New journal entries are coming soon.</p>
      {% endif %}

      {% if paginate.pages > 1 %}
        <nav class="wr-journal-pagination" aria-label="Journal pagination">
          {% if paginate.previous %}<a href="{{ paginate.previous.url }}">Previous</a>{% endif %}
          <span>Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
          {% if paginate.next %}<a href="{{ paginate.next.url }}">Next</a>{% endif %}
        </nav>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

<style>
  .wr-journal-page{--wr-forest:#2D4A3E;--wr-terra:#C17A5F;--wr-cream:#F5F0E8;--wr-ink:#3D2B1F;--wr-sage:#C5D4B8;background:#FAF8F3;color:var(--wr-ink);font-family:'Lato',sans-serif}
  .wr-journal-hero{padding:calc(80px + 88px) 24px 76px;background:linear-gradient(145deg,#F5F0E8 0%,#E8EFE3 100%);border-bottom:1px solid rgba(45,74,62,.1)}
  .wr-journal-hero-inner{max-width:900px;margin:0 auto;text-align:center}
  .wr-journal-eyebrow{margin:0 0 16px;color:var(--wr-terra);font-size:.78rem;font-weight:700;letter-spacing:.16em;text-transform:uppercase}
  .wr-journal-hero h1{margin:0;color:var(--wr-forest);font-family:'Playfair Display',serif;font-size:clamp(3rem,7vw,5.5rem)!important;font-weight:700;line-height:1.02;letter-spacing:-.04em}
  .wr-journal-hero-inner>p:last-child{max-width:700px;margin:24px auto 0;font-size:1.08rem;line-height:1.75;color:rgba(61,43,31,.74)}
  .wr-journal-shell{max-width:1240px;margin:0 auto;padding:80px 32px 104px}
  .wr-journal-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:32px}
  .wr-journal-card{min-width:0;background:#fff;border:1px solid rgba(45,74,62,.1);border-radius:18px;overflow:hidden;box-shadow:0 8px 28px rgba(45,74,62,.07);transition:transform .25s ease,box-shadow .25s ease}
  .wr-journal-card:hover{transform:translateY(-5px);box-shadow:0 16px 38px rgba(45,74,62,.12)}
  .wr-journal-card-link{height:100%;display:flex;flex-direction:column;color:inherit;text-decoration:none}
  .wr-journal-card-media{position:relative;aspect-ratio:16/10;overflow:hidden;background:var(--wr-cream)}
  .wr-journal-card-media img{width:100%;height:100%;display:block;object-fit:cover;transition:transform .4s ease}
  .wr-journal-card:hover .wr-journal-card-media img{transform:scale(1.035)}
  .wr-journal-card-placeholder{width:100%;height:100%;display:grid;place-items:center;color:var(--wr-forest);background:linear-gradient(145deg,#F5F0E8,#DFE8D8)}
  .wr-journal-card-placeholder svg{width:90px;height:90px}
  .wr-journal-card-tag{position:absolute;top:18px;left:18px;max-width:calc(100% - 36px);padding:7px 12px;border-radius:999px;background:rgba(45,74,62,.92);color:#fff;font-size:.68rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .wr-journal-card-body{display:flex;flex:1;flex-direction:column;padding:26px 26px 28px}
  .wr-journal-card-body time{margin-bottom:12px;color:rgba(61,43,31,.55);font-size:.78rem;letter-spacing:.02em}
  .wr-journal-card-body h2{margin:0 0 14px!important;color:var(--wr-forest)!important;font-family:'Playfair Display',serif!important;font-size:1.55rem!important;font-weight:700;line-height:1.22!important;letter-spacing:-.015em!important}
  .wr-journal-card-summary{margin:0 0 22px;color:rgba(61,43,31,.72);font-size:.94rem;line-height:1.65}
  .wr-journal-card-cta{margin-top:auto;color:var(--wr-terra);font-size:.78rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase}
  .wr-journal-empty{text-align:center;font-size:1.05rem}
  .wr-journal-pagination{display:flex;align-items:center;justify-content:center;gap:20px;margin-top:56px;color:var(--wr-forest)}
  .wr-journal-pagination a{color:var(--wr-terra);font-weight:700;text-decoration:none}
  @media(max-width:989px){.wr-journal-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:679px){.wr-journal-hero{padding:calc(80px + 56px) 24px 52px}.wr-journal-shell{padding:52px 20px 72px}.wr-journal-grid{grid-template-columns:1fr;gap:24px}.wr-journal-card-body{padding:22px 22px 24px}}
</style>

{% schema %}
{"name":"Wild Roots journal","settings":[]}
{% endschema %}
