{% comment %}
  Journal Featured Section
  - Shows latest 3 blog articles
  - Link to journal/blog page
{% endcomment %}

{%- style -%}
.journal-featured {
  background-color: #fff;
  padding: 5rem 0;
}

.journal-featured__header {
  text-align: center;
  margin-bottom: 3rem;
}

.journal-featured__header h2 {
  color: var(--forest-deep, #0f241c);
}

.journal-featured__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 2rem;
}

.journal-card {
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(45, 74, 62, 0.08);
  border: 1px solid rgba(196, 168, 130, 0.2);
  transition: all 0.3s ease;
  background-color: #fff;
}

.journal-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 8px 24px rgba(45, 74, 62, 0.12);
}

.journal-card__image {
  width: 100%;
  aspect-ratio: 16 / 9;
  background-color: var(--light-sage, #C5D4B8);
  position: relative;
  overflow: hidden;
}

.journal-card__image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}

.journal-card:hover .journal-card__image img {
  transform: scale(1.05);
}

.journal-card__content {
  padding: 1.5rem;
}

.journal-card__date {
  font-size: 0.8rem;
  color: var(--terra-cotta, #C17A5F);
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-bottom: 0.5rem;
  display: block;
}

.journal-card__title {
  font-family: var(--font-headline);
  font-weight: 700;
  font-size: 1.15rem;
  color: var(--forest-deep, #0f241c);
  line-height: 1.4;
  margin-bottom: 0.75rem;
}

.journal-card__title a {
  color: inherit;
  text-decoration: none;
}

.journal-card__title a:hover {
  color: var(--terra-cotta, #C17A5F);
}

.journal-card__excerpt {
  font-size: 0.9rem;
  color: rgba(61, 43, 31, 0.7);
  line-height: 1.6;
  margin-bottom: 1rem;
}

.journal-card__link {
  font-family: var(--font-body);
  font-weight: 700;
  font-size: 0.8rem;
  color: var(--terra-cotta, #C17A5F);
  text-transform: uppercase;
  letter-spacing: 1.5px;
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  text-decoration: none;
  transition: gap 0.3s ease;
}

.journal-card__link:hover {
  gap: 0.65rem;
  color: var(--raw-umber, #6B4226);
}

.journal-featured__footer {
  text-align: center;
  margin-top: 3rem;
}

@media (min-width: 640px) {
  .journal-featured__grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1024px) {
  .journal-featured {
    padding: 6rem 0;
  }

  .journal-featured__grid {
    grid-template-columns: repeat(3, 1fr);
  }
}
{%- endstyle -%}

<section class="journal-featured" id="journal" aria-labelledby="journal-heading" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="journal-featured__header reveal">
      <span class="section-label">{{ section.settings.label | default: 'Journal' }}</span>
      <h2 id="journal-heading">{{ section.settings.heading | default: 'From the Root Journal' }}</h2>
    </div>

    <div class="journal-featured__grid">
      {%- assign blog_handle = section.settings.blog -%}
      {%- if blog_handle != blank -%}
        {%- assign blog = blogs[blog_handle] -%}
        {%- if blog != blank -%}
          {%- for article in blog.articles limit: section.settings.articles_to_show -%}
            <article class="journal-card reveal reveal-delay-{{ forloop.index }}" itemscope itemtype="https://schema.org/Article">
              <meta itemprop="author" content="{{ article.author }}">
              <div class="journal-card__image">
                {%- if article.image != blank -%}
                  {{ article.image | image_url: width: 600 | image_tag:
                    loading: 'lazy',
                    alt: article.title,
                    itemprop: 'image'
                  }}
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
                {%- endif -%}
              </div>
              <div class="journal-card__content">
                <time class="journal-card__date" itemprop="datePublished" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                  {{ article.published_at | date: '%B %d, %Y' }}
                </time>
                <h3 class="journal-card__title">
                  <a href="{{ article.url }}" itemprop="headline url">{{ article.title }}</a>
                </h3>
                <p class="journal-card__excerpt" itemprop="description">
                  {%- if article.excerpt != blank -%}
                    {{ article.excerpt | strip_html | truncatewords: 20 }}
                  {%- else -%}
                    {{ article.content | strip_html | truncatewords: 20 }}
                  {%- endif -%}
                </p>
                <a href="{{ article.url }}" class="journal-card__link">Read More →</a>
              </div>
            </article>
          {%- endfor -%}
        {%- else -%}
          <p style="text-align:center;grid-column:1/-1;color:rgba(61,43,31,0.6);">Select a blog to display articles.</p>
        {%- endif -%}
      {%- else -%}
        {%- comment -%}Default placeholder articles{%- endcomment -%}
        {%- for i in (1..3) -%}
          <article class="journal-card reveal reveal-delay-{{ forloop.index }}">
            <div class="journal-card__image">
              {{ 'lifestyle-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg placeholder' }}
            </div>
            <div class="journal-card__content">
              <span class="journal-card__date">January {{ forloop.index | times: 5 }}, 2026</span>
              <h3 class="journal-card__title">
                <a href="#">Journal Article Placeholder {{ forloop.index }}</a>
              </h3>
              <p class="journal-card__excerpt">Select a blog in section settings to display real articles from your store's blog.</p>
              <a href="#" class="journal-card__link">Read More →</a>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.show_view_all -%}
      <div class="journal-featured__footer reveal">
        <a href="{{ section.settings.view_all_link | default: '/blogs/journal' }}" class="btn btn-secondary">
          {{ section.settings.view_all_text | default: 'View All Articles' }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Journal Featured",
  "tag": "section",
  "class": "journal-featured-section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section label",
      "default": "Journal"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From the Root Journal"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "articles_to_show",
      "label": "Articles to show",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All' button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All button text",
      "default": "View All Articles"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All link",
      "default": "/blogs/journal"
    }
  ],
  "presets": [
    {
      "name": "Journal Featured",
      "category": "Blog"
    }
  ]
}
{% endschema %}
