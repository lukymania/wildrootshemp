<style>
/* ============================================
WILD ROOTS HEMP, PRODUCT PAGE STYLES
============================================ */

/* CSS Custom Properties */
:root {
--deep-forest: #2D4A3E;
--sage-mist: #9CAF88;
--raw-umber: #6B4226;
--terra-cotta: #C17A5F;
--cream: #F5F0E8;
--dark-brown: #3D2B1F;
--light-sage: #C5D4B8;
--kraft-brown: #C4A882;

--font-headline: 'Playfair Display', serif;
--font-body: 'Lato', sans-serif;
--font-accent: 'Cormorant Garamond', serif;

--max-width: 1200px;
--header-height: 80px;
--transition: all 0.3s ease;
--shadow-sm: 0 2px 8px rgba(45, 74, 62, 0.08);
--shadow-md: 0 8px 24px rgba(45, 74, 62, 0.12);
--shadow-lg: 0 16px 48px rgba(45, 74, 62, 0.16);
      --forest-deep: #0f241c;
    }

/* Reset & Base */
*, *::before, *::after {
margin: 0;
padding: 0;
box-sizing: border-box;
}

html {
scroll-behavior: smooth;
font-size: 16px;
}

body {
font-family: var(--font-body);
font-weight: 400;
color: var(--dark-brown);
background-color: var(--cream);
line-height: 1.6;
-webkit-font-smoothing: antialiased;
-moz-osx-font-smoothing: grayscale;
overflow-x: hidden;
}

h1, h2, h3, h4 {
font-family: var(--font-headline);
font-weight: 700;
line-height: 1.2;
color: var(--deep-forest);
}

h1 { font-size: clamp(2.5rem, 5vw, 4rem); }
h2 { font-size: clamp(2rem, 4vw, 3rem); }
h3 { font-size: clamp(1.25rem, 2.5vw, 1.75rem); }
h4 { font-size: 1.25rem; }

p {
margin-bottom: 1rem;
font-size: 1rem;
line-height: 1.7;
}

a {
color: var(--terra-cotta);
text-decoration: none;
transition: var(--transition);
}

a:hover {
color: var(--raw-umber);
}

img {
max-width: 100%;
height: auto;
display: block;
}

.container {
max-width: var(--max-width);
margin: 0 auto;
padding: 0 1.5rem;
}

.section-padding {
padding: 5rem 0;
}

/* Scroll Reveal Animation */
.reveal {
  opacity: 1;
transform: translateY(30px);
transition: opacity 0.8s ease, transform 0.8s ease;
}

.reveal.active {
opacity: 1;
transform: translateY(0);
}

.reveal-delay-1 { transition-delay: 0.1s; }
.reveal-delay-2 { transition-delay: 0.2s; }
.reveal-delay-3 { transition-delay: 0.3s; }
.reveal-delay-4 { transition-delay: 0.4s; }

/* Buttons */
.btn {
display: inline-block;
padding: 1rem 2.5rem;
font-family: var(--font-body);
font-weight: 700;
font-size: 0.95rem;
text-transform: uppercase;
letter-spacing: 1.5px;
border: none;
cursor: pointer;
transition: var(--transition);
text-align: center;
}

.btn-primary {
background-color: var(--terra-cotta);
color: #fff;
border-radius: 4px;
}

.btn-primary:hover {
background-color: var(--raw-umber);
color: #fff;
transform: translateY(-2px);
box-shadow: var(--shadow-md);
}

.btn-secondary {
background-color: transparent;
color: var(--deep-forest);
border: 2px solid var(--deep-forest);
border-radius: 4px;
}

.btn-secondary:hover {
background-color: var(--deep-forest);
color: var(--cream);
transform: translateY(-2px);
}

.btn-ghost {
background-color: transparent;
color: var(--terra-cotta);
border: 2px solid var(--terra-cotta);
border-radius: 4px;
}

.btn-ghost:hover {
background-color: var(--terra-cotta);
color: #fff;
transform: translateY(-2px);
}

/* Section Label */
.section-label {
font-family: var(--font-accent);
font-style: italic;
font-size: 1.15rem;
color: var(--terra-cotta);
margin-bottom: 0.75rem;
display: block;
}

/* ============================================
HEADER
============================================ */
.site-header {
position: fixed;
top: 0;
left: 0;
right: 0;
height: var(--header-height);
background-color: var(--cream);
z-index: 1000;
border-bottom: 1px solid rgba(45, 74, 62, 0.12);
transition: var(--transition);
}

.header-inner {
max-width: var(--max-width);
margin: 0 auto;
padding: 0 1.5rem;
height: 100%;
display: flex;
align-items: center;
justify-content: space-between;
}

.logo {
display: flex;
align-items: center;
gap: 0.75rem;
text-decoration: none;
}

.logo-img {
height: 68px;
width: auto;
display: block;
}

.nav-desktop {
display: none;
}

.nav-list {
display: flex;
list-style: none;
gap: 2.5rem;
}

.nav-list a {
font-family: var(--font-body);
font-weight: 400;
font-size: 0.9rem;
color: var(--dark-brown);
text-transform: uppercase;
letter-spacing: 1px;
position: relative;
padding-bottom: 4px;
}

.nav-list a::after {
content: '';
position: absolute;
bottom: 0;
left: 0;
width: 0;
height: 2px;
background-color: var(--terra-cotta);
transition: width 0.3s ease;
}

.nav-list a:hover::after {
width: 100%;
}

.nav-list a:hover {
color: var(--terra-cotta);
}

.header-actions {
display: flex;
align-items: center;
gap: 1.5rem;
}

.cart-btn {
position: relative;
background: none;
border: none;
cursor: pointer;
padding: 0.5rem;
}

.cart-btn svg {
width: 24px;
height: 24px;
stroke: var(--deep-forest);
transition: stroke 0.3s ease;
}

.cart-btn:hover svg {
stroke: var(--terra-cotta);
}

.cart-count {
position: absolute;
top: -2px;
right: -6px;
background-color: var(--terra-cotta);
color: #fff;
font-size: 0.65rem;
font-weight: 700;
width: 18px;
height: 18px;
border-radius: 50%;
display: flex;
align-items: center;
justify-content: center;
}

/* Mobile Menu Toggle */
.menu-toggle {
display: flex;
flex-direction: column;
justify-content: space-between;
width: 28px;
height: 20px;
background: none;
border: none;
cursor: pointer;
padding: 0;
  z-index: 1001;
  touch-action: manipulation;
  -webkit-tap-highlight-color: transparent;
}

.menu-toggle span {
display: block;
width: 100%;
height: 2px;
background-color: var(--deep-forest);
transition: var(--transition);
transform-origin: center;
}

.menu-toggle.active span:nth-child(1) {
transform: translateY(9px) rotate(45deg);
}

.menu-toggle.active span:nth-child(2) {
opacity: 0;
}

.menu-toggle.active span:nth-child(3) {
transform: translateY(-9px) rotate(-45deg);
}

/* Mobile Navigation */
.mobile-nav {
position: fixed;
top: var(--header-height);
left: 0;
right: 0;
bottom: 0;
background-color: var(--cream);
z-index: 999;
padding: 2rem;
transform: translate3d(100%, 0, 0);
transition: transform 0.4s ease;
overflow-y: auto;
}

.mobile-nav.active {
transform: translate3d(0, 0, 0);
}

.mobile-nav-list {
list-style: none;
display: flex;
flex-direction: column;
gap: 1.5rem;
}

.mobile-nav-list a {
font-family: var(--font-headline);
font-weight: 700;
font-size: 1.5rem;
color: var(--deep-forest);
display: block;
padding: 0.5rem 0;
border-bottom: 1px solid var(--light-sage);
}

.mobile-nav-list a:hover {
color: var(--terra-cotta);
}

/* ============================================
BREADCRUMB
============================================ */
.breadcrumb-section {
padding-top: calc(var(--header-height) + 1.5rem);
padding-bottom: 1rem;
background-color: var(--cream);
border-bottom: 1px solid rgba(196, 168, 130, 0.2);
}

.breadcrumb {
display: flex;
flex-wrap: wrap;
gap: 0.5rem;
align-items: center;
font-size: 0.85rem;
color: rgba(61, 43, 31, 0.6);
}

.breadcrumb a {
color: var(--deep-forest);
font-weight: 400;
}

.breadcrumb a:hover {
color: var(--terra-cotta);
}

.breadcrumb-separator {
color: rgba(61, 43, 31, 0.3);
}

.breadcrumb-current {
color: var(--terra-cotta);
font-weight: 700;
}

/* ============================================
PRODUCT HERO
============================================ */
.product-hero {
padding: 3rem 0 4rem;
background-color: var(--cream);
}

.product-hero-inner {
display: grid;
grid-template-columns: 1fr;
gap: 3rem;
align-items: start;
}

/* Product Gallery */
.product-gallery {
position: relative;
}

.product-gallery-main {
background: linear-gradient(135deg, #F5F0E8 0%, #E8E0D4 100%);
border-radius: 16px;
padding: 2rem;
display: flex;
align-items: center;
justify-content: center;
min-height: 400px;
position: relative;
overflow: hidden;
box-shadow: var(--shadow-md);
}

.product-gallery-main img {
max-height: 420px;
width: auto;
object-fit: contain;
transition: transform 0.5s ease;
}

.product-gallery-main:hover img {
transform: scale(1.03);
}

.product-badge-hero {
position: absolute;
top: 1.5rem;
left: 1.5rem;
background-color: var(--terra-cotta);
color: #fff;
font-size: 0.75rem;
font-weight: 700;
text-transform: uppercase;
letter-spacing: 1px;
padding: 0.4rem 1rem;
border-radius: 20px;
z-index: 2;
}

.product-badge-strength {
position: absolute;
top: 1.5rem;
right: 1.5rem;
background-color: var(--deep-forest);
color: #fff;
font-size: 0.75rem;
font-weight: 700;
text-transform: uppercase;
letter-spacing: 1px;
padding: 0.4rem 1rem;
border-radius: 20px;
z-index: 2;
}

/* Product Info */
.product-info-block {
display: flex;
flex-direction: column;
gap: 1.5rem;
}

.product-category-label {
font-family: var(--font-accent);
font-style: italic;
font-size: 1.1rem;
color: var(--terra-cotta);
}

.product-title {
font-family: var(--font-headline);
font-weight: 900;
font-size: clamp(2rem, 4vw, 3rem);
color: var(--deep-forest);
line-height: 1.15;
margin: 0;
}

.product-subtitle {
font-family: var(--font-body);
font-weight: 400;
font-size: 1.05rem;
color: rgba(61, 43, 31, 0.7);
margin: 0;
}

/* Star Rating */
.product-rating {
display: flex;
align-items: center;
gap: 0.75rem;
}

.stars {
display: flex;
gap: 0.2rem;
}

.stars svg {
width: 20px;
height: 20px;
fill: var(--kraft-brown);
}

.rating-text {
font-size: 0.9rem;
color: rgba(61, 43, 31, 0.6);
}

/* Product Price */
.product-price-block {
display: flex;
align-items: baseline;
gap: 1rem;
flex-wrap: wrap;
}

.product-price-current {
font-family: var(--font-headline);
font-weight: 900;
font-size: 2.5rem;
color: var(--raw-umber);
}

.product-price-note {
font-size: 0.85rem;
color: rgba(61, 43, 31, 0.5);
}

/* Specs */
.product-specs {
display: grid;
grid-template-columns: repeat(3, 1fr);
gap: 1rem;
}

.spec-item {
text-align: center;
padding: 1rem;
background-color: #fff;
border-radius: 10px;
border: 1px solid rgba(196, 168, 130, 0.2);
transition: var(--transition);
}

.spec-item:hover {
transform: translateY(-3px);
box-shadow: var(--shadow-sm);
}

.spec-value {
font-family: var(--font-headline);
font-weight: 900;
font-size: 1.5rem;
color: var(--deep-forest);
display: block;
line-height: 1;
margin-bottom: 0.35rem;
}

.spec-label {
font-size: 0.75rem;
color: rgba(61, 43, 31, 0.6);
text-transform: uppercase;
letter-spacing: 0.5px;
}

/* Add to Cart */
.add-to-cart-block {
display: flex;
flex-direction: column;
gap: 1rem;
padding-top: 0.5rem;
}

.quantity-selector {
display: flex;
align-items: center;
gap: 0;
border: 2px solid var(--deep-forest);
border-radius: 4px;
overflow: hidden;
width: fit-content;
}

.qty-btn {
width: 44px;
height: 44px;
background-color: var(--cream);
border: none;
cursor: pointer;
font-size: 1.25rem;
font-weight: 700;
color: var(--deep-forest);
transition: var(--transition);
display: flex;
align-items: center;
justify-content: center;
}

.qty-btn:hover {
background-color: var(--deep-forest);
color: #fff;
}

.qty-input {
width: 60px;
height: 44px;
border: none;
border-left: 2px solid var(--deep-forest);
border-right: 2px solid var(--deep-forest);
text-align: center;
font-family: var(--font-body);
font-weight: 700;
font-size: 1rem;
color: var(--deep-forest);
background-color: #fff;
-moz-appearance: textfield;
}

.qty-input::-webkit-outer-spin-button,
.qty-input::-webkit-inner-spin-button {
-webkit-appearance: none;
margin: 0;
}

.add-to-cart-btn {
width: 100%;
padding: 1.15rem 2rem;
font-size: 1rem;
letter-spacing: 2px;
}

.product-guarantee {
display: flex;
align-items: center;
gap: 0.5rem;
font-size: 0.85rem;
color: rgba(61, 43, 31, 0.6);
}

.product-guarantee svg {
width: 18px;
height: 18px;
stroke: var(--sage-mist);
fill: none;
stroke-width: 2;
flex-shrink: 0;
}

/* Trust Badges Row */
.product-trust-row {
display: flex;
flex-wrap: wrap;
gap: 1rem;
padding-top: 0.5rem;
}

.product-trust-badge {
display: flex;
align-items: center;
gap: 0.4rem;
font-size: 0.8rem;
color: rgba(61, 43, 31, 0.65);
text-transform: uppercase;
letter-spacing: 0.5px;
}

.product-trust-badge svg {
width: 16px;
height: 16px;
stroke: var(--sage-mist);
fill: none;
stroke-width: 2;
}

/* ============================================
HOW IT WORKS
============================================ */
.how-it-works {
background-color: #fff;
padding: 5rem 0;
border-top: 1px solid rgba(196, 168, 130, 0.2);
}

.how-header {
text-align: center;
margin-bottom: 3rem;
}

.how-header h2 {
margin-bottom: 0.75rem;
}

.how-header p {
color: rgba(61, 43, 31, 0.7);
max-width: 600px;
margin: 0 auto;
}

.how-grid {
display: grid;
grid-template-columns: 1fr;
gap: 2.5rem;
margin-bottom: 3rem;
}

.how-card {
text-align: center;
padding: 2rem;
background-color: var(--cream);
border-radius: 12px;
transition: var(--transition);
max-width: 400px;
margin: 0 auto;
}

.how-card:hover {
transform: translateY(-6px);
box-shadow: var(--shadow-md);
}

.how-icon {
width: 72px;
height: 72px;
margin: 0 auto 1.25rem;
background-color: var(--deep-forest);
border-radius: 50%;
display: flex;
align-items: center;
justify-content: center;
}

.how-icon svg {
width: 32px;
height: 32px;
stroke: #fff;
fill: none;
stroke-width: 1.5;
}

.how-card h3 {
margin-bottom: 0.75rem;
}

.how-card p {
color: rgba(61, 43, 31, 0.75);
margin-bottom: 0;
}

/* How It Works Visual */
.how-visual {
max-width: 900px;
margin: 0 auto;
border-radius: 16px;
overflow: hidden;
box-shadow: var(--shadow-lg);
border: 1px solid rgba(196, 168, 130, 0.2);
}

.how-visual img {
width: 100%;
display: block;
}

.how-visual-caption {
text-align: center;
font-size: 0.85rem;
color: rgba(61, 43, 31, 0.5);
margin-top: 0.75rem;
font-style: italic;
}

/* ============================================
KEY FEATURES
============================================ */
.features-section {
background: linear-gradient(135deg, var(--deep-forest) 0%, #1e362d 100%);
padding: 5rem 0;
position: relative;
overflow: hidden;
}

/* Subtle background decoration removed per request */

.features-header {
text-align: center;
margin-bottom: 3rem;
position: relative;
z-index: 2;
}

.features-header h2 {
color: #fff;
margin-bottom: 0.75rem;
}

.features-header p {
color: rgba(255, 255, 255, 0.75);
max-width: 500px;
margin: 0 auto;
}

.features-grid {
display: grid;
grid-template-columns: 1fr;
gap: 1.5rem;
position: relative;
z-index: 2;
}

.feature-card {
background-color: rgba(45, 74, 62, 0.85);
border: 1px solid rgba(156, 175, 136, 0.25);
border-radius: 12px;
padding: 2rem;
text-align: center;
transition: var(--transition);
}

.feature-card:hover {
background-color: rgba(45, 74, 62, 0.95);
border-color: rgba(156, 175, 136, 0.4);
transform: translateY(-6px);
box-shadow: 0 16px 48px rgba(0,0,0,0.2);
}

.feature-icon {
width: 64px;
height: 64px;
margin: 0 auto 1rem;
background-color: rgba(156, 175, 136, 0.2);
border-radius: 50%;
display: flex;
align-items: center;
justify-content: center;
}

.feature-icon svg {
width: 30px;
height: 30px;
stroke: var(--sage-mist);
fill: none;
stroke-width: 1.5;
}

.feature-card h3 {
color: #fff;
font-size: 1.35rem;
margin-bottom: 0.75rem;
}

.feature-card p {
color: rgba(255, 255, 255, 0.7);
font-size: 0.95rem;
margin-bottom: 0;
}

/* ============================================
INGREDIENTS
============================================ */
.ingredients-section {
background-color: var(--cream);
padding: 5rem 0;
}

.ingredients-header {
text-align: center;
margin-bottom: 3rem;
}

.ingredients-header h2 {
margin-bottom: 0.75rem;
}

.ingredients-header p {
color: rgba(61, 43, 31, 0.7);
max-width: 600px;
margin: 0 auto;
}

.ingredients-grid {
display: grid;
grid-template-columns: 1fr;
gap: 1.5rem;
margin-bottom: 2.5rem;
}

.ingredient-card {
background-color: #fff;
border-radius: 12px;
padding: 1.75rem;
border: 1px solid rgba(196, 168, 130, 0.2);
transition: var(--transition);
text-align: center;
}

.ingredient-card:hover {
transform: translateY(-4px);
box-shadow: var(--shadow-md);
border-color: var(--sage-mist);
}

.ingredient-icon {
width: 56px;
height: 56px;
margin: 0 auto 1rem;
background-color: var(--light-sage);
border-radius: 50%;
display: flex;
align-items: center;
justify-content: center;
}

.ingredient-icon svg {
width: 26px;
height: 26px;
stroke: var(--deep-forest);
fill: none;
stroke-width: 1.5;
}

.ingredient-card h4 {
font-size: 1.15rem;
margin-bottom: 0.5rem;
}

.ingredient-card p {
font-size: 0.9rem;
color: rgba(61, 43, 31, 0.7);
margin-bottom: 0;
line-height: 1.6;
}

.ingredient-note {
text-align: center;
padding: 1.25rem;
background-color: rgba(156, 175, 136, 0.15);
border-radius: 10px;
border-left: 4px solid var(--sage-mist);
max-width: 700px;
margin: 0 auto;
}

.ingredient-note p {
font-size: 0.9rem;
color: rgba(61, 43, 31, 0.7);
margin-bottom: 0;
}

/* ============================================
HOW TO USE
============================================ */
.usage-section {
background-color: #fff;
padding: 5rem 0;
border-top: 1px solid rgba(196, 168, 130, 0.2);
}

.usage-header {
text-align: center;
margin-bottom: 3rem;
}

.usage-header h2 {
margin-bottom: 0.75rem;
}

.usage-header p {
color: rgba(61, 43, 31, 0.7);
max-width: 550px;
margin: 0 auto;
}

.usage-steps {
display: grid;
grid-template-columns: 1fr;
gap: 2rem;
counter-reset: step;
}

.usage-with-image {
display: flex;
flex-wrap: wrap;
gap: 2rem;
align-items: stretch;
max-width: 1200px;
margin: 0 auto 2rem;
}

.usage-image {
flex: 0 0 380px;
max-width: 380px;
margin: 0 auto;
}

.usage-image img {
width: 100%;
border-radius: 16px;
box-shadow: 0 12px 40px rgba(0,0,0,0.12);
display: block;
}

.usage-steps-col {
flex: 1;
min-width: 280px;
display: flex;
align-items: stretch;
}

.usage-steps-col .usage-steps {
grid-template-columns: 1fr;
gap: 1rem;
width: 100%;
}

.usage-steps-col .usage-step {
flex-direction: row;
text-align: left;
padding: 1.25rem 1.5rem;
align-items: center;
}

.usage-steps-col .step-content h4 {
font-size: 1.1rem;
margin-bottom: 0.35rem;
}

.usage-steps-col .step-content p {
font-size: 0.9rem;
line-height: 1.5;
}

.usage-options {
margin: 0;
padding-left: 1.15rem;
color: rgba(61, 43, 31, 0.75);
font-size: 0.9rem;
line-height: 1.5;
}

.usage-options li + li {
margin-top: 0.45rem;
}

.usage-step {
display: flex;
gap: 1.5rem;
align-items: flex-start;
padding: 1.75rem;
background-color: var(--cream);
border-radius: 12px;
transition: var(--transition);
}

.usage-step:hover {
transform: translateY(-4px);
box-shadow: var(--shadow-md);
}

.step-number {
width: 52px;
height: 52px;
background-color: var(--terra-cotta);
color: #fff;
border-radius: 50%;
display: flex;
align-items: center;
justify-content: center;
font-family: var(--font-headline);
font-weight: 900;
font-size: 1.35rem;
flex-shrink: 0;
}

.step-content h4 {
font-size: 1.15rem;
margin-bottom: 0.5rem;
}

.step-content p {
font-size: 0.95rem;
