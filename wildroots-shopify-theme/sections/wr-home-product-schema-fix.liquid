{%- comment -%}
  Generates one authoritative, complete Product graph on the homepage
  from live Shopify catalog data. Legacy incomplete Product entities are
  removed server-side in the homepage section rather than with JavaScript.
{%- endcomment -%}

{%- assign product_handles = 'root-relief,wild-relief,deep-roots,deep-rest,daily-roots,paw-root' | split: ',' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {%- assign rendered_products = 0 -%}
    {%- for product_handle in product_handles -%}
      {%- assign schema_product = all_products[product_handle] -%}
      {%- assign schema_variant = schema_product.selected_or_first_available_variant -%}
      {%- if schema_product != blank and schema_variant != blank -%}
        {%- if rendered_products > 0 -%},{%- endif -%}
        {%- assign rendered_products = rendered_products | plus: 1 -%}
        {%- capture fallback_image_url -%}
          {%- case product_handle -%}
            {%- when 'root-relief' -%}https://cdn.shopify.com/s/files/1/0804/0572/5416/files/product-rollon-cutout.png?v=1788382268
            {%- when 'wild-relief' -%}https://cdn.shopify.com/s/files/1/0804/0572/5416/files/product-mist-cutout.png?v=1788382255
            {%- when 'deep-roots' -%}https://cdn.shopify.com/s/files/1/0804/0572/5416/files/product-deep-roots-cutout.png?v=1788382239
            {%- when 'deep-rest' -%}https://cdn.shopify.com/s/files/1/0804/0572/5416/files/product-deep-rest-cutout.png?v=1788382260
            {%- when 'daily-roots' -%}https://cdn.shopify.com/s/files/1/0804/0572/5416/files/product-daily-roots-cutout.png?v=1788382235
            {%- when 'paw-root' -%}https://cdn.shopify.com/s/files/1/0804/0572/5416/files/product-paw-root-cutout.png?v=1788382264
          {%- endcase -%}
        {%- endcapture -%}
        {
          "@type": "Product",
          "@id": {{ shop.url | append: schema_product.url | append: '#product' | json }},
          "name": {{ schema_product.title | json }},
          "url": {{ shop.url | append: schema_product.url | json }},
          "description": {{ schema_product.description | strip_html | strip_newlines | truncate: 500 | json }},
          "image": [
            {%- if schema_product.featured_image != blank -%}
              {{ schema_product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }}
            {%- else -%}
              {{ fallback_image_url | strip | json }}
            {%- endif -%}
          ],
          "brand": {
            "@type": "Brand",
            "name": "Wild Roots Hemp"
          },
          {%- if schema_variant.sku != blank %}
          "sku": {{ schema_variant.sku | json }},
          {%- endif %}
          "offers": {
            "@type": "Offer",
            "url": {{ shop.url | append: schema_product.url | json }},
            "priceCurrency": {{ cart.currency.iso_code | default: shop.currency | json }},
            "price": {{ schema_variant.price | divided_by: 100.0 | json }},
            "availability": "https://schema.org/{% if schema_variant.available %}InStock{% else %}OutOfStock{% endif %}",
            "itemCondition": "https://schema.org/NewCondition",
            "seller": {
              "@id": "https://wildrootshemp.com/#organization"
            }
          }
        }
      {%- endif -%}
    {%- endfor -%}
  ]
}
</script>

{% schema %}
{
  "name": "Product schema fix",
  "settings": [],
  "presets": [
    {
      "name": "Product schema fix"
    }
  ]
}
{% endschema %}
