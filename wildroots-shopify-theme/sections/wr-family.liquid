<script>
  // Mobile menu toggle
  var menuToggle = document.getElementById('menuToggle');
  var mobileNav = document.getElementById('mobileNav');
  function toggleMenu() {
    menuToggle.classList.toggle('active');
    mobileNav.classList.toggle('active');
    var isOpen = mobileNav.classList.contains('active');
    menuToggle.setAttribute('aria-expanded', isOpen);
    document.body.style.overflow = isOpen ? 'hidden' : '';
  }
  menuToggle.addEventListener('click', toggleMenu);
  menuToggle.addEventListener('touchstart', function(e) { e.preventDefault(); toggleMenu(); }, {passive: false});
</script>

<!-- Hero Video Boomerang -->
<script>
(function() {
  var video = document.querySelector('.family-hero-video-legacy-disabled');
  if (!video) return;
  var forward = true;
  var lastTime = 0;
  var PAD = 0.06;

  function playForward() {
    forward = true;
    lastTime = 0;
    video.play().catch(function(){});
  }

  function seekLoop(timestamp) {
    if (forward) return;
    if (!lastTime) lastTime = timestamp;
    var elapsed = (timestamp - lastTime) / 1000;
    lastTime = timestamp;
    var duration = video.duration;
    if (!duration || isNaN(duration)) { requestAnimationFrame(seekLoop); return; }
    video.currentTime = Math.max(video.currentTime - elapsed, PAD);
    if (video.currentTime <= PAD) {
      playForward();
    } else {
      requestAnimationFrame(seekLoop);
    }
  }

  function monitor() {
    if (!forward) { requestAnimationFrame(monitor); return; }
    var duration = video.duration;
    if (!duration || isNaN(duration)) { requestAnimationFrame(monitor); return; }
    if (video.currentTime >= duration - PAD) {
      forward = false;
      lastTime = 0;
      video.pause();
      requestAnimationFrame(seekLoop);
    } else {
      requestAnimationFrame(monitor);
    }
  }

  function start() {
    video.play().then(function(){ requestAnimationFrame(monitor); }).catch(function(){ requestAnimationFrame(monitor); });
  }

  if (video.readyState >= 1) {
    start();
  } else {
    video.addEventListener('loadedmetadata', start);
  }
})();
</script>


