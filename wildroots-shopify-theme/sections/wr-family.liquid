<style>
    :root {
      --deep-forest: #2D4A3E;
      --sage-mist: #9CAF88;
      --terra-cotta: #C17A5F;
      --cream: #F5F0E8;
      --white: #FFFFFF;
      --charcoal: #3D3D3D;
      --raw-umber: #8B7355;
      --light-sage: #E8E6D9;
      --font-headline: 'Playfair Display', serif;
      --font-body: 'Lato', sans-serif;
      --font-accent: 'Cormorant Garamond', serif;
      --header-height: 80px;
      --max-width: 1200px;
      --forest-deep: #2D4A3E;
      --lavender: #9CAF88;
      --font-display: 'Playfair Display', serif;
      --transition: all 0.3s ease;
    }
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: var(--font-body); color: var(--charcoal); background: var(--cream); line-height: 1.6; }
    a { text-decoration: none; color: inherit; }
    img { max-width: 100%; height: auto; display: block; }

    /* Header */
    .site-header { position: fixed; top: 0; left: 0; right: 0; height: var(--header-height); background-color: var(--cream); z-index: 1000; border-bottom: 1px solid rgba(45, 74, 62, 0.12); }
    .header-inner { max-width: var(--max-width); margin: 0 auto; padding: 0 2rem; height: 100%; display: flex; align-items: center; justify-content: space-between; }
    .logo-img { height: 68px; width: auto; display: block; }
    .nav-desktop { display: none; }
    .nav-list { display: flex; list-style: none; gap: 2.5rem; margin: 0; padding: 0; }
    .nav-list li { display: flex; }
    .nav-list a { font-family: var(--font-body); font-weight: 400; font-size: 0.9rem; letter-spacing: 1px; text-transform: uppercase; color: var(--charcoal); position: relative; padding: 0.25rem 0; transition: color 0.2s; }
    .nav-list a:hover { color: var(--terra-cotta); }
    .header-actions { display: flex; align-items: center; gap: 1rem; }
    .cart-btn { position: relative; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; background: transparent; border: 0; color: var(--deep-forest); cursor: pointer; text-decoration: none; }
    .cart-btn svg { width: 24px; height: 24px; stroke: currentColor; fill: none; }
    .cart-btn:hover { color: var(--terra-cotta); }
    .cart-count { position: absolute; top: -1px; right: -2px; min-width: 18px; height: 18px; padding: 0 4px; border-radius: 999px; display: flex; align-items: center; justify-content: center; background: var(--terra-cotta); color: #fff; font-size: 0.65rem; font-weight: 700; line-height: 1; }
    .menu-toggle { display: flex; flex-direction: column; gap: 5px; padding: 8px; z-index: 1001; touch-action: manipulation; -webkit-tap-highlight-color: transparent; background: none; border: none; cursor: pointer; }
    .menu-toggle span { display: block; width: 24px; height: 2px; background: var(--deep-forest); transition: all 0.3s ease; }
    .mobile-nav { display: none; position: fixed; top: var(--header-height); left: 0; right: 0; bottom: 0; background: rgba(245, 240, 232, 0.98); backdrop-filter: blur(20px); padding: 2rem; flex-direction: column; gap: 1.5rem; z-index: 999; }
    .mobile-nav.active { display: flex; }
    .mobile-nav-list { list-style: none; display: flex; flex-direction: column; gap: 1.5rem; }
    .mobile-nav-list a { font-family: var(--font-headline); font-weight: 700; font-size: 1.5rem; color: var(--deep-forest); display: block; padding: 0.5rem 0; border-bottom: 1px solid var(--light-sage); }
    .mobile-nav-list a:hover { color: var(--terra-cotta); }
    @media (min-width: 769px) {
      .nav-desktop { display: flex !important; align-items: center; }
      .menu-toggle { display: none !important; }
    }

    /* Hero */
    .family-hero { margin-top: var(--header-height); padding: 5rem 0 4rem; background: linear-gradient(135deg, var(--deep-forest) 0%, #1e362d 100%); text-align: center; color: #fff; position: relative; overflow: hidden; }
    .family-hero-video { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; opacity: 0.35; }
    .family-hero-overlay { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: linear-gradient(135deg, rgba(45,74,62,0.7) 0%, rgba(30,54,45,0.8) 100%); z-index: 1; }
    .family-hero .container { position: relative; z-index: 2; }
    .family-hero h1 { font-family: var(--font-headline); font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 700; margin-bottom: 1rem; color: #F1C6A8; text-shadow: 0 2px 18px rgba(10, 29, 23, 0.8); }
    .family-hero p { font-size: 1.15rem; max-width: 600px; margin: 0 auto; opacity: 0.85; }

    /* Nick card image fix - anchor to top so head is visible */
    .family-card.dad .family-card-image img,
    .family-card:nth-child(2) .family-card-image img { object-position: center top; }

    /* Intro */
    .family-intro { padding: 4rem 0; text-align: center; }
    .family-intro p { font-size: 1.1rem; max-width: 700px; margin: 0 auto; color: var(--raw-umber); }

    /* Family Grid */
    .family-grid-section { padding: 0 0 6rem; }
    .container { max-width: var(--max-width); margin: 0 auto; padding: 0 1.5rem; }
    .family-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }
    .family-card { background: var(--white); border-radius: 16px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.06); transition: transform 0.3s ease, box-shadow 0.3s ease; }
    .family-card:hover { transform: translateY(-6px); box-shadow: 0 12px 40px rgba(0,0,0,0.12); }
    .family-card-image { height: 280px; overflow: hidden; }
    .family-card-image img { width: 100%; height: 100%; object-fit: cover; object-position: center 20%; transition: transform 0.5s ease; }
    .family-card:hover .family-card-image img { transform: scale(1.05); }
    .family-card-body { padding: 1.5rem; }
    .family-card-body h3 { font-family: var(--font-headline); font-size: 1.3rem; color: var(--deep-forest); margin-bottom: 0.25rem; }
    .family-card-body .role { font-family: var(--font-accent); font-style: italic; font-size: 1rem; color: var(--terra-cotta); margin-bottom: 0.75rem; display: block; }
    .family-card-body p { font-size: 0.9rem; color: var(--raw-umber); line-height: 1.5; margin-bottom: 1rem; }
    .family-card-link { display: inline-flex; align-items: center; gap: 6px; font-weight: 700; font-size: 0.85rem; color: var(--terra-cotta); text-transform: uppercase; letter-spacing: 0.5px; transition: gap 0.2s; }
    .family-card:hover .family-card-link { gap: 10px; }

    /* Dog card spans full width */
    .family-card.dog { grid-column: span 1; }

    @media (max-width: 768px) {
      .family-grid { grid-template-columns: 1fr; }
      .family-card.dog { grid-column: span 1; }
    }

    /* CTA */
    .family-cta { padding: 4rem 0; text-align: center; background: var(--white); }
    .family-cta h2 { font-family: var(--font-headline); font-size: clamp(2rem, 3.5vw, 2.75rem); color: var(--deep-forest); margin-bottom: 1rem; }
    .family-cta p { color: var(--raw-umber); margin-bottom: 1.5rem; }
    .btn-primary { display: inline-flex; align-items: center; gap: 8px; padding: 1rem 2.5rem; background: linear-gradient(135deg, var(--sage-mist) 0%, #7A8F6A 100%); color: #fff; font-weight: 700; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.06em; border-radius: 8px; transition: all 0.3s ease; box-shadow: 0 4px 16px rgba(122,143,106,0.3); }
    .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(122,143,106,0.4); }

    /* Footer */
    .site-footer {
      background: var(--forest-deep);
      color: rgba(245, 240, 232, 0.7);
      padding: 72px 0 32px;
    }

    .footer-inner {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 40px;
    }

    .footer-top {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: 48px;
      padding-bottom: 48px;
      border-bottom: 1px solid rgba(255,255,255,0.08);
    }

        .footer-brand-logo {
      height: 70px;
      width: auto;
      margin-bottom: 16px;
      display: block;
    }

    .footer-brand-desc {
      font-size: 0.875rem;
      line-height: 1.6;
      margin-bottom: 20px;
    }

    .footer-socials { display: flex; gap: 12px; }

    .footer-socials a {
      width: 36px;
      height: 36px;
      border: 1px solid rgba(255,255,255,0.15);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: var(--transition);
    }

    .footer-socials a:hover { background: rgba(255,255,255,0.1); border-color: var(--lavender); }

    .footer-socials a svg { width: 16px; height: 16px; stroke: var(--cream); stroke-width: 1.5; fill: none; }

    .footer-col h4 {
      font-family: var(--font-body);
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--cream);
      margin-bottom: 20px;
    }

    .footer-col ul { display: flex; flex-direction: column; gap: 12px; }

    .footer-col ul li a {
      font-size: 0.875rem;
      color: rgba(245, 240, 232, 0.6);
      transition: var(--transition);
    }

    .footer-col ul li a:hover { color: var(--lavender); }

    .footer-bottom {
      padding-top: 28px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 16px;
    }

    .footer-disclaimer {
      font-size: 0.6875rem;
      color: rgba(245, 240, 232, 0.35);
      max-width: 600px;
      line-height: 1.5;
    }

    .footer-copyright {
      font-size: 0.75rem;
      color: rgba(245, 240, 232, 0.4);
    }
  </style>


