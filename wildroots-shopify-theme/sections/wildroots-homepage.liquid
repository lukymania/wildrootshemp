 <source src="https://raw.githubusercontent.com/lukymania/wildrootshemp/main/wildroots-site/assets/videos/hero-video.mp4" type="video/mp4">
 </video>
 <script>
 (function() {
 var video = document.getElementById('heroVideo');
 if (!video) return;
 var forward = true;
 var lastTime = 0;
 var isSeeking = false;
 var PAD = 0.04;

 function playForward() {
   forward = true;
   isSeeking = false;
   lastTime = 0;
   video.play().catch(function(){});
 }

 function seekLoop(timestamp) {
   if (forward) return;
   if (!lastTime) lastTime = timestamp;
   var elapsed = (timestamp - lastTime) / 1000;
   lastTime = timestamp;

   var duration = video.duration;
   if (!duration || isNaN(duration)) { requestAnimationFrame(seekLoop); return; }

   video.currentTime = Math.max(video.currentTime - elapsed, PAD);
   if (video.currentTime <= PAD) {
     playForward();
   } else {
     requestAnimationFrame(seekLoop);
   }
 }

 function monitor() {
   if (!forward) { requestAnimationFrame(monitor); return; }
   var duration = video.duration;
   if (!duration || isNaN(duration)) { requestAnimationFrame(monitor); return; }

   if (video.currentTime >= duration - PAD) {
     forward = false;
     isSeeking = true;
     lastTime = 0;
     video.pause();
     requestAnimationFrame(seekLoop);
   } else {
     requestAnimationFrame(monitor);
   }
 }

 video.play().then(function(){ requestAnimationFrame(monitor); }).catch(function(){ requestAnimationFrame(monitor); });
 })();
 </script>
