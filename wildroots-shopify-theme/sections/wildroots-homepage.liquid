<style>
 /* Prevent Shopify's theme shell from adding a second header offset on the homepage. */
 #MainContent,
 #MainContent > .shopify-section:first-child {
 margin-top: 0 !important;
 padding-top: 0 !important;
 }
 /* ============================================
 WILD ROOTS HEMP, COMPLETE STYLESHEET
 ============================================ */
 
 /* CSS Custom Properties */
 :root {
 --deep-forest: #2D4A3E;
 --sage-mist: #9CAF88;
 --raw-umber: #6B4226;
 --terra-cotta: #C17A5F;
 --cream: #F5F0E8;
 --dark-brown: #3D2B1F;
 --light-sage: #C5D4B8;
 --kraft-brown: #C4A882;
 
 --font-headline: 'Playfair Display', serif;
 --font-display: 'Playfair Display', serif;
 --font-body: 'Lato', sans-serif;
 --font-accent: 'Cormorant Garamond', serif;
 
 --max-width: 1200px;
 --header-height: 80px;
 --transition: all 0.3s ease;
 --shadow-sm: 0 2px 8px rgba(45, 74, 62, 0.08);
 --shadow-md: 0 8px 24px rgba(45, 74, 62, 0.12);
 --shadow-lg: 0 16px 48px rgba(45, 74, 62, 0.16);
      --forest-deep: #0f241c;
    }
 
 /* Reset & Base */
 *, *::before, *::after {
 margin: 0;
 padding: 0;
 box-sizing: border-box;
 }
 
 html {
 scroll-behavior: smooth;
 font-size: 16px;
 }
 
 body {
 font-family: var(--font-body);
 font-weight: 400;
 color: var(--dark-brown);
 background-color: var(--cream);
 line-height: 1.6;
 -webkit-font-smoothing: antialiased;
 -moz-osx-font-smoothing: grayscale;
 overflow-x: hidden;
 }
 
 h1, h2, h3, h4 {
 font-family: var(--font-headline);
 font-weight: 700;
 line-height: 1.2;
 color: var(--forest-deep);
 }
 
 h1 { font-size: clamp(2.5rem, 5vw, 4rem); }
 h2 { font-size: clamp(2rem, 4vw, 3rem); }
 h3 { font-size: clamp(1.25rem, 2.5vw, 1.75rem); }
 h4 { font-size: 1.25rem; }
 
 p {
 margin-bottom: 1rem;
 font-size: 1rem;
 line-height: 1.7;
 }
 
 a {
 color: var(--terra-cotta);
 text-decoration: none;
 transition: var(--transition);
 }
 
 a:hover {
 color: var(--raw-umber);
 }
 
 img {
 max-width: 100%;
 height: auto;
 display: block;
 }
 
 .container {
 max-width: var(--max-width);
 margin: 0 auto;
 padding: 0 1.5rem;
 }
 
 .section-padding {
 padding: 5rem 0;
 }
 
 /* Scroll Reveal Animation */
 .reveal {
  opacity: 1;
 transform: translateY(30px);
 transition: opacity 0.8s ease, transform 0.8s ease;
 }
 
 .reveal.active {
 opacity: 1;
 transform: translateY(0);
 }
 
 .reveal-delay-1 { transition-delay: 0.1s; }
 .reveal-delay-2 { transition-delay: 0.2s; }
 .reveal-delay-3 { transition-delay: 0.3s; }
 .reveal-delay-4 { transition-delay: 0.4s; }
 .reveal-delay-5 { transition-delay: 0.5s; }
 
 /* Buttons */
 .btn {
 display: inline-block;
 padding: 1rem 2.5rem;
 font-family: var(--font-body);
 font-weight: 700;
 font-size: 0.95rem;
 text-transform: uppercase;
 letter-spacing: 1.5px;
 border: none;
 cursor: pointer;
 transition: var(--transition);
 text-align: center;
 }
 
 .btn-primary {
 background-color: var(--terra-cotta);
 color: #fff;
 border-radius: 4px;
 }
 
 .btn-primary:hover {
 background-color: var(--raw-umber);
 color: #fff;
 transform: translateY(-2px);
 box-shadow: var(--shadow-md);
 }
 
 .btn-secondary {
 background-color: transparent;
 color: var(--forest-deep);
 border: 2px solid var(--forest-deep);
 border-radius: 4px;
 }
 
 .btn-secondary:hover {
 background-color: var(--forest-deep);
 color: var(--cream);
 transform: translateY(-2px);
 }
 
 .btn-ghost {
 background-color: transparent;
 color: var(--terra-cotta);
 border: 2px solid var(--terra-cotta);
 border-radius: 4px;
 }
 
 .btn-ghost:hover {
 background-color: var(--terra-cotta);
 color: #fff;
 transform: translateY(-2px);
 }
 
 /* Section Label */
 .section-label {
 font-family: var(--font-accent);
 font-style: italic;
 font-size: 1.15rem;
 color: var(--terra-cotta);
 margin-bottom: 0.75rem;
 display: block;
 }
 
 /* ============================================
 HEADER
 ============================================ */
 .site-header {
 position: fixed;
 top: 0;
 left: 0;
 right: 0;
 height: var(--header-height);
 background-color: var(--cream);
 z-index: 1000;
 border-bottom: 1px solid rgba(45, 74, 62, 0.12);
 transition: var(--transition);
 }
 
 .header-inner {
 max-width: var(--max-width);
 margin: 0 auto;
 padding: 0 1.5rem;
 height: 100%;
 display: flex;
 align-items: center;
 justify-content: space-between;
 }
 
 .logo {
 display: flex;
 align-items: center;
 gap: 0.75rem;
 text-decoration: none;
 }
 
 .logo-img {
 height: 68px;
 width: auto;
 display: block;
}
 
 .nav-desktop {
 display: none;
 }
 
 .nav-list {
 display: flex;
 list-style: none;
 gap: 2.5rem;
 }
 
 .nav-list a {
 font-family: var(--font-body);
 font-weight: 400;
 font-size: 0.9rem;
 color: var(--dark-brown);
 text-transform: uppercase;
 letter-spacing: 1px;
 position: relative;
 padding-bottom: 4px;
 }
 
 .nav-list a::after {
 content: '';
 position: absolute;
 bottom: 0;
 left: 0;
 width: 0;
 height: 2px;
 background-color: var(--terra-cotta);
 transition: width 0.3s ease;
 }
 
 .nav-list a:hover::after {
 width: 100%;
 }
 
 .nav-list a:hover {
 color: var(--terra-cotta);
 }
 
 .header-actions {
 display: flex;
 align-items: center;
 gap: 1.5rem;
 }
 
 .cart-btn {
 position: relative;
 background: none;
 border: none;
 cursor: pointer;
 padding: 0.5rem;
 }
 
 .cart-btn svg {
 width: 24px;
 height: 24px;
 stroke: var(--forest-deep);
 transition: stroke 0.3s ease;
 }
 
 .cart-btn:hover svg {
 stroke: var(--terra-cotta);
 }
 
 .cart-count {
 position: absolute;
 top: -2px;
 right: -6px;
 background-color: var(--terra-cotta);
 color: #fff;
 font-size: 0.65rem;
 font-weight: 700;
 width: 18px;
 height: 18px;
 border-radius: 50%;
 display: flex;
 align-items: center;
 justify-content: center;
 }
 
 /* Mobile Menu Toggle */
 .menu-toggle {
 display: flex;
 flex-direction: column;
 justify-content: space-between;
 width: 28px;
 height: 20px;
 background: none;
 border: none;
 cursor: pointer;
 padding: 0;
  z-index: 1001;
  touch-action: manipulation;
  -webkit-tap-highlight-color: transparent;
 }
 
 .menu-toggle span {
 display: block;
 width: 100%;
 height: 2px;
 background-color: var(--forest-deep);
 transition: var(--transition);
 transform-origin: center;
 }
 
 .menu-toggle.active span:nth-child(1) {
 transform: translateY(9px) rotate(45deg);
 }
 
 .menu-toggle.active span:nth-child(2) {
 opacity: 0;
 }
 
 .menu-toggle.active span:nth-child(3) {
 transform: translateY(-9px) rotate(-45deg);
 }
 
 /* Mobile Navigation */
 .mobile-nav {
 position: fixed;
 top: var(--header-height);
 left: 0;
 right: 0;
 bottom: 0;
 background-color: var(--cream);
 z-index: 999;
 padding: 2rem;
 transform: translate3d(100%, 0, 0);
 transition: transform 0.4s ease;
 overflow-y: auto;
 }
 
 .mobile-nav.active {
 transform: translate3d(0, 0, 0);
 }
 
 .mobile-nav-list {
 list-style: none;
 display: flex;
 flex-direction: column;
 gap: 1.5rem;
 }
 
 .mobile-nav-list a {
 font-family: var(--font-headline);
 font-weight: 700;
 font-size: 1.5rem;
 color: var(--forest-deep);
 display: block;
 padding: 0.5rem 0;
 border-bottom: 1px solid var(--light-sage);
 }
 
 .mobile-nav-list a:hover {
 color: var(--terra-cotta);
 }
 
 /* ============================================
 HERO SECTION
 ============================================ */
 .hero {
 position: relative;
 width: 100%;
 height: 100vh;
 min-height: 600px;
 display: flex;
 align-items: flex-end;
 overflow: hidden;
 margin-top: 0;
 }
 
 .hero-video-bg {
 position: absolute;
 top: 0;
 left: 0;
 width: 100%;
 height: 100%;
 object-fit: cover;
 z-index: 1;
 }
 
 .hero-poster {
 position: absolute;
 top: 0;
 left: 0;
 width: 100%;
 height: 100%;
 object-fit: cover;
 z-index: 2;
 }
 
 .hero-video-bg ~ .hero-poster {
 display: none;
 }
 
 .hero-overlay {
 position: absolute;
 top: 0;
 left: 0;
 right: 0;
 bottom: 0;
 background: linear-gradient(to top, rgba(45, 74, 62, 0.88) 0%, rgba(45, 74, 62, 0.4) 50%, rgba(45, 74, 62, 0.15) 100%);
 z-index: 3;
 }
 
 .hero-content {
 position: relative;
 z-index: 4;
 width: 100%;
 max-width: var(--max-width);
 margin: 0 auto;
 padding: 0 1.5rem 4rem;
 }
 
 .hero-headline {
 font-family: var(--font-headline);
 font-weight: 900;
 font-size: clamp(2.25rem, 5.5vw, 4.5rem);
 color: #fff;
 margin-bottom: 1rem;
 max-width: 700px;
 text-shadow: 0 2px 20px rgba(0,0,0,0.2);
 }
 
 .hero-subhead {
 font-family: var(--font-body);
 font-weight: 300;
 font-size: clamp(1rem, 2vw, 1.35rem);
 color: rgba(255, 255, 255, 0.9);
 max-width: 550px;
 margin-bottom: 2rem;
 line-height: 1.6;
 }
 
 .hero-cta {
 margin-bottom: 2.5rem;
 }
 
 /* Trust Badges */
 .trust-badges {
 display: flex;
 flex-wrap: wrap;
 gap: 1.5rem;
 align-items: center;
 }
 
 .trust-badge {
 display: flex;
 align-items: center;
 gap: 0.5rem;
 color: rgba(255, 255, 255, 0.85);
 font-size: 0.8rem;
 font-weight: 400;
 text-transform: uppercase;
 letter-spacing: 1px;
 }
 
 .trust-badge svg {
 width: 20px;
 height: 20px;
 stroke: var(--sage-mist);
 fill: none;
 stroke-width: 2;
 }
 
 /* ============================================
 FAMILY STORY TEASER
 ============================================ */
 .story-section {
 background-color: var(--cream);
 padding: 5rem 0;
 }
 
 .story-inner {
 display: flex;
 flex-direction: column;
 align-items: center;
 gap: 2.5rem;
 }
 
 .story-image {
 max-width: 320px;
 width: 100%;
 }
 
 .story-image img {
 border-radius: 12px;
 box-shadow: var(--shadow-md);
 }
 
 .story-content {
 text-align: center;
 max-width: 600px;
 }
 
 .story-content h2 {
 margin-bottom: 1.25rem;
 }
 
 .story-content p {
 font-size: 1.05rem;
 line-height: 1.8;
 color: var(--dark-brown);
 margin-bottom: 1.5rem;
 }
 
 .story-link {
 font-family: var(--font-body);
 font-weight: 700;
 color: var(--terra-cotta);
 text-transform: uppercase;
 letter-spacing: 1.5px;
 font-size: 0.85rem;
 display: inline-flex;
 align-items: center;
 gap: 0.5rem;
 }
 
 .story-link:hover {
 gap: 0.75rem;
 }
 
 /* ============================================
 THE SCIENCE SECTION
 ============================================ */
 .science-section {
 background: linear-gradient(135deg, var(--forest-deep) 0%, #1e362d 100%);
 padding: 5rem 0;
 position: relative;
 overflow: hidden;
 }
 

 
 .science-header {
 text-align: center;
 margin-bottom: 3rem;
 position: relative;
 z-index: 2;
 }
 
 .science-header h2 {
 color: #fff;
 margin-bottom: 1rem;
 }
 
 .science-header p {
 color: rgba(255, 255, 255, 0.75);
 max-width: 600px;
 margin: 0 auto;
 font-size: 1.05rem;
 }
 
 .science-comparison {
 display: grid;
 grid-template-columns: 1fr;
 gap: 2rem;
 margin-bottom: 3rem;
 position: relative;
 z-index: 2;
 }
 
 .science-card {
 background-color: rgba(45, 74, 62, 0.85);
 border: 1px solid rgba(156, 175, 136, 0.25);
 border-radius: 12px;
 padding: 2rem;
 text-align: center;
 transition: var(--transition);
 }

 .science-card:hover {
 background-color: rgba(45, 74, 62, 0.95);
 border-color: rgba(156, 175, 136, 0.4);
 transform: translateY(-4px);
 }

 .science-card.highlight {
 background-color: rgba(45, 74, 62, 0.9);
 border-color: var(--terra-cotta);
 box-shadow: 0 0 30px rgba(193, 122, 95, 0.15);
 }
 
 .science-card-icon {
 width: 64px;
 height: 64px;
 margin: 0 auto 1rem;
 background-color: rgba(156, 175, 136, 0.2);
 border-radius: 50%;
 display: flex;
 align-items: center;
 justify-content: center;
 }
 
 .science-card-icon svg {
 width: 32px;
 height: 32px;
 stroke: var(--sage-mist);
 fill: none;
 stroke-width: 1.5;
 }
 
 .science-card h3 {
 color: #fff;
 font-size: 1.35rem;
 margin-bottom: 0.75rem;
 }
 
 .science-card p {
 color: rgba(255, 255, 255, 0.7);
 font-size: 0.95rem;
 line-height: 1.7;
 }
 
 .science-arrow {
 display: none;
 align-items: center;
 justify-content: center;
 }
 
 .science-arrow svg {
 width: 32px;
 height: 32px;
 stroke: var(--terra-cotta);
 fill: none;
 stroke-width: 2;
 }
 
 /* Science Stats */
 .science-stats {
 display: grid;
 grid-template-columns: 1fr;
 gap: 1.5rem;
 margin-bottom: 2.5rem;
 position: relative;
 z-index: 2;
 }
 
 .stat-card {
 background-color: rgba(45, 74, 62, 0.8);
 border: 1px solid rgba(156, 175, 136, 0.2);
 border-radius: 10px;
 padding: 1.5rem;
 text-align: center;
 }
 
 .stat-number {
 font-family: var(--font-headline);
 font-weight: 900;
 font-size: 2.5rem;
 color: var(--sage-mist);
 display: block;
 margin-bottom: 0.25rem;
 }
 
 .stat-label {
 color: rgba(255, 255, 255, 0.7);
 font-size: 0.9rem;
 text-transform: uppercase;
 letter-spacing: 1px;
 }
 
 .science-cta {
 text-align: center;
 position: relative;
 z-index: 2;
 }
 
 /* ============================================
 PRODUCT SHOWCASE
 ============================================ */
 .products-section {
 scroll-margin-top: var(--header-height);
 background-color: var(--cream);
 padding: 5rem 0;
 }
 
 .products-header {
 text-align: center;
 margin-bottom: 3rem;
 }
 
 .products-header h2 {
 margin-bottom: 0.75rem;
 }
 
 .products-header p {
 color: rgba(61, 43, 31, 0.7);
 font-size: 1.05rem;
 max-width: 500px;
 margin: 0 auto;
 }
 
 .products-grid {
 display: grid;
 grid-template-columns: 1fr;
 gap: 2rem;
 }
 
 .product-card {
 background-color: #fff;
 border-radius: 12px;
 overflow: hidden;
 box-shadow: var(--shadow-sm);
 transition: var(--transition);
 border: 1px solid rgba(196, 168, 130, 0.2);
 display: flex;
 flex-direction: column;
 height: 100%;
 position: relative;
 }
 
 .product-card:hover {
 transform: translateY(-8px);
 box-shadow: var(--shadow-lg);
 }
 
 .product-image {
 position: relative;
 width: 100%;
 aspect-ratio: 4 / 3;
 overflow: hidden;
 background-color: var(--light-sage);
 }
 
 .product-image img {
 width: 100%;
 height: 100%;
 object-fit: cover;
 transition: transform 0.5s ease;
 }
 
 .product-card:hover .product-image img {
 transform: scale(1.05);
 }
 
 .product-badge {
 position: absolute;
 top: 1rem;
 left: 1rem;
 color: #fff;
 font-size: 0.75rem;
 font-weight: 700;
 text-transform: uppercase;
 letter-spacing: 1px;
 padding: 0.35rem 0.75rem;
 border-radius: 20px;
 z-index: 2;
 }
 .product-badge.badge-rollon { background-color: #C17A5F; }
 .product-badge.badge-spray { background-color: #9CAF88; }
 .product-badge.badge-strength { background-color: #2D4A3E; }
 .product-badge.badge-evening { background-color: #7B6BA8; }
 .product-badge.badge-daily { background-color: #C8913A; }
 .product-badge.badge-pet { background-color: #A67C52; }
 
 .product-info {
 padding: 1.5rem;
 display: flex;
 flex-direction: column;
 flex-grow: 1;
 }
 
 .product-name {
 font-family: var(--font-headline);
 font-weight: 700;
 font-size: 1.25rem;
 color: var(--forest-deep);
 margin-bottom: 0.5rem;
 }
 
 .product-description {
 font-size: 0.9rem;
 color: rgba(61, 43, 31, 0.75);
 line-height: 1.6;
 margin-bottom: 0.75rem;
 }
 
 .product-meta {
 display: flex;
 justify-content: space-between;
 align-items: center;
 margin-bottom: 1rem;
 }
 
 .product-strength {
 font-family: var(--font-accent);
 font-style: italic;
 font-size: 1rem;
 color: var(--sage-mist);
 }
 
 .product-price {
 font-family: var(--font-headline);
 font-weight: 900;
 font-size: 1.5rem;
 color: var(--raw-umber);
 }
 
 .product-btn {
 width: 100%;
 padding: 0.85rem;
 font-size: 0.8rem;
 margin-top: auto;
 }
 
 /* ============================================
 TRUST & CERTIFICATIONS
 ============================================ */
 .trust-section {
 background-color: #fff;
 padding: 5rem 0;
 border-top: 1px solid rgba(196, 168, 130, 0.2);
 border-bottom: 1px solid rgba(196, 168, 130, 0.2);
 }
 
 .trust-header {
 text-align: center;
 margin-bottom: 3rem;
 }
 
 .trust-header h2 {
 margin-bottom: 0.75rem;
 }
 
 .trust-grid {
 display: grid;
 grid-template-columns: repeat(2, 1fr);
 gap: 1.5rem;
 margin-bottom: 3rem;
 }
 
 .trust-item {
 text-align: center;
 padding: 1.5rem 1rem;
 background-color: var(--cream);
 border-radius: 10px;
 transition: var(--transition);
 }
 
 .trust-item:hover {
 transform: translateY(-4px);
 box-shadow: var(--shadow-sm);
 }
 
 .trust-icon {
 width: 56px;
 height: 56px;
 margin: 0 auto 1rem;
 background-color: var(--light-sage);
 border-radius: 50%;
 display: flex;
 align-items: center;
 justify-content: center;
 }
 
 .trust-icon svg {
 width: 28px;
 height: 28px;
 stroke: var(--forest-deep);
 fill: none;
 stroke-width: 1.5;
 }
 
 .trust-item h4 {
 font-size: 1rem;
 color: var(--forest-deep);
 margin-bottom: 0.5rem;
 }
 
 .trust-item p {
 font-size: 0.8rem;
 color: rgba(61, 43, 31, 0.65);
 line-height: 1.5;
 margin-bottom: 0;
 }
 
 .trust-extra {
 display: grid;
 grid-template-columns: 1fr;
 gap: 1.5rem;
 }
 
 .trust-extra-item {
 display: flex;
 align-items: center;
 gap: 1rem;
 padding: 1.25rem;
 background-color: var(--cream);
 border-radius: 10px;
 border-left: 4px solid var(--terra-cotta);
 }
 
 .trust-extra-icon {
 flex-shrink: 0;
 width: 44px;
 height: 44px;
 background-color: var(--light-sage);
 border-radius: 50%;
 display: flex;
 align-items: center;
 justify-content: center;
 }
 
 .trust-extra-icon svg {
 width: 22px;
 height: 22px;
 stroke: var(--forest-deep);
 fill: none;
 stroke-width: 1.5;
 }
 
 .trust-extra-text h4 {
 font-size: 1rem;
 margin-bottom: 0.25rem;
 }
 
 .trust-extra-text p {
 font-size: 0.85rem;
 color: rgba(61, 43, 31, 0.65);
 margin-bottom: 0;
 }
 
 /* ============================================
 TESTIMONIALS
 ============================================ */
 .testimonials-section {
 background: linear-gradient(180deg, var(--cream) 0%, #ede8df 100%);
 padding: 5rem 0;
 }
 
 .testimonials-header {
 text-align: center;
 margin-bottom: 3rem;
 }
 
 .testimonials-grid {
 display: grid;
 grid-template-columns: 1fr;
 gap: 2rem;
 }
 
 .testimonial-card {
 background-color: #fff;
 border-radius: 12px;
 padding: 2rem;
 box-shadow: var(--shadow-sm);
 border: 1px solid rgba(196, 168, 130, 0.15);
 transition: var(--transition);
