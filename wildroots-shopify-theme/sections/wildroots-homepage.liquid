 }
 
 .journal-content {
 padding: 1.5rem;
 }
 
 .journal-date {
 font-size: 0.8rem;
 color: var(--terra-cotta);
 text-transform: uppercase;
 letter-spacing: 1px;
 margin-bottom: 0.5rem;
 display: block;
 }
 
