{% if section.settings.show_announcement %}
  <div class="announcement-bar" style="background: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
    <div class="announcement-bar-inner">
      {% if section.settings.link != blank %}
        <a href="{{ section.settings.link }}" class="announcement-text">{{ section.settings.text }}</a>
      {% else %}
        <span class="announcement-text">{{ section.settings.text }}</span>
      {% endif %}
      <button class="announcement-close" onclick="this.parentElement.parentElement.remove()" aria-label="Close announcement">&times;</button>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Free shipping on orders over $75"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#2D4A3E"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#F5F0E8"
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar"
    }
  ]
}
{% endschema %}