{% comment %}
  Family Story Section
  - Family photo and brief story
  - Link to Our Story page
{% endcomment %}

{%- style -%}
.family-story {
  background-color: var(--cream, #F5F0E8);
  padding: 5rem 0;
}

.family-story__inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2.5rem;
}

.family-story__image {
  max-width: 320px;
  width: 100%;
  flex-shrink: 0;
}

.family-story__image img {
  border-radius: 12px;
  box-shadow: 0 8px 24px rgba(45, 74, 62, 0.12);
  width: 100%;
  height: auto;
}

.family-story__content {
  text-align: center;
  max-width: 600px;
}

.family-story__content h2 {
  margin-bottom: 1.25rem;
  color: var(--forest-deep, #0f241c);
}

.family-story__content p {
  font-size: 1.05rem;
  line-height: 1.8;
  color: var(--dark-brown, #3D2B1F);
  margin-bottom: 1.5rem;
}

.family-story__link {
  font-family: var(--font-body);
  font-weight: 700;
  color: var(--terra-cotta, #C17A5F);
  text-transform: uppercase;
  letter-spacing: 1.5px;
  font-size: 0.85rem;
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  text-decoration: none;
  transition: gap 0.3s ease;
}

.family-story__link:hover {
  gap: 0.75rem;
  color: var(--raw-umber, #6B4226);
}

.family-story__link::after {
  content: '→';
  display: inline-block;
}

@media (min-width: 768px) {
  .family-story__inner {
    flex-direction: row;
    text-align: left;
    gap: 4rem;
  }

  .family-story__content {
    text-align: left;
  }

  .family-story__image {
    max-width: 380px;
  }
}

@media (min-width: 1024px) {
  .family-story {
    padding: 6rem 0;
  }
}
{%- endstyle -%}

<section class="family-story" id="story" aria-labelledby="family-story-heading" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="family-story__inner reveal">
      <div class="family-story__image">
        {%- if section.settings.family_image != blank -%}
          {{ section.settings.family_image | image_url: width: 600 | image_tag:
            loading: 'lazy',
            alt: section.settings.family_image_alt | default: 'The Wild Roots Hemp founder family'
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
        {%- endif -%}
      </div>

      <div class="family-story__content">
        <span class="section-label">{{ section.settings.label | default: 'Our Story' }}</span>
        <h2 id="family-story-heading">{{ section.settings.heading | default: 'From Our Family to Yours' }}</h2>
        <p>{{ section.settings.story_text | default: "We're Nick and Lucy, a husband-and-wife team who started our story in the Midwest, surrounded by cornfields and honest values. After our family grew to three kids (plus one very good dog), we felt the pull of the coast and headed west. We planted our wild roots where the Pacific meets the sand. When we couldn't find hemp wellness products we trusted for our own family, we built Wild Roots Hemp, using cutting-edge nano-technology from a powerful West Coast biotech company, and the same values we teach our children: honesty, quality, and respect for nature." }}</p>
        <a href="{{ section.settings.link_url | default: '/pages/our-story' }}" class="family-story__link">
          {{ section.settings.link_text | default: 'Read Our Full Story' }}
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Family Story",
  "tag": "section",
  "class": "family-story-section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section label",
      "default": "Our Story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From Our Family to Yours"
    },
    {
      "type": "textarea",
      "id": "story_text",
      "label": "Story text",
      "default": "We're Nick and Lucy, a husband-and-wife team who started our story in the Midwest, surrounded by cornfields and honest values. After our family grew to three kids (plus one very good dog), we felt the pull of the coast and headed west. We planted our wild roots where the Pacific meets the sand. When we couldn't find hemp wellness products we trusted for our own family, we built Wild Roots Hemp, using cutting-edge nano-technology from a powerful West Coast biotech company, and the same values we teach our children: honesty, quality, and respect for nature."
    },
    {
      "type": "image_picker",
      "id": "family_image",
      "label": "Family image",
      "info": "Recommended: family photo or illustration"
    },
    {
      "type": "text",
      "id": "family_image_alt",
      "label": "Family image alt text",
      "default": "The Wild Roots Hemp founder family illustration - husband, wife, three kids, and their dog"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link text",
      "default": "Read Our Full Story"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL",
      "default": "/pages/our-story"
    }
  ],
  "presets": [
    {
      "name": "Family Story",
      "category": "Content"
    }
  ]
}
{% endschema %}
