{%- comment -%}
Single authoritative Product JSON-LD and BreadcrumbList for every Shopify product page.
Core product fields use live Shopify data so price, availability, SKU and canonical URL do not drift.
Aggregate ratings mirror the visible rating summaries on the six current product templates;
keep these values aligned with genuine customer review totals whenever the on-page totals change.
{%- endcomment -%}
{%- if request.page_type == 'product' and product != blank -%}
  {%- assign wr_variant = product.selected_or_first_available_variant -%}
  {%- assign wr_barcode = wr_variant.barcode | default: '' | strip -%}
  {%- assign wr_barcode_length = wr_barcode | size -%}
  {%- assign wr_rating_value = '' -%}
  {%- assign wr_review_count = '' -%}
  {%- case product.handle -%}
    {%- when 'daily-roots' -%}
      {%- assign wr_rating_value = 4.9 -%}
      {%- assign wr_review_count = 127 -%}
    {%- when 'deep-roots' -%}
      {%- assign wr_rating_value = 4.9 -%}
      {%- assign wr_review_count = 156 -%}
    {%- when 'deep-rest' -%}
      {%- assign wr_rating_value = 4.9 -%}
      {%- assign wr_review_count = 98 -%}
    {%- when 'root-relief' -%}
      {%- assign wr_rating_value = 4.9 -%}
      {%- assign wr_review_count = 89 -%}
    {%- when 'wild-relief' -%}
      {%- assign wr_rating_value = 4.8 -%}
      {%- assign wr_review_count = 112 -%}
    {%- when 'paw-root' -%}
      {%- assign wr_rating_value = 4.8 -%}
      {%- assign wr_review_count = 73 -%}
  {%- endcase -%}
  {%- capture wr_product_schema_id -%}{{ canonical_url }}#product{%- endcapture -%}
  {%- capture wr_offer_schema_id -%}{{ canonical_url }}#offer-{{ wr_variant.id }}{%- endcapture -%}
  {%- capture wr_breadcrumb_schema_id -%}{{ canonical_url }}#breadcrumb{%- endcapture -%}
  {%- assign wr_store_url = canonical_url | split: '/products/' | first -%}
  {%- capture wr_home_url -%}{{ wr_store_url }}/{%- endcapture -%}
  {%- capture wr_shop_url -%}{{ wr_store_url }}/collections/shop{%- endcapture -%}

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "@id": {{ wr_product_schema_id | json }},
    "name": {{ product.title | json }},
    "url": {{ canonical_url | json }},
    "description": {{ product.description | strip_html | strip_newlines | json }},
    {%- if product.featured_image %}
    "image": {{ product.featured_image | img_url: '1024x1024' | prepend: 'https:' | json }},
    {%- endif %}
    {%- if wr_variant.sku != blank %}
    "sku": {{ wr_variant.sku | json }},
    {%- endif %}
    {%- if wr_barcode != blank and wr_barcode_length == 8 %}
    "gtin8": {{ wr_barcode | json }},
    {%- elsif wr_barcode != blank and wr_barcode_length == 12 %}
    "gtin12": {{ wr_barcode | json }},
    {%- elsif wr_barcode != blank and wr_barcode_length == 13 %}
    "gtin13": {{ wr_barcode | json }},
    {%- elsif wr_barcode != blank and wr_barcode_length == 14 %}
    "gtin14": {{ wr_barcode | json }},
    {%- endif %}
    "brand": {
      "@type": "Brand",
      "name": {{ shop.name | json }}
    },
    {%- if wr_rating_value != blank and wr_review_count != blank %}
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": {{ wr_rating_value | json }},
      "reviewCount": {{ wr_review_count | json }},
      "bestRating": 5,
      "worstRating": 1
    },
    {%- endif %}
    "offers": {
      "@type": "Offer",
      "@id": {{ wr_offer_schema_id | json }},
      "url": {{ canonical_url | json }},
      "priceCurrency": {{ shop.currency | json }},
      "price": {{ wr_variant.price | divided_by: 100.0 | json }},
      "availability": "https://schema.org/{% if wr_variant.available %}InStock{% else %}OutOfStock{% endif %}",
      "itemCondition": "https://schema.org/NewCondition"
    }
  }
  </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": {{ wr_breadcrumb_schema_id | json }},
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": {{ wr_home_url | json }}
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Shop",
        "item": {{ wr_shop_url | json }}
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": {{ product.title | json }},
        "item": {{ canonical_url | json }}
      }
    ]
  }
  </script>
{%- endif -%}
