{%- comment -%}
Server-side product schema source repair. The rendered product content is passed
explicitly from layout/theme.liquid because Shopify's render tag uses an isolated scope.
{%- endcomment -%}
{%- capture wr_clean_product_content -%}{{ page_content }}{%- endcapture -%}
{%- assign wr_clean_product_content = wr_clean_product_content
  | replace: 'href="faq-/pages/contact">FAQ</a>', 'href="/pages/faq">FAQ</a>'
  | replace: 'href="faq-/pages/contact">Contact Us</a>', 'href="/pages/contact">Contact Us</a>'
  | replace: 'href="faq-/pages/contact">Shipping Info</a>', 'href="/pages/faq">Shipping Info</a>'
  | replace: 'href="/policies/shipping-policy">Shipping Info</a>', 'href="/pages/faq">Shipping Info</a>'
  | replace: 'href="faq-/pages/contact">Privacy Policy</a>', 'href="/policies/privacy-policy">Privacy Policy</a>'
  | replace: 'href="faq-/pages/contact"', 'href="/pages/contact"'
  | replace: ' itemscope itemtype="https://schema.org/Product"', ''
  | replace: ' itemscope itemtype="http://schema.org/Product"', ''
  | replace: ' itemtype="https://schema.org/Product" itemscope', ''
  | replace: ' itemtype="http://schema.org/Product" itemscope', ''
  | replace: ' itemscope itemtype="https://schema.org/AggregateRating"', ''
  | replace: ' itemscope itemtype="http://schema.org/AggregateRating"', ''
  | replace: ' itemtype="https://schema.org/AggregateRating" itemscope', ''
  | replace: ' itemtype="http://schema.org/AggregateRating" itemscope', ''
  | replace: ' itemprop="aggregateRating"', ''
  | replace: ' itemprop="ratingValue"', ''
  | replace: ' itemprop="reviewCount"', ''
  | replace: ' itemprop="ratingCount"', ''
  | replace: ' itemprop="description"', ''
-%}
{{- wr_clean_product_content -}}
