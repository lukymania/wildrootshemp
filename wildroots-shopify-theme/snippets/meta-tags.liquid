  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:title" content="{{ page_title | escape }}">
  <meta property="og:type" content="{{ request.page_type }}">
  <meta property="og:description" content="{{ page_description | escape }}">

  {%- if page_image -%}
    <meta property="og:image" content="http:{{ page_image | image_url }}">
    <meta property="og:image:secure_url" content="https:{{ page_image | image_url }}">
    <meta property="og:image:width" content="{{ page_image.width }}">
    <meta property="og:image:height" content="{{ page_image.height }}">
  {%- endif -%}

  {%- if request.page_type == 'product' -%}
    <meta property="og:price:amount" content="{{ product.selected_or_first_available_variant.price | money_without_currency | strip_html }}">
    <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
  {%- endif -%}

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ page_title | escape }}">
  <meta name="twitter:description" content="{{ page_description | escape }}">

  {%- if page_image -%}
    <meta name="twitter:image" content="https:{{ page_image | image_url }}">
  {%- endif -%}

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "{{ shop.url }}/#organization",
        "name": "{{ shop.name }}",
        "alternateName": "Wild Roots",
        "url": "{{ shop.url }}",
        "logo": {
          "@type": "ImageObject",
          "url": "{{ settings.logo | image_url }}"
        },
        "description": "{{ shop.description | escape }}",
        "founder": [{"@type": "Person", "name": "Nick and Lucy"}],
        "knowsAbout": ["Nano-Hemp Wellness", "Nano Fragmentation Technology", "Botanical Wellness", "Hemp Products", "Family Wellness"],
        "areaServed": {"@type": "Country", "name": "United States"},
        "brand": {"@id": "{{ shop.url }}/#organization"},
        "contactPoint": {
          "@type": "ContactPoint",
          "contactType": "Customer Service",
          "email": "{{ shop.email }}",
          "availableLanguage": "English"
        }
      },
      {
        "@type": "WebSite",
        "@id": "{{ shop.url }}/#website",
        "url": "{{ shop.url }}",
        "name": "{{ shop.name }}",
        "publisher": {"@id": "{{ shop.url }}/#organization"},
        "potentialAction": {
          "@type": "SearchAction",
          "target": {"@type": "EntryPoint", "urlTemplate": "{{ shop.url }}/search?q={search_term_string}"},
          "query-input": "required name=search_term_string"
        }
      }
    ]
  }
  </script>

  {%- if request.page_type == 'product' -%}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "name": {{ product.title | json }},
      "image": {{ product.images | json }},
      "description": {{ product.description | strip_html | truncate: 200 | json }},
      "sku": {{ product.selected_or_first_available_variant.sku | json }},
      "brand": {"@type": "Brand", "name": "{{ shop.name }}"},
      "offers": {
        "@type": "Offer",
        "url": "{{ canonical_url }}",
        "priceCurrency": "{{ cart.currency.iso_code }}",
        "price": "{{ product.selected_or_first_available_variant.price | money_without_currency }}",
        "availability": "https://schema.org/{% if product.selected_or_first_available_variant.available %}InStock{% else %}OutOfStock{% endif %}",
        "itemCondition": "https://schema.org/NewCondition",
        "seller": {"@type": "Organization", "name": "{{ shop.name }}"}
      }
    }
    </script>
  {%- endif -%}

  {%- if request.page_type == 'article' -%}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": {{ article.title | json }},
      "description": {{ article.excerpt_or_content | strip_html | truncate: 200 | json }},
      "image": "https:{{ article.image | image_url }}",
      "author": {"@type": "Organization", "name": "{{ shop.name }} Editorial Team"},
      "publisher": {"@id": "{{ shop.url }}/#organization"},
      "datePublished": "{{ article.published_at | date: '%Y-%m-%d' }}",
      "dateModified": "{{ article.updated_at | date: '%Y-%m-%d' }}",
      "mainEntityOfPage": {"@type": "WebPage", "@id": "{{ canonical_url }}"},
      "speakable": {"@type": "SpeakableSpecification", "cssSelector": [".article-content", ".article-title"]}
    }
    </script>
  {%- endif -%}

  {%- if request.page_type == 'page' and page.handle == 'faq' -%}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is nano-hemp and how is it different?",
          "acceptedAnswer": {"@type": "Answer", "text": "Nano-hemp is hemp that has been processed using proprietary nano fragmentation technology to create particles smaller than 100 nanometers. These tiny particles absorb 3-8x better than traditional hemp, meaning faster onset and more efficient delivery."}
        },
        {
          "@type": "Question",
          "name": "Will nano-hemp products show up on a drug test?",
          "acceptedAnswer": {"@type": "Answer", "text": "All {{ shop.name }} products contain zero THC. Our products are made with pure nano-hemp isolate and contain no THC whatsoever, making them safe for those concerned about drug testing."}
        },
        {
          "@type": "Question",
          "name": "How do I choose the right strength for me?",
          "acceptedAnswer": {"@type": "Answer", "text": "We recommend starting with Daily Roots Standard Strength (300MG, 10MG per serving) for everyday wellness. For those seeking deeper support, Deep Roots Extra Strength (600MG, 20MG per serving) offers our maximum formula."}
        },
        {
          "@type": "Question",
          "name": "How do you ship and what is your return policy?",
          "acceptedAnswer": {"@type": "Answer", "text": "Orders ship within 1-2 business days. We stand behind our products with a 30-day satisfaction guarantee. If you are not happy, we will make it right."}
        },
        {
          "@type": "Question",
          "name": "Are your products safe for pets?",
          "acceptedAnswer": {"@type": "Answer", "text": "Yes! Our Paw & Root Pet Drops are specifically formulated for pets with the same high-quality nano-hemp and pet-safe ingredients. Always follow the dosing instructions based on your pet's weight."}
        }
      ]
    }
    </script>
  {%- endif -%}
